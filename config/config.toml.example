# OpenRouter (https://openrouter.ai). The key is read from OPENROUTER_API_KEY; the
# footer balance also uses the OPENROUTER_MANAGEMENT_KEY Keychain entry, which is
# deliberately not exported into Kimi's environment. Limits and reasoning efforts
# of OpenRouter aliases are refreshed from OpenRouter's public model list at start;
# pin your own values under [models."<alias>".overrides].

[providers.openrouter]
type = "openai"
base_url = "https://openrouter.ai/api/v1"
api_key_env = "OPENROUTER_API_KEY"

[models."openrouter/muse-wonder"]
provider = "openrouter"
model = "meta/muse-wonder"
max_context_size = 1048576
max_output_size = 943718
capabilities = [ "thinking", "always_thinking", "image_in" ]
support_efforts = [ "minimal", "low", "medium", "high", "xhigh", "max" ]
default_effort = "high"

[models."openrouter/qwen3.8-27b"]
provider = "openrouter"
model = "qwen/qwen3.8-27b"
max_context_size = 65536
max_output_size = 32768
capabilities = [ "thinking" ]
support_efforts = [ "low", "medium", "xhigh" ]
default_effort = "xhigh"
off_effort = "none"

# The startup refresh writes Qwen's model-wide limits and picks "medium";
# these keep Cerebras's limits and OpenRouter's default effort.
[models."openrouter/qwen3.8-27b".overrides]
max_context_size = 65536
max_output_size = 32768
default_effort = "xhigh"

# Sent with every request: run only on Cerebras, never fall back (feature 11).
[models."openrouter/qwen3.8-27b".extra_body.provider]
only = [ "cerebras/fp16" ]
allow_fallbacks = false

# Kimi K3.1 Pro (Moonshot's 1M-context reasoning model) through OpenRouter.
# Added 2026-10-24 from OpenRouter's model list: context 1,048,576, output
# 943,718, reasoning efforts low/high/max (default max, "none" turns it off),
# $2 / $10 per million tokens, cache reads $0.20. Image input supported.
[models."openrouter/kimi-k3.1-pro"]
provider = "openrouter"
model = "moonshotai/kimi-k3.1-pro"
display_name = "Kimi K3.1 Pro (OpenRouter)"
max_context_size = 1048576
max_output_size = 943718
capabilities = [ "thinking", "image_in" ]
support_efforts = [ "low", "high", "max" ]
default_effort = "max"
off_effort = "none"
