default_model = "closerouter/openai-gpt-6-astra"
default_permission_mode = "auto"

[providers.closerouter]
type = "openai"
base_url = "https://api.closerouter.dev/v1"
api_key_env = "CLOSEROUTER_API_KEY"

[providers.closerouter-anthropic]
type = "anthropic"
base_url = "https://api.closerouter.dev"
api_key_env = "CLOSEROUTER_API_KEY"

# CloseRouter limits and reasoning efforts are refreshed from CloseRouter
# (GET /v1/models and /v1/models/{author}/{model}/endpoints) when Kimi starts
# and every 6 hours while `kimi web` runs, for every alias whose endpoint is
# CloseRouter; the values here are just the starting point. The refresh
# rewrites max_context_size, max_output_size, support_efforts,
# default_effort, off_effort and the thinking capabilities with what the
# endpoint each alias is called through supports. To keep a value of your own
# (such as a lower output cap), put it under [models."<alias>".overrides]:
# overrides win and are never rewritten. Set model_source = "static" on a
# provider to stop refreshing its models.

[models."closerouter/openai-gpt-6-astra"]
provider = "closerouter"
model = "openai/gpt-6-astra"
max_context_size = 786432
max_output_size = 128000
capabilities = ["thinking", "always_thinking"]
support_efforts = ["low", "medium", "high", "xhigh", "max"]
default_effort = "high"

[models."closerouter/openai-gpt-6-astra".overrides]
max_output_size = 32000

[models."closerouter/openai-gpt-6.1-sol"]
provider = "closerouter"
model = "openai/gpt-6.1-sol"
max_context_size = 786432
max_output_size = 128000
capabilities = [ "thinking" ]
support_efforts = [ "low", "medium", "high", "xhigh", "max" ]
default_effort = "high"
off_effort = "none"

[models."closerouter/deepseek-v4-pro-0813"]
provider = "closerouter"
model = "deepseek/deepseek-v4-pro-0813"
max_context_size = 1000000
max_output_size = 65536
capabilities = ["thinking", "always_thinking"]
support_efforts = ["low", "high", "max"]
default_effort = "high"

[models."closerouter/glm-5.3"]
provider = "closerouter"
model = "z-ai/glm-5.3"
max_context_size = 1000000
max_output_size = 65536
capabilities = [ "thinking", "always_thinking" ]
support_efforts = [ "low", "high", "xhigh", "max" ]
default_effort = "high"

[models."closerouter/glm-5.3-flash"]
provider = "closerouter"
model = "z-ai/glm-5.3-flash"
max_context_size = 1000000
max_output_size = 65536
capabilities = [ "thinking", "always_thinking" ]
support_efforts = [ "low", "high", "xhigh", "max" ]
default_effort = "high"

[models."closerouter/gemini-4-argon"]
provider = "closerouter"
model = "google/gemini-4-argon"
max_context_size = 128000
max_output_size = 16384
capabilities = [ "thinking", "always_thinking", "image_in" ]
support_efforts = [ "minimal", "low", "medium", "high" ]
default_effort = "high"

[models."closerouter/grok-4.7"]
provider = "closerouter"
model = "x-ai/grok-4.7"
max_context_size = 256000
max_output_size = 32768
capabilities = [ "thinking", "always_thinking", "image_in" ]
support_efforts = [ "low", "medium", "high", "xhigh" ]
default_effort = "high"

[models."closerouter-anthropic/claude-fable-5.1"]
provider = "closerouter-anthropic"
model = "anthropic/claude-fable-5.1"
max_context_size = 1000000
max_output_size = 32000
capabilities = [ "thinking" ]
support_efforts = [ "low", "medium", "high", "xhigh", "max" ]
default_effort = "high"

[models."closerouter-anthropic/claude-fable-5"]
provider = "closerouter-anthropic"
model = "anthropic/claude-fable-5"
max_context_size = 1000000
max_output_size = 32000
capabilities = [ "thinking" ]
support_efforts = [ "low", "medium", "high", "xhigh", "max" ]
default_effort = "high"

[models."closerouter-anthropic/claude-opus-4.8"]
provider = "closerouter-anthropic"
model = "anthropic/claude-opus-4.8"
max_context_size = 200000
max_output_size = 32000
capabilities = ["thinking"]
support_efforts = ["low", "medium", "high", "xhigh", "max", "ultra"]
default_effort = "high"

[models."closerouter-anthropic/claude-opus-4.6"]
provider = "closerouter-anthropic"
model = "anthropic/claude-opus-4.6"
max_context_size = 200000
max_output_size = 32000
capabilities = ["thinking"]
support_efforts = ["low", "medium", "high", "xhigh", "max", "ultra"]
default_effort = "high"

[models."closerouter-anthropic/claude-opus-4.6".overrides]
max_output_size = 31000

[permission]
dangerous_command_guard = false

[thinking]
enabled = false
effort = "high"

# CustomKIMI automatically reads the documented CloseRouter credits endpoint:
# https://api.closerouter.dev/v1/credits
# Set CLOSEROUTER_BALANCE_URL only for a compatible proxy endpoint.
# Do not put API keys in this file; use CLOSEROUTER_API_KEY in the environment.
# Optional cost rates are USD per million tokens:
# CLOSEROUTER_INPUT_USD_PER_MILLION
# CLOSEROUTER_OUTPUT_USD_PER_MILLION
# CLOSEROUTER_CACHE_READ_USD_PER_MILLION
# CLOSEROUTER_CACHE_WRITE_USD_PER_MILLION


