diff --git a/apps/kimi-code/src/utils/billing/billing-monitor.ts b/apps/kimi-code/src/utils/billing/billing-monitor.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d9206ca1103a9b61ca68986da3c6ddef24558ac8
--- /dev/null
+++ b/apps/kimi-code/src/utils/billing/billing-monitor.ts
@@ -0,0 +1,145 @@
+import type { ModelAlias, ProviderConfig, SessionUsage, TokenUsage } from '@moonshot-ai/kimi-code-sdk';
+
+import { costOfUsage, type BillingProvider, type TokenPrices } from './billing-provider';
+
+export interface ProviderBalance {
+  readonly label: string;
+  readonly usd: number;
+}
+
+export interface ModelEndpoint {
+  readonly baseUrl: string | undefined;
+  readonly model: string;
+}
+
+export type ModelResolver = (modelKey: string) => ModelEndpoint;
+
+/**
+ * Resolves a session-usage key to the endpoint and upstream model id it is billed by.
+ * The engine keys usage by model alias; `<baseUrl>#<model>` keys are understood too.
+ */
+export function modelResolver(
+  models: Readonly<Record<string, Pick<ModelAlias, 'provider' | 'model' | 'baseUrl'>>>,
+  providers: Readonly<Record<string, Pick<ProviderConfig, 'baseUrl'>>>,
+): ModelResolver {
+  return (modelKey) => {
+    const alias = models[modelKey];
+    if (alias !== undefined) {
+      return { baseUrl: alias.baseUrl ?? providers[alias.provider]?.baseUrl, model: alias.model };
+    }
+    const separator = modelKey.lastIndexOf('#');
+    return separator < 0
+      ? { baseUrl: undefined, model: modelKey }
+      : { baseUrl: modelKey.slice(0, separator), model: modelKey.slice(separator + 1) };
+  };
+}
+
+/** What the footer reads from billing. */
+export interface BillingSource {
+  start(): void;
+  stop(): void;
+  balanceFor(baseUrl: string | undefined): ProviderBalance | undefined;
+  sessionCostUsd(usage: SessionUsage | undefined, resolve: ModelResolver): number | undefined;
+}
+
+export interface BillingMonitorOptions {
+  readonly onUpdate?: () => void;
+  readonly balanceIntervalMs?: number;
+  readonly pricesIntervalMs?: number;
+}
+
+/** Polls the balance and price list of every configured provider and prices session usage. */
+export class BillingMonitor implements BillingSource {
+  private readonly balances = new Map<BillingProvider, number>();
+  private readonly prices = new Map<BillingProvider, ReadonlyMap<string, TokenPrices>>();
+  private timers: ReturnType<typeof setInterval>[] = [];
+  private stopped = false;
+
+  constructor(
+    private readonly providers: readonly BillingProvider[],
+    private readonly options: BillingMonitorOptions = {},
+  ) {}
+
+  start(): void {
+    this.stop();
+    if (this.configuredProviders().length === 0) return;
+    this.stopped = false;
+    void this.refresh();
+    this.timers = [
+      setInterval(() => void this.refreshBalances(), this.options.balanceIntervalMs ?? 60_000),
+      setInterval(() => void this.refreshPrices(), this.options.pricesIntervalMs ?? 10 * 60_000),
+    ];
+    for (const timer of this.timers) timer.unref?.();
+  }
+
+  stop(): void {
+    this.stopped = true;
+    for (const timer of this.timers) clearInterval(timer);
+    this.timers = [];
+  }
+
+  async refresh(): Promise<void> {
+    await Promise.all([this.refreshBalances(), this.refreshPrices()]);
+  }
+
+  balanceFor(baseUrl: string | undefined): ProviderBalance | undefined {
+    const provider = this.providerFor(baseUrl);
+    const usd = provider === undefined ? undefined : this.balances.get(provider);
+    return provider === undefined || usd === undefined ? undefined : { label: provider.label, usd };
+  }
+
+  /**
+   * Reported costs plus per-model prices for the rest. Undefined as soon as one model
+   * cannot be priced, so the footer never shows a partial or guessed total.
+   */
+  sessionCostUsd(usage: SessionUsage | undefined, resolve: ModelResolver): number | undefined {
+    const byModel = usage?.byModel;
+    if (byModel === undefined || Object.keys(byModel).length === 0) return usage?.total?.cost;
+    let total = 0;
+    for (const [modelKey, tokens] of Object.entries(byModel)) {
+      const cost = tokens.cost ?? this.priceTokens(resolve(modelKey), tokens);
+      if (cost === undefined) return undefined;
+      total += cost;
+    }
+    return total;
+  }
+
+  private async refreshBalances(): Promise<void> {
+    const results = await Promise.all(
+      this.configuredProviders().map(async (provider) => [provider, await provider.fetchBalanceUsd()] as const),
+    );
+    if (this.stopped) return;
+    for (const [provider, usd] of results) {
+      if (usd === undefined) this.balances.delete(provider);
+      else this.balances.set(provider, usd);
+    }
+    this.options.onUpdate?.();
+  }
+
+  private async refreshPrices(): Promise<void> {
+    const results = await Promise.all(
+      this.configuredProviders().map(async (provider) => [provider, await provider.fetchPrices()] as const),
+    );
+    if (this.stopped) return;
+    for (const [provider, prices] of results) {
+      // A failed refresh returns no prices; keep the last list instead of hiding costs.
+      if (prices.size > 0) this.prices.set(provider, prices);
+    }
+    this.options.onUpdate?.();
+  }
+
+  private priceTokens(endpoint: ModelEndpoint, tokens: TokenUsage): number | undefined {
+    const provider = this.providerFor(endpoint.baseUrl);
+    if (provider === undefined) return undefined;
+    const prices = this.prices.get(provider)?.get(endpoint.model) ?? provider.fallbackPrices();
+    return prices === undefined ? undefined : costOfUsage(tokens, prices);
+  }
+
+  private providerFor(baseUrl: string | undefined): BillingProvider | undefined {
+    return this.providers.find((provider) => provider.bills(baseUrl));
+  }
+
+  private configuredProviders(): BillingProvider[] {
+    return this.providers.filter((provider) => provider.configured);
+  }
+}
diff --git a/apps/kimi-code/src/utils/billing/billing-provider.ts b/apps/kimi-code/src/utils/billing/billing-provider.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1b3f7eca5577b98f1a4f3fbd3a6e39bc4fa7f73b
--- /dev/null
+++ b/apps/kimi-code/src/utils/billing/billing-provider.ts
@@ -0,0 +1,110 @@
+import type { TokenUsage } from '@moonshot-ai/kimi-code-sdk';
+
+export type BillingEnv = Readonly<Record<string, string | undefined>>;
+
+export type Fetcher = (input: string | URL | Request, init?: RequestInit) => Promise<Response>;
+
+/** Prices in USD per million tokens. */
+export interface TokenPrices {
+  readonly input: number;
+  readonly output: number;
+  readonly cacheRead: number;
+  readonly cacheWrite: number;
+}
+
+type BillableTokens = Pick<TokenUsage, 'inputOther' | 'output' | 'inputCacheRead' | 'inputCacheCreation'>;
+
+const REQUEST_TIMEOUT_MS = 5_000;
+
+export function costOfUsage(usage: BillableTokens, prices: TokenPrices): number {
+  return (
+    (usage.inputOther * prices.input +
+      usage.output * prices.output +
+      usage.inputCacheRead * prices.cacheRead +
+      usage.inputCacheCreation * prices.cacheWrite) /
+    1_000_000
+  );
+}
+
+/** A finite number from a JSON number or numeric string. */
+export function toFiniteNumber(value: unknown): number | undefined {
+  if (typeof value === 'number') return Number.isFinite(value) ? value : undefined;
+  if (typeof value !== 'string' || value.trim() === '') return undefined;
+  const parsed = Number(value);
+  return Number.isFinite(parsed) ? parsed : undefined;
+}
+
+export function asRecord(value: unknown): Record<string, unknown> | undefined {
+  return typeof value === 'object' && value !== null && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : undefined;
+}
+
+/**
+ * An API provider whose account balance and request costs the footer can show.
+ * Subclasses only describe their endpoints; keys, requests and failures are handled here.
+ */
+export abstract class BillingProvider {
+  /** Name shown in the footer, as in "7api balance $9.18". */
+  abstract readonly label: string;
+  /** API host; models whose base URL points at it are billed by this provider. */
+  protected abstract readonly host: string;
+  /** Environment variable that holds the API key. */
+  protected abstract readonly apiKeyEnv: string;
+
+  constructor(
+    protected readonly env: BillingEnv = process.env,
+    private readonly fetcher: Fetcher = globalThis.fetch,
+  ) {}
+
+  get configured(): boolean {
+    return this.apiKey !== undefined;
+  }
+
+  bills(baseUrl: string | undefined): boolean {
+    if (baseUrl === undefined) return false;
+    try {
+      return new URL(baseUrl).host === this.host;
+    } catch {
+      return false;
+    }
+  }
+
+  /** Current balance in USD, or undefined when it cannot be read. */
+  abstract fetchBalanceUsd(): Promise<number | undefined>;
+
+  /** Published per-model prices. Providers that report each request's cost need none. */
+  async fetchPrices(): Promise<ReadonlyMap<string, TokenPrices>> {
+    return new Map();
+  }
+
+  /** Prices for models missing from fetchPrices(), such as user-configured rates. */
+  fallbackPrices(): TokenPrices | undefined {
+    return undefined;
+  }
+
+  protected get apiKey(): string | undefined {
+    return this.envValue(this.apiKeyEnv);
+  }
+
+  /** A trimmed environment variable; empty counts as unset. */
+  protected envValue(name: string): string | undefined {
+    const value = this.env[name]?.trim();
+    return value === undefined || value === '' ? undefined : value;
+  }
+
+  /** GETs a JSON document with the API key; resolves undefined on any failure. */
+  protected async getJson(url: string): Promise<unknown> {
+    const key = this.apiKey;
+    if (key === undefined) return undefined;
+    try {
+      const response = await this.fetcher(url, {
+        headers: { Authorization: `Bearer ${key}` },
+        signal: AbortSignal.timeout(REQUEST_TIMEOUT_MS),
+      });
+      return response.ok ? await response.json() : undefined;
+    } catch {
+      return undefined;
+    }
+  }
+}
diff --git a/apps/kimi-code/src/utils/billing/closedrouter.ts b/apps/kimi-code/src/utils/billing/closedrouter.ts
new file mode 100644
index 0000000000000000000000000000000000000000..44ff0b8898bbb0cb1f13f868da738f55f6763911
--- /dev/null
+++ b/apps/kimi-code/src/utils/billing/closedrouter.ts
@@ -0,0 +1,43 @@
+import { asRecord, BillingProvider, toFiniteNumber, type TokenPrices } from './billing-provider';
+
+const DEFAULT_BALANCE_URL = 'https://api.closerouter.dev/v1/credits';
+const BALANCE_KEYS = ['total_credits', 'balance', 'remaining', 'remaining_usd', 'credits'];
+
+/** ClosedRouter reports each request's cost in `usage.cost`, so it needs no price list. */
+export class ClosedRouterBilling extends BillingProvider {
+  readonly label = 'ClosedRouter';
+  protected readonly host = 'api.closerouter.dev';
+  protected readonly apiKeyEnv = 'CLOSEROUTER_API_KEY';
+
+  async fetchBalanceUsd(): Promise<number | undefined> {
+    const url = this.envValue('CLOSEROUTER_BALANCE_URL') ?? DEFAULT_BALANCE_URL;
+    return findBalance(await this.getJson(url));
+  }
+
+  /** The optional CLOSEROUTER_*_USD_PER_MILLION rates, used only when all four are set. */
+  override fallbackPrices(): TokenPrices | undefined {
+    const input = rate(this.env['CLOSEROUTER_INPUT_USD_PER_MILLION']);
+    const output = rate(this.env['CLOSEROUTER_OUTPUT_USD_PER_MILLION']);
+    const cacheRead = rate(this.env['CLOSEROUTER_CACHE_READ_USD_PER_MILLION']);
+    const cacheWrite = rate(this.env['CLOSEROUTER_CACHE_WRITE_USD_PER_MILLION']);
+    if (input === undefined || output === undefined || cacheRead === undefined || cacheWrite === undefined) {
+      return undefined;
+    }
+    return { input, output, cacheRead, cacheWrite };
+  }
+}
+
+function rate(value: string | undefined): number | undefined {
+  const parsed = toFiniteNumber(value);
+  return parsed !== undefined && parsed >= 0 ? parsed : undefined;
+}
+
+function findBalance(value: unknown): number | undefined {
+  const record = asRecord(value);
+  if (record === undefined) return toFiniteNumber(value);
+  for (const key of BALANCE_KEYS) {
+    const balance = toFiniteNumber(record[key]);
+    if (balance !== undefined) return balance;
+  }
+  return findBalance(record['data']);
+}
