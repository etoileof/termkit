+import type { BillingEnv, BillingProvider, Fetcher } from './billing-provider';
+import { ClosedRouterBilling } from './closedrouter';
+import { SevenApiBilling } from './sevenapi';
+
+/** Every provider whose balance and costs the footer can show. Register new providers here. */
+export function createBillingProviders(env?: BillingEnv, fetcher?: Fetcher): BillingProvider[] {
+  return [new ClosedRouterBilling(env, fetcher), new SevenApiBilling(env, fetcher)];
+}
