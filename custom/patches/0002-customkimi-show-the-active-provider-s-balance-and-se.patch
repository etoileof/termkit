+import { describe, expect, it } from 'vitest';
+
+import { costOfUsage } from '#/utils/billing/billing-provider';
+import { ClosedRouterBilling } from '#/utils/billing/closedrouter';
+import { createBillingProviders } from '#/utils/billing/providers';
+import { SevenApiBilling } from '#/utils/billing/sevenapi';
+
+interface Call {
+  url: string;
+  authorization: string | null;
+}
+
+function fakeFetch(body: unknown, status = 200) {
+  const calls: Call[] = [];
+  const fetcher = async (input: string | URL | Request, init?: RequestInit): Promise<Response> => {
+    const url = typeof input === 'string' ? input : input instanceof URL ? input.href : input.url;
+    calls.push({ url, authorization: new Headers(init?.headers).get('authorization') });
+    return new Response(JSON.stringify(body), { status });
+  };
+  return { fetcher, calls };
+}
+
+describe('createBillingProviders', () => {
+  it('registers ClosedRouter and 7api', () => {
+    expect(createBillingProviders({}).map((provider) => provider.label)).toEqual(['ClosedRouter', '7api']);
+  });
+});
+
+describe('costOfUsage', () => {
+  it('prices each kind of token at its own per-million rate', () => {
+    expect(
+      costOfUsage(
+        { inputOther: 1_000_000, output: 2_000_000, inputCacheRead: 3_000_000, inputCacheCreation: 4_000_000 },
+        { input: 1, output: 2, cacheRead: 3, cacheWrite: 4 },
+      ),
+    ).toBe(30);
+  });
+});
+
+describe('ClosedRouterBilling', () => {
+  const env = { CLOSEROUTER_API_KEY: 'secret-token' };
+
+  it('reads the balance from the documented credits endpoint with the API key', async () => {
+    const { fetcher, calls } = fakeFetch({ data: { total_credits: 12.34, total_usage: 5.67 } });
+    await expect(new ClosedRouterBilling(env, fetcher).fetchBalanceUsd()).resolves.toBe(12.34);
+    expect(calls).toEqual([
+      { url: 'https://api.closerouter.dev/v1/credits', authorization: 'Bearer secret-token' },
+    ]);
+  });
+
+  it('supports a custom balance URL and nested compatibility responses', async () => {
+    const { fetcher, calls } = fakeFetch({ data: { balance: '12.34' } });
+    const billing = new ClosedRouterBilling(
+      { ...env, CLOSEROUTER_BALANCE_URL: 'https://example.test/balance' },
+      fetcher,
+    );
+    await expect(billing.fetchBalanceUsd()).resolves.toBe(12.34);
+    expect(calls[0]?.url).toBe('https://example.test/balance');
+  });
+
+  it('reports no balance without a key, on HTTP errors, or when the request fails', async () => {
+    const { fetcher, calls } = fakeFetch({ data: { total_credits: 1 } });
+    await expect(new ClosedRouterBilling({}, fetcher).fetchBalanceUsd()).resolves.toBeUndefined();
+    expect(calls).toHaveLength(0);
+    const serverError = fakeFetch({}, 500).fetcher;
+    await expect(new ClosedRouterBilling(env, serverError).fetchBalanceUsd()).resolves.toBeUndefined();
+    const offline = async (): Promise<Response> => {
+      throw new Error('offline');
+    };
+    await expect(new ClosedRouterBilling(env, offline).fetchBalanceUsd()).resolves.toBeUndefined();
+  });
+
+  it('uses the configured per-million rates as fallback prices only when all four are valid', () => {
+    const rates = {
+      CLOSEROUTER_INPUT_USD_PER_MILLION: '1',
+      CLOSEROUTER_OUTPUT_USD_PER_MILLION: '2',
+      CLOSEROUTER_CACHE_READ_USD_PER_MILLION: '3',
+      CLOSEROUTER_CACHE_WRITE_USD_PER_MILLION: '4',
+    };
+    expect(new ClosedRouterBilling(rates).fallbackPrices()).toEqual({
+      input: 1,
+      output: 2,
+      cacheRead: 3,
+      cacheWrite: 4,
+    });
+    const invalid = { ...rates, CLOSEROUTER_OUTPUT_USD_PER_MILLION: 'abc' };
+    expect(new ClosedRouterBilling(invalid).fallbackPrices()).toBeUndefined();
+    expect(new ClosedRouterBilling({}).fallbackPrices()).toBeUndefined();
+  });
+
+  it('bills only models served from its own API host', () => {
+    const billing = new ClosedRouterBilling(env);
+    expect(billing.bills('https://api.closerouter.dev/v1')).toBe(true);
+    expect(billing.bills('https://api.closerouter.dev')).toBe(true);
+    expect(billing.bills('https://7api.st/v1')).toBe(false);
+    expect(billing.bills('not a url')).toBe(false);
+    expect(billing.bills(undefined)).toBe(false);
+  });
+});
+
+describe('SevenApiBilling', () => {
+  const env = { SEVENAPI_API_KEY: 'sk-test' };
+
+  it('reads the USD balance from /v1/balance with the API key', async () => {
+    const { fetcher, calls } = fakeFetch({ object: 'balance', currency: 'USD', balance_usd: 9.2632 });
+    await expect(new SevenApiBilling(env, fetcher).fetchBalanceUsd()).resolves.toBe(9.2632);
+    expect(calls).toEqual([{ url: 'https://7api.st/v1/balance', authorization: 'Bearer sk-test' }]);
+  });
+
+  it('turns the published model pricing into token prices', async () => {
+    const { fetcher, calls } = fakeFetch({
+      data: [
+        { id: 'gpt-6-astra', pricing: { price_usd_per_mtok: 0.45, cache_read_usd_per_mtok: 0.04 } },
+        { id: 'unpriced-model' },
+      ],
+    });
+    const prices = await new SevenApiBilling(env, fetcher).fetchPrices();
+    expect(calls[0]?.url).toBe('https://7api.st/v1/models');
+    expect([...prices]).toEqual([
+      ['gpt-6-astra', { input: 0.45, output: 0.45, cacheWrite: 0.45, cacheRead: 0.04 }],
+    ]);
+  });
+
