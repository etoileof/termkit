+import { afterEach, describe, expect, it, vi } from 'vitest';
+import type { TokenUsage } from '@moonshot-ai/kimi-code-sdk';
+
+import { BillingMonitor, modelResolver } from '#/utils/billing/billing-monitor';
+import { BillingProvider, type TokenPrices } from '#/utils/billing/billing-provider';
+
+class FakeProvider extends BillingProvider {
+  readonly label: string;
+  protected readonly host: string;
+  protected readonly apiKeyEnv = 'FAKE_API_KEY';
+  balanceRequests = 0;
+
+  constructor(
+    label: string,
+    host: string,
+    private readonly balance: number | undefined,
+    private readonly prices: Record<string, TokenPrices> = {},
+    configured = true,
+  ) {
+    super(configured ? { FAKE_API_KEY: 'key' } : {});
+    this.label = label;
+    this.host = host;
+  }
+
+  async fetchBalanceUsd(): Promise<number | undefined> {
+    this.balanceRequests += 1;
+    return this.balance;
+  }
+
+  override async fetchPrices(): Promise<ReadonlyMap<string, TokenPrices>> {
+    return new Map(Object.entries(this.prices));
+  }
+}
+
+const astraPrices = { input: 0.45, output: 0.45, cacheWrite: 0.45, cacheRead: 0.04 };
+const closedRouter = () => new FakeProvider('ClosedRouter', 'api.closerouter.dev', 18.2);
+const sevenApi = () => new FakeProvider('7api', '7api.st', 9.18, { 'gpt-6-astra': astraPrices });
+const tokens = (usage: Partial<TokenUsage>): TokenUsage => ({
+  inputOther: 0,
+  output: 0,
+  inputCacheRead: 0,
+  inputCacheCreation: 0,
+  ...usage,
+});
+const byUrlKey = modelResolver({}, {});
+
+describe('modelResolver', () => {
+  const resolve = modelResolver(
+    {
+      '7api/gpt-6-astra': { provider: '7api-responses', model: 'gpt-6-astra' },
+      'own/endpoint': { provider: '7api-responses', model: 'm', baseUrl: 'https://own.test/v1' },
+    },
+    { '7api-responses': { baseUrl: 'https://7api.st/v1' } },
+  );
+
+  it("resolves a model alias to its provider's base URL and upstream model id", () => {
+    expect(resolve('7api/gpt-6-astra')).toEqual({ baseUrl: 'https://7api.st/v1', model: 'gpt-6-astra' });
+  });
+
+  it("prefers the alias's own base URL", () => {
+    expect(resolve('own/endpoint')).toEqual({ baseUrl: 'https://own.test/v1', model: 'm' });
+  });
+
+  it('parses `<baseUrl>#<model>` keys and leaves unknown bare keys without an endpoint', () => {
+    expect(resolve('https://7api.st#claude-haiku-5-5')).toEqual({ baseUrl: 'https://7api.st', model: 'claude-haiku-5-5' });
+    expect(resolve('unknown-model')).toEqual({ baseUrl: undefined, model: 'unknown-model' });
+  });
+});
+
+describe('BillingMonitor', () => {
+  afterEach(() => {
+    vi.useRealTimers();
+  });
+
+  it('shows the balance of the provider that bills a model endpoint', async () => {
+    const monitor = new BillingMonitor([closedRouter(), sevenApi()]);
+    await monitor.refresh();
+    expect(monitor.balanceFor('https://7api.st/v1')).toEqual({ label: '7api', usd: 9.18 });
+    expect(monitor.balanceFor('https://api.closerouter.dev/v1')).toEqual({ label: 'ClosedRouter', usd: 18.2 });
+    expect(monitor.balanceFor('https://example.com/v1')).toBeUndefined();
+    expect(monitor.balanceFor(undefined)).toBeUndefined();
+  });
+
+  it('only contacts providers that have an API key', async () => {
+    const unconfigured = new FakeProvider('7api', '7api.st', 9.18, {}, false);
+    const monitor = new BillingMonitor([unconfigured]);
+    await monitor.refresh();
+    expect(unconfigured.balanceRequests).toBe(0);
+    expect(monitor.balanceFor('https://7api.st/v1')).toBeUndefined();
+  });
+
+  it('adds reported costs and prices the remaining models with their own rates', async () => {
+    const monitor = new BillingMonitor([closedRouter(), sevenApi()]);
+    await monitor.refresh();
+    const cost = monitor.sessionCostUsd(
+      {
+        byModel: {
+          'https://api.closerouter.dev/v1#openai/gpt-6-astra': tokens({ inputOther: 1000, cost: 0.01 }),
+          'https://7api.st/v1#gpt-6-astra': tokens({
+            inputOther: 1_000_000,
+            output: 1_000_000,
+            inputCacheRead: 1_000_000,
+          }),
+        },
+      },
+      byUrlKey,
+    );
+    expect(cost).toBeCloseTo(0.01 + 0.45 + 0.45 + 0.04, 10);
+  });
+
+  it('prices usage keyed by model alias, as the engine records it', async () => {
+    const monitor = new BillingMonitor([sevenApi()]);
+    await monitor.refresh();
+    const resolve = modelResolver(
+      { '7api/gpt-6-astra': { provider: '7api-responses', model: 'gpt-6-astra' } },
+      { '7api-responses': { baseUrl: 'https://7api.st/v1' } },
+    );
+    // A real turn: 699 input + 76 output tokens at $0.45/M, 23,040 cached at $0.04/M.
+    const usage = { byModel: { '7api/gpt-6-astra': tokens({ inputOther: 699, output: 76, inputCacheRead: 23_040 }) } };
+    expect(monitor.sessionCostUsd(usage, resolve)).toBeCloseTo(0.00127035, 12);
+  });
+
+  it("uses a provider's fallback prices for models missing from its price list", async () => {
+    class RatedProvider extends FakeProvider {
+      override fallbackPrices(): TokenPrices {
+        return { input: 1, output: 1, cacheRead: 1, cacheWrite: 1 };
+      }
+    }
+    const monitor = new BillingMonitor([new RatedProvider('ClosedRouter', 'api.closerouter.dev', 1)]);
+    await monitor.refresh();
+    const usage = { byModel: { 'https://api.closerouter.dev/v1#openai/x': tokens({ output: 1_000_000 }) } };
+    expect(monitor.sessionCostUsd(usage, byUrlKey)).toBe(1);
+  });
+
+  it('hides the session cost when any model cannot be priced', async () => {
+    const monitor = new BillingMonitor([sevenApi()]);
+    await monitor.refresh();
+    const unknownModel = { byModel: { 'https://7api.st/v1#unknown-model': tokens({ output: 10 }) } };
+    const unknownProvider = { byModel: { 'https://other.example/v1#model': tokens({ output: 10 }) } };
+    const unresolvedAlias = { byModel: { 'some/alias': tokens({ output: 10 }) } };
+    expect(monitor.sessionCostUsd(unknownModel, byUrlKey)).toBeUndefined();
+    expect(monitor.sessionCostUsd(unknownProvider, byUrlKey)).toBeUndefined();
+    expect(monitor.sessionCostUsd(unresolvedAlias, byUrlKey)).toBeUndefined();
+  });
+
+  it('falls back to the reported session total without a per-model breakdown', () => {
+    const monitor = new BillingMonitor([]);
+    expect(monitor.sessionCostUsd({ total: tokens({ cost: 0.5 }) }, byUrlKey)).toBe(0.5);
+    expect(monitor.sessionCostUsd({ total: tokens({ output: 5 }) }, byUrlKey)).toBeUndefined();
+    expect(monitor.sessionCostUsd(undefined, byUrlKey)).toBeUndefined();
+  });
+
+  it('polls every interval after start, notifies on updates, and stops cleanly', async () => {
+    vi.useFakeTimers();
+    const provider = sevenApi();
+    const onUpdate = vi.fn();
+    const monitor = new BillingMonitor([provider], { onUpdate, balanceIntervalMs: 60_000 });
+    monitor.start();
+    await vi.advanceTimersByTimeAsync(0);
+    expect(provider.balanceRequests).toBe(1);
+    expect(onUpdate).toHaveBeenCalled();
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(provider.balanceRequests).toBe(2);
+    monitor.stop();
+    await vi.advanceTimersByTimeAsync(180_000);
+    expect(provider.balanceRequests).toBe(2);
+  });
+
+  it('does not start polling when no provider has an API key', () => {
+    vi.useFakeTimers();
+    const monitor = new BillingMonitor([new FakeProvider('7api', '7api.st', 1, {}, false)]);
+    monitor.start();
+    expect(vi.getTimerCount()).toBe(0);
+    monitor.stop();
+  });
+});
