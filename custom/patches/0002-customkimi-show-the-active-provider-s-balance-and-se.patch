@@ -0,0 +1,30 @@
+import { asRecord, BillingProvider, toFiniteNumber, type TokenPrices } from './billing-provider';
+
+const API_BASE = 'https://7api.st/v1';
+
+/** 7api publishes a price per model; its replies carry token counts but no cost. */
+export class SevenApiBilling extends BillingProvider {
+  readonly label = '7api';
+  protected readonly host = '7api.st';
+  protected readonly apiKeyEnv = 'SEVENAPI_API_KEY';
+
+  async fetchBalanceUsd(): Promise<number | undefined> {
+    return toFiniteNumber(asRecord(await this.getJson(`${API_BASE}/balance`))?.['balance_usd']);
+  }
+
+  override async fetchPrices(): Promise<ReadonlyMap<string, TokenPrices>> {
+    const models = asRecord(await this.getJson(`${API_BASE}/models`))?.['data'];
+    const prices = new Map<string, TokenPrices>();
+    for (const model of Array.isArray(models) ? models : []) {
+      const entry = asRecord(model);
+      const pricing = asRecord(entry?.['pricing']);
+      const perMillion = toFiniteNumber(pricing?.['price_usd_per_mtok']);
+      const cacheRead = toFiniteNumber(pricing?.['cache_read_usd_per_mtok']);
+      const id = entry?.['id'];
+      if (typeof id !== 'string' || perMillion === undefined || cacheRead === undefined) continue;
+      // 7api bills input, output and cache writes at one rate and cache reads at another.
+      prices.set(id, { input: perMillion, output: perMillion, cacheWrite: perMillion, cacheRead });
+    }
+    return prices;
+  }
+}
