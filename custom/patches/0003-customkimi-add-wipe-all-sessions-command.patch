+++ b/apps/kimi-code/src/tui/commands/session.ts
@@ -17,6 +17,43 @@ import type { SlashCommandHost } from './dispatch';
 // Session commands
 // ---------------------------------------------------------------------------
 
+export async function handleWipeAllSessionsCommand(
+  host: SlashCommandHost,
+  args: string,
+): Promise<void> {
+  if (args.trim().toLowerCase() !== 'confirm') {
+    host.showStatus(
+      'This permanently deletes all saved session histories across workspaces. Run /wipe-all-sessions confirm to continue.',
+      'warning',
+    );
+    return;
+  }
+
+  try {
+    await host.waitForSessionAssembly();
+    const sessions = await host.harness.listSessions({ includeArchived: true });
+    const sessionIds = new Set(sessions.map((session) => session.id));
+
+    const currentSessionId = host.state.appState.sessionId;
+    if (currentSessionId.length > 0 && sessionIds.has(currentSessionId)) {
+      await host.closeSessionForWipe();
+    }
+
+    let deleted = 0;
+    for (const sessionId of sessionIds) {
+      await host.harness.deleteSession(sessionId);
+      deleted += 1;
+    }
+
+    if (sessionIds.has(currentSessionId)) {
+      await host.createNewSession();
+    }
+    host.showStatus(`Deleted ${String(deleted)} saved session${deleted === 1 ? '' : 's'}.`);
+  } catch (error) {
+    host.showError(`Failed to wipe saved sessions: ${formatErrorMessage(error)}`);
+  }
+}
