diff --git a/apps/kimi-code/src/tui/commands/session.ts b/apps/kimi-code/src/tui/commands/session.ts
index 67f3600101e903ea2454f99c0fa85b5a19aab668..d36b1e3484006263465482b95255959c818c0f70 100644
