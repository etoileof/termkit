+---
+"@moonshot-ai/kimi-code": patch
+---
+
+Show every running subagent as a row under the conversation; `↓` selects a row, `Enter` opens that agent's conversation live, and finished agents turn green before leaving the list.
diff --git a/apps/kimi-code/src/tui/components/chrome/agent-dock.ts b/apps/kimi-code/src/tui/components/chrome/agent-dock.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9801b9a3519806f0de75d0d1f7b2a13061f616e8
--- /dev/null
+++ b/apps/kimi-code/src/tui/components/chrome/agent-dock.ts
@@ -0,0 +1,364 @@
+/**
+ * AgentDock — the list of agents shown under the conversation.
+ *
+ * One row per subagent of the session, led by a status dot: it pulses while
+ * the agent runs, turns green when the agent completed and red when it
+ * failed; finished rows linger for a few seconds and then drop off. `↓` on an
+ * empty editor focuses the dock, `↑`/`↓` move the selection, `Enter` opens the
+ * selected agent's own conversation and `Esc` returns to the editor.
+ *
+ * The dock keeps its own reference to each agent's activity record: the store
+ * drops foreground-only records once they end, but a finished row must stay
+ * openable until it leaves the dock.
+ */
+
+import {
+  Key,
+  matchesKey,
+  truncateToWidth,
+  type Component,
+  type Focusable,
+} from '@moonshot-ai/pi-tui';
+
+import { SELECT_POINTER, STATUS_BULLET } from '#/tui/constant/symbols';
+import type { SubagentActivityRecord } from '#/tui/controllers/subagent-activity-store';
+import { currentTheme } from '#/tui/theme';
+import { printableChar } from '#/tui/utils/printable-key';
+
+import { extractKeyArgument } from '../messages/tool-call';
+
+export type AgentDockRowStatus = 'running' | 'completed' | 'failed' | 'ended';
+
+export interface AgentDockRow {
+  readonly agentId: string;
+  readonly record: SubagentActivityRecord;
+  readonly startedAt: number;
+  status: AgentDockRowStatus;
+  finishedAt?: number;
+}
+
+export interface AgentDockOptions {
+  /** Enter on a row while the main chat is shown. */
+  readonly onOpen: (row: AgentDockRow) => void;
+  /** The selection moved while an agent's conversation is shown. */
+  readonly onSelect?: (row: AgentDockRow) => void;
+  /** Enter / Esc while an agent's conversation is shown: back to the chat. */
+  readonly onBack?: () => void;
+  /** The keyboard goes back to the editor. */
+  readonly onLeave: () => void;
+  readonly requestRender: () => void;
+  readonly now?: () => number;
+}
+
+/** How long a finished row stays in the dock. */
+export const COMPLETED_LINGER_MS = 8_000;
+export const FAILED_LINGER_MS = 20_000;
+const TICK_MS = 250;
+const ELLIPSIS = '…';
+const DESCRIPTION_MAX_CHARS = 48;
+/** The running dot cycles through these colors, one step per tick. */
+const PULSE_COLORS = ['primary', 'accent', 'textMuted', 'accent'] as const;
+
+function formatElapsed(ms: number): string {
+  const total = Math.max(0, Math.floor(ms / 1000));
+  const minutes = Math.floor(total / 60);
+  const seconds = total % 60;
+  if (minutes === 0) return `${String(seconds)}s`;
+  return `${String(minutes)}m ${String(seconds).padStart(2, '0')}s`;
+}
+
+function toolCallCount(record: SubagentActivityRecord): number {
+  let count = 0;
+  for (const step of record.steps) count += step.toolCalls.length;
+  return count;
+}
+
+/** Name + key argument of the tool call still running, if any. */
+function runningTool(record: SubagentActivityRecord): string | undefined {
+  for (let i = record.steps.length - 1; i >= 0; i--) {
+    const calls = record.steps[i]!.toolCalls;
+    for (let j = calls.length - 1; j >= 0; j--) {
+      const call = calls[j]!;
+      if (call.status !== 'running' || call.name.length === 0) continue;
+      const keyArg = extractKeyArgument(call.name, call.args);
+      return keyArg === null || keyArg.length === 0 ? call.name : `${call.name} ${keyArg}`;
+    }
+  }
+  return undefined;
+}
+
+function rowStatusOf(record: SubagentActivityRecord): AgentDockRowStatus {
+  return record.status;
+}
+
+export class AgentDockComponent implements Component, Focusable {
+  focused = false;
+  /** An agent's conversation is shown in place of the main chat. */
+  viewing = false;
+
+  private readonly rows: AgentDockRow[] = [];
+  private selected = 0;
+  private tick = 0;
+  private timer: ReturnType<typeof setInterval> | undefined;
+  private readonly now: () => number;
+
+  constructor(private readonly options: AgentDockOptions) {
+    this.now = options.now ?? (() => Date.now());
+  }
+
+  // ── rows ───────────────────────────────────────────────────────────
+
+  /** Add the agent's row or refresh its status from the record. */
+  upsert(record: SubagentActivityRecord): void {
+    const status = rowStatusOf(record);
+    let row = this.rows.find((r) => r.agentId === record.agentId);
+    if (row === undefined) {
+      row = { agentId: record.agentId, record, startedAt: this.now(), status };
+      this.rows.push(row);
+    }
+    if (row.status !== status) {
+      row.status = status;
+      row.finishedAt = status === 'running' ? undefined : this.now();
+    }
+    this.ensureTimer();
+    this.options.requestRender();
+  }
+
+  /** The store dropped the record: an agent still shown as running ended
+   *  without a terminal event (aborted turn). */
+  markDropped(agentId: string): void {
+    const row = this.rows.find((r) => r.agentId === agentId);
+    if (row === undefined || row.status !== 'running') return;
+    row.status = 'ended';
+    row.finishedAt = this.now();
+    this.options.requestRender();
+  }
+
+  clear(): void {
+    this.rows.length = 0;
+    this.selected = 0;
+    this.viewing = false;
+    this.stopTimer();
+    if (this.focused) {
+      this.focused = false;
+      this.options.onLeave();
+    }
+    this.options.requestRender();
+  }
+
+  isEmpty(): boolean {
+    return this.rows.length === 0;
+  }
+
+  has(agentId: string): boolean {
+    return this.rows.some((r) => r.agentId === agentId);
+  }
+
+  snapshot(): readonly AgentDockRow[] {
+    return [...this.rows];
+  }
+
+  selectedRow(): AgentDockRow | undefined {
+    return this.rows[this.selected];
+  }
+
+  // ── focus ──────────────────────────────────────────────────────────
+
+  /** Take the selection; false when there is nothing to select. */
+  focus(): boolean {
+    if (this.rows.length === 0) return false;
+    this.focused = true;
+    this.selected = Math.min(this.selected, this.rows.length - 1);
+    this.options.requestRender();
+    return true;
+  }
+
+  blur(): void {
+    this.focused = false;
+    this.viewing = false;
+    this.options.requestRender();
+  }
+
+  /** Current animation step (drives the working indicator of the open conversation). */
+  animationTick(): number {
+    return this.tick;
+  }
+
+  // ── input ──────────────────────────────────────────────────────────
+
+  handleInput(data: string): void {
+    const k = printableChar(data);
+    const isEnter = matchesKey(data, Key.enter) || matchesKey(data, Key.return);
+    const isEscape = matchesKey(data, Key.escape) || k === 'q' || k === 'Q';
+    const isUp = matchesKey(data, Key.up) || k === 'k';
+    const isDown = matchesKey(data, Key.down) || k === 'j';
+
+    if (this.viewing) {
+      if (isEnter || isEscape) {
+        this.options.onBack?.();
+        return;
+      }
+      if ((isUp && this.selected > 0) || (isDown && this.selected < this.rows.length - 1)) {
+        this.selected += isUp ? -1 : 1;
+        const row = this.selectedRow();
+        if (row !== undefined) this.options.onSelect?.(row);
+        this.options.requestRender();
+      }
+      return;
+    }
+
+    if (isEscape) {
+      this.blur();
+      this.options.onLeave();
+      return;
+    }
+    if (isUp) {
+      if (this.selected > 0) {
+        this.selected -= 1;
+        this.options.requestRender();
+      }
+      return;
+    }
+    if (isDown) {
+      if (this.selected < this.rows.length - 1) {
+        this.selected += 1;
+        this.options.requestRender();
+        return;
+      }
+      // Past the last row the arrow lands back in the editor below.
+      this.blur();
+      this.options.onLeave();
+      return;
+    }
+    if (isEnter) {
+      const row = this.selectedRow();
+      if (row !== undefined) this.options.onOpen(row);
+    }
+  }
+
+  // ── timers ─────────────────────────────────────────────────────────
+
+  private ensureTimer(): void {
+    if (this.timer !== undefined) return;
+    this.timer = setInterval(() => {
+      this.tick += 1;
+      this.expire();
+      if (this.rows.length === 0) this.stopTimer();
+      this.options.requestRender();
+    }, TICK_MS);
+    this.timer.unref?.();
+  }
+
+  private stopTimer(): void {
+    if (this.timer === undefined) return;
+    clearInterval(this.timer);
+    this.timer = undefined;
+  }
+
+  /** Drop finished rows past their linger time. The row the user is on while
+   *  the dock is focused stays so it can still be opened. */
+  expire(): void {
+    const now = this.now();
+    for (let i = this.rows.length - 1; i >= 0; i--) {
+      const row = this.rows[i]!;
+      if (row.finishedAt === undefined) continue;
+      if (this.focused && i === this.selected) continue;
+      const linger = row.status === 'failed' ? FAILED_LINGER_MS : COMPLETED_LINGER_MS;
+      if (now - row.finishedAt < linger) continue;
+      this.rows.splice(i, 1);
+      if (this.selected > i || this.selected >= this.rows.length) {
+        this.selected = Math.max(0, Math.min(this.selected, this.rows.length - 1));
+      }
+    }
+    if (this.rows.length === 0 && this.focused) {
+      this.focused = false;
+      this.options.onLeave();
+    }
+  }
+
+  dispose(): void {
+    this.stopTimer();
+  }
+
+  // ── render ─────────────────────────────────────────────────────────
+
+  invalidate(): void {}
+
+  render(width: number): string[] {
+    if (this.rows.length === 0) return [];
+    const out: string[] = [''];
+    this.rows.forEach((row, index) => {
+      out.push(this.renderRow(row, index, width));
+    });
+    out.push(this.renderHint(width));
+    return out;
+  }
+
+  private renderRow(row: AgentDockRow, index: number, width: number): string {
+    const isSelected = this.focused && index === this.selected;
+    const pointer = isSelected ? currentTheme.fg('primary', `${SELECT_POINTER} `) : '  ';
+    const { record } = row;
+    const name = isSelected
+      ? currentTheme.boldFg('primary', record.agentName)
+      : currentTheme.boldFg('text', record.agentName);
+
+    const parts: string[] = [];
+    if (record.description !== undefined && record.description.length > 0) {
+      parts.push(truncateToWidth(record.description, DESCRIPTION_MAX_CHARS, ELLIPSIS));
+    }
+    if (record.model !== undefined && record.model.length > 0) parts.push(record.model);
+    if (record.effort !== undefined && record.effort.length > 0) parts.push(record.effort);
+    const tools = toolCallCount(record);
+    if (tools > 0) parts.push(`${String(tools)} tools`);
+    parts.push(formatElapsed((row.finishedAt ?? this.now()) - row.startedAt));
+
+    let trailing = '';
+    switch (row.status) {
+      case 'running': {
+        const tool = runningTool(record);
+        if (tool !== undefined) trailing = currentTheme.fg('textMuted', ` · ${tool}`);
+        break;
+      }
+      case 'completed':
+        trailing = currentTheme.fg('success', ' · done');
+        break;
+      case 'failed':
+        trailing = currentTheme.fg('error', ' · failed');
+        break;
+      case 'ended':
+        trailing = currentTheme.fg('textMuted', ' · ended');
+        break;
+    }
+
+    const detail = parts.length > 0 ? currentTheme.dim(` · ${parts.join(' · ')}`) : '';
+    const line = `${pointer}${this.renderDot(row)}${name}${detail}${trailing}`;
+    return truncateToWidth(line, width, ELLIPSIS);
+  }
+
+  private renderDot(row: AgentDockRow): string {
+    switch (row.status) {
+      case 'running':
+        return currentTheme.fg(PULSE_COLORS[this.tick % PULSE_COLORS.length]!, STATUS_BULLET);
+      case 'completed':
+        return currentTheme.fg('success', STATUS_BULLET);
+      case 'failed':
+        return currentTheme.fg('error', STATUS_BULLET);
+      case 'ended':
+        return currentTheme.fg('textMuted', STATUS_BULLET);
+    }
+  }
+
+  private renderHint(width: number): string {
+    const key = (text: string): string => currentTheme.boldFg('primary', text);
+    const dim = (text: string): string => currentTheme.fg('textMuted', text);
+    let hint: string;
+    if (this.viewing) {
+      hint = `  ${key('↑↓')} ${dim('other agent')}  ${key('Enter')}${dim('/')}${key('Esc')} ${dim('back to chat')}`;
+    } else if (this.focused) {
+      hint = `  ${key('↑↓')} ${dim('select')}  ${key('Enter')} ${dim('open agent')}  ${key('Esc')} ${dim('back')}`;
+    } else {
+      hint = `  ${key('↓')} ${dim('agents')}`;
+    }
+    return truncateToWidth(hint, width, ELLIPSIS);
+  }
+}
