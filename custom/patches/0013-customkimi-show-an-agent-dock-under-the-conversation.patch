+import { describe, expect, it } from 'vitest';
+
+import { AgentConversationComponent } from '#/tui/components/messages/agent-conversation';
+import { USER_MESSAGE_BULLET } from '#/tui/constant/symbols';
+import type { SubagentActivityRecord } from '#/tui/controllers/subagent-activity-store';
+
+const ANSI = /\u001b\[[0-9;]*m/g;
+const plain = (lines: string[]): string => lines.map((line) => line.replace(ANSI, '')).join('\n');
+
+function record(overrides: Partial<SubagentActivityRecord> = {}): SubagentActivityRecord {
+  return {
+    agentId: 'a1',
+    agentName: 'coder',
+    description: 'lister',
+    prompt: 'List the files in src and count them.',
+    parentToolCallId: 'tc-1',
+    model: 'openai/gpt-6-astra',
+    effort: 'high',
+    steps: [
+      {
+        step: 1,
+        textTail: 'Let me look at the directory.',
+        toolCalls: [
+          {
+            id: 't1',
+            name: 'Bash',
+            args: { command: 'ls src' },
+            status: 'done',
+            startedAt: 0,
+            durationMs: 12,
+            result: { tool_call_id: 't1', output: 'a.ts\nb.ts', is_error: false },
+          },
+        ],
+      },
+    ],
+    totalSteps: 1,
+    status: 'running',
+    version: 3,
+    ...overrides,
+  };
+}
+
+describe('AgentConversationComponent', () => {
+  it('shows the task prompt as a user message, then the assistant text and tool calls', () => {
+    const text = plain(new AgentConversationComponent(record(), { tick: () => 2 }).render(100));
+    expect(text).toContain('agent coder › lister · openai/gpt-6-astra · high');
+    expect(text).toContain(`${USER_MESSAGE_BULLET}List the files in src and count them.`);
+    expect(text).toContain('Let me look at the directory.');
+    expect(text).toContain('Used Bash');
+    expect(text).toContain('coder is working…');
+  });
+
+  it('falls back to the description without a prompt and shows the result when finished', () => {
+    const done = record({
+      prompt: undefined,
+      status: 'completed',
+      resultSummary: 'There are 2 files.',
+    });
+    const text = plain(new AgentConversationComponent(done).render(100));
+    expect(text).toContain(`${USER_MESSAGE_BULLET}lister`);
+    expect(text).toContain('✓ coder finished');
+    expect(text).toContain('There are 2 files.');
+    expect(text).not.toContain('is working');
+  });
+
+  it('shows the failure and re-renders when the record version moves', () => {
+    const rec = record({ status: 'failed', error: 'boom' });
+    const component = new AgentConversationComponent(rec);
+    expect(plain(component.render(100))).toContain('✗ coder failed');
+    const before = component.render(100);
+    expect(component.render(100)).toBe(before);
+    rec.steps[0]!.textTail = 'Changed text.';
+    rec.version += 1;
+    expect(plain(component.render(100))).toContain('Changed text.');
+  });
+});
