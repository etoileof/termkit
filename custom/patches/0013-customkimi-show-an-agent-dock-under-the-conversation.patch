+import { describe, expect, it, vi } from 'vitest';
+
+import {
+  AgentDockComponent,
+  COMPLETED_LINGER_MS,
+  FAILED_LINGER_MS,
+  type AgentDockRow,
+} from '#/tui/components/chrome/agent-dock';
+import { STATUS_BULLET } from '#/tui/constant/symbols';
+import type { SubagentActivityRecord } from '#/tui/controllers/subagent-activity-store';
+import { currentTheme } from '#/tui/theme';
+
+const ANSI = /\u001b\[[0-9;]*m/g;
+const plain = (lines: string[]): string[] => lines.map((line) => line.replace(ANSI, ''));
+
+function record(agentId: string, overrides: Partial<SubagentActivityRecord> = {}): SubagentActivityRecord {
+  return {
+    agentId,
+    agentName: `agent-${agentId}`,
+    description: undefined,
+    parentToolCallId: `tc-${agentId}`,
+    model: 'openai/gpt-6-astra',
+    effort: 'high',
+    steps: [],
+    totalSteps: 0,
+    status: 'running',
+    version: 0,
+    ...overrides,
+  };
+}
+
+function setup(now = { t: 1_000 }) {
+  const opened: AgentDockRow[] = [];
+  let left = 0;
+  const dock = new AgentDockComponent({
+    onOpen: (row) => {
+      opened.push(row);
+    },
+    onLeave: () => {
+      left += 1;
+    },
+    requestRender: () => {},
+    now: () => now.t,
+  });
+  return { dock, opened, leftCount: () => left, now };
+}
+
+describe('AgentDockComponent', () => {
+  it('renders nothing without agents and a row per agent with a running dot', () => {
+    vi.useFakeTimers();
+    try {
+      const { dock } = setup();
+      expect(dock.render(80)).toEqual([]);
+
+      dock.upsert(record('a', { description: 'Audit the first layer' }));
+      dock.upsert(
+        record('b', {
+          steps: [
+            {
+              step: 1,
+              textTail: '',
+              toolCalls: [
+                { id: 't1', name: 'Read', args: { path: 'src/x.ts' }, status: 'running', startedAt: 0 },
+              ],
+            },
+          ],
+        }),
+      );
+      const lines = plain(dock.render(120));
+      expect(lines[0]).toBe('');
+      expect(lines[1]).toContain(`${STATUS_BULLET}agent-a · Audit the first layer · openai/gpt-6-astra · high · 0s`);
+      expect(lines[2]).toContain(`${STATUS_BULLET}agent-b · openai/gpt-6-astra · high · 1 tools · 0s · Read src/x.ts`);
+      expect(lines[3]).toContain('↓ agents');
+      dock.dispose();
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
+  it('turns the dot green on completion, red on failure, and drops rows after they linger', () => {
+    vi.useFakeTimers();
+    try {
+      const { dock, now } = setup();
+      const done = record('done');
+      const failed = record('failed');
+      dock.upsert(done);
+      dock.upsert(failed);
+
+      done.status = 'completed';
+      failed.status = 'failed';
+      dock.upsert(done);
+      dock.upsert(failed);
+      const lines = dock.render(120);
+      expect(lines[1]).toContain(currentTheme.fg('success', STATUS_BULLET));
+      expect(plain([lines[1]!])[0]).toContain('· done');
+      expect(lines[2]).toContain(currentTheme.fg('error', STATUS_BULLET));
+      expect(plain([lines[2]!])[0]).toContain('· failed');
+
+      now.t += COMPLETED_LINGER_MS;
+      dock.expire();
+      expect(plain(dock.render(120)).filter((l) => l.includes(STATUS_BULLET))).toHaveLength(1);
+
+      now.t += FAILED_LINGER_MS;
+      dock.expire();
+      expect(dock.render(120)).toEqual([]);
+      expect(dock.isEmpty()).toBe(true);
+      dock.dispose();
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
+  it('moves the selection with the arrows, opens on Enter and leaves on Esc or past the last row', () => {
+    vi.useFakeTimers();
+    try {
+      const { dock, opened, leftCount } = setup();
+      dock.upsert(record('a'));
+      dock.upsert(record('b'));
+
+      expect(dock.focus()).toBe(true);
+      expect(plain(dock.render(120))[1]).toMatch(/^❯ /);
+      expect(plain(dock.render(120))[3]).toContain('Enter');
+
+      dock.handleInput('\u001b[B'); // down
+      expect(plain(dock.render(120))[2]).toMatch(/^❯ /);
+      dock.handleInput('\r'); // enter
+      expect(opened.map((row) => row.agentId)).toEqual(['b']);
+
+      dock.handleInput('\u001b[A'); // up
+      expect(dock.selectedRow()?.agentId).toBe('a');
+      dock.handleInput('\u001b'); // esc
+      expect(leftCount()).toBe(1);
+      expect(dock.focused).toBe(false);
+
+      dock.focus();
+      dock.handleInput('\u001b[B');
+      dock.handleInput('\u001b[B'); // past the last row
+      expect(leftCount()).toBe(2);
+      expect(dock.focused).toBe(false);
+      dock.dispose();
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
+  it('keeps the selected finished row while focused and marks dropped running agents as ended', () => {
+    vi.useFakeTimers();
+    try {
+      const { dock, now } = setup();
+      const a = record('a');
+      dock.upsert(a);
+      dock.upsert(record('b'));
+      dock.focus();
+
+      a.status = 'completed';
+      dock.upsert(a);
+      now.t += COMPLETED_LINGER_MS * 2;
+      dock.expire();
+      expect(dock.has('a')).toBe(true);
+
+      dock.markDropped('b');
+      const lines = plain(dock.render(120));
+      expect(lines[2]).toContain('· ended');
+
+      dock.blur();
+      dock.expire();
+      expect(dock.has('a')).toBe(false);
+      dock.dispose();
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
+  it('while viewing, the arrows switch the shown agent and Enter or Esc go back to the chat', () => {
+    vi.useFakeTimers();
+    try {
+      const selected: string[] = [];
+      let back = 0;
+      const dock = new AgentDockComponent({
+        onOpen: () => {},
+        onSelect: (row) => {
+          selected.push(row.agentId);
+        },
+        onBack: () => {
+          back += 1;
+        },
+        onLeave: () => {},
+        requestRender: () => {},
+      });
+      dock.upsert(record('a'));
+      dock.upsert(record('b'));
+      dock.focus();
+      dock.viewing = true;
+      expect(plain(dock.render(120))[3]).toContain('back to chat');
+
+      dock.handleInput('\u001b[B');
+      dock.handleInput('\u001b[B'); // stays on the last row while viewing
+      expect(selected).toEqual(['b']);
+      expect(dock.focused).toBe(true);
+      dock.handleInput('\r');
+      dock.handleInput('\u001b');
+      expect(back).toBe(2);
+      dock.dispose();
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
+  it('cannot focus when empty', () => {
+    const { dock } = setup();
+    expect(dock.focus()).toBe(false);
+    expect(dock.focused).toBe(false);
+  });
+});
