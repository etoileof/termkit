diff --git a/apps/kimi-code/src/tui/components/messages/agent-conversation.ts b/apps/kimi-code/src/tui/components/messages/agent-conversation.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0e92a72faad9ba5ee79496d1e4730e2bc6291e32
--- /dev/null
+++ b/apps/kimi-code/src/tui/components/messages/agent-conversation.ts
@@ -0,0 +1,116 @@
+/**
+ * AgentConversationComponent — a subagent's conversation shown in place of
+ * the main transcript, in the main transcript's own shape: the task prompt
+ * the parent gave the agent as a user message, then each step's assistant
+ * text (Markdown) and tool calls through the main-flow renderers, and the
+ * agent's result or failure at the end. It renders from the agent's
+ * `SubagentActivityRecord` snapshot and re-renders when the record's version
+ * moves, so it stays live while the agent runs.
+ */
+
+import { Spacer, type Component } from '@moonshot-ai/pi-tui';
+
+import { MESSAGE_INDENT } from '#/tui/constant/rendering';
+import type { SubagentActivityRecord } from '#/tui/controllers/subagent-activity-store';
+import { currentTheme } from '#/tui/theme';
+
+import { AssistantMessageComponent } from './assistant-message';
+import { buildSubagentToolCallHeader, renderSubagentToolCallBody } from './subagent-activity-lines';
+import { UserMessageComponent } from './user-message';
+
+const SPINNER = ['⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏'];
+
+export interface AgentConversationOptions {
+  /** Expand every tool result (main transcript's `toolOutputExpanded`). */
+  readonly expanded?: () => boolean;
+  /** Animation step for the working indicator while the agent runs. */
+  readonly tick?: () => number;
+}
+
+export class AgentConversationComponent implements Component {
+  private cache: { key: string; lines: string[] } | undefined;
+
+  constructor(
+    readonly record: SubagentActivityRecord,
+    private readonly options: AgentConversationOptions = {},
+  ) {}
+
+  invalidate(): void {
+    this.cache = undefined;
+  }
+
+  render(width: number): string[] {
+    const expanded = this.options.expanded?.() ?? false;
+    const tick = this.record.status === 'running' ? (this.options.tick?.() ?? 0) : -1;
+    const key = `${String(width)}|${String(this.record.version)}|${expanded ? 'x' : 'c'}|${String(tick)}`;
+    if (this.cache?.key === key) return this.cache.lines;
+    const lines = this.build(width, expanded, tick);
+    this.cache = { key, lines };
+    return lines;
+  }
+
+  private build(width: number, expanded: boolean, tick: number): string[] {
+    const { record } = this;
+    const out: string[] = [];
+    const push = (component: Component): void => {
+      out.push(...component.render(width));
+    };
+
+    push(new Spacer(1));
+    out.push(this.header());
+    push(new UserMessageComponent(record.prompt ?? record.description ?? '(no prompt recorded)'));
+
+    for (const step of record.steps) {
+      if (step.retrying !== undefined) {
+        out.push(currentTheme.fg('warning', `${MESSAGE_INDENT}↻ ${step.retrying}`));
+      }
+      if (step.textTail.trim().length > 0) {
+        const message = new AssistantMessageComponent();
+        message.updateContent(step.textTail);
+        push(message);
+      }
+      for (const call of step.toolCalls) {
+        out.push('');
+        out.push(buildSubagentToolCallHeader(call));
+        out.push(...renderSubagentToolCallBody(call, width, expanded));
+      }
+    }
+
+    if (record.status === 'running') {
+      out.push('');
+      out.push(currentTheme.dim(`${SPINNER[tick % SPINNER.length]!} ${record.agentName} is working…`));
+    } else if (record.error !== undefined && record.error.length > 0) {
+      push(new Spacer(1));
+      out.push(currentTheme.fg('error', `✗ ${record.agentName} failed`));
+      const message = new AssistantMessageComponent();
+      message.updateContent(record.error);
+      push(message);
+    } else if (record.resultSummary !== undefined && record.resultSummary.length > 0) {
+      push(new Spacer(1));
+      out.push(currentTheme.boldFg('success', `✓ ${record.agentName} finished`));
+      const message = new AssistantMessageComponent();
+      message.updateContent(record.resultSummary);
+      push(message);
+    }
+    out.push('');
+    return out;
+  }
+
+  /** One muted line so the swapped transcript is recognizable as an agent's. */
+  private header(): string {
+    const { record } = this;
+    const label =
+      record.description !== undefined && record.description.length > 0
+        ? `${record.agentName} › ${record.description}`
+        : record.agentName;
+    const meta = [record.model, record.effort].filter(
+      (part): part is string => part !== undefined && part.length > 0,
+    );
+    const metaStr = meta.length > 0 ? ` · ${meta.join(' · ')}` : '';
+    let range = '';
+    if (record.totalSteps > record.steps.length) {
+      range = ` · earlier steps discarded`;
+    }
+    return currentTheme.fg('textMuted', `agent ${label}${metaStr}${range}`);
+  }
+}
diff --git a/apps/kimi-code/src/tui/components/messages/subagent-activity-lines.ts b/apps/kimi-code/src/tui/components/messages/subagent-activity-lines.ts
new file mode 100644
index 0000000000000000000000000000000000000000..15b5b026d6f6468943ef7adb5324e89d0c6e18a0
--- /dev/null
+++ b/apps/kimi-code/src/tui/components/messages/subagent-activity-lines.ts
@@ -0,0 +1,78 @@
+/**
+ * Renders one subagent tool call from a `SubagentActivityRecord` snapshot the
+ * way the main transcript renders its own: the generic header (bullet + verb +
+ * name + key argument + chip) and the per-tool result body through the
+ * main-flow renderers. Shared by the full-screen activity viewer and the
+ * inline agent conversation. `ToolCallComponent` itself is not reused — it is
+ * a live, event-driven component, while these render a snapshot.
+ */
+
+import { MESSAGE_INDENT } from '#/tui/constant/rendering';
+import { STATUS_BULLET } from '#/tui/constant/symbols';
+import type { SubToolCallActivity } from '#/tui/controllers/subagent-activity-store';
+import { currentTheme } from '#/tui/theme';
+import type { ToolCallBlockData } from '#/tui/types';
+
+import { extractKeyArgument } from './tool-call';
+import { pickChip } from './tool-renderers/chip';
+import { pickResultRenderer } from './tool-renderers/registry';
+
+function toToolCallBlockData(call: SubToolCallActivity): ToolCallBlockData {
+  return { id: call.id, name: call.name, args: call.args };
+}
+
+/** Same shape as the main flow's generic header (`tool-call.ts` `buildHeader`).
+ *  Custom per-tool label wording (e.g. "Ran a command") is intentionally not
+ *  mirrored — the per-tool *body* renderers carry the specialization. */
+export function buildSubagentToolCallHeader(call: SubToolCallActivity): string {
+  let bullet: string;
+  if (call.status === 'error') {
+    bullet = currentTheme.fg('error', '✗ ');
+  } else if (call.status === 'done') {
+    bullet = currentTheme.fg('success', STATUS_BULLET);
+  } else {
+    bullet = currentTheme.fg('text', STATUS_BULLET);
+  }
+  const verb = call.status === 'running' ? 'Using' : 'Used';
+  const name = currentTheme.boldFg('primary', call.name);
+  const keyArg = extractKeyArgument(call.name, call.args);
+  const argStr = keyArg === null || keyArg.length === 0 ? '' : currentTheme.dim(` (${keyArg})`);
+
+  let chipStr = '';
+  if (call.result !== undefined) {
+    const provider = pickChip(call.name);
+    const text = provider?.(toToolCallBlockData(call), call.result) ?? '';
+    if (text.length > 0) {
+      chipStr =
+        call.result.is_error === true
+          ? currentTheme.fg('error', ` · ${text}`)
+          : currentTheme.dim(` · ${text}`);
+    }
+  }
+  return `${bullet}${verb} ${name}${argStr}${chipStr}`;
+}
+
+export function renderSubagentToolCallBody(
+  call: SubToolCallActivity,
+  innerWidth: number,
+  expanded: boolean,
+): string[] {
+  if (call.result === undefined) {
+    return call.liveOutputTail === undefined || call.liveOutputTail.length === 0
+      ? []
+      : [currentTheme.dim(`${MESSAGE_INDENT}│ ${call.liveOutputTail}`)];
+  }
+  // The store caps retained output, which cannot survive as a parseable
+  // media envelope (base64) — show a marker instead of dumping the blob.
+  if (call.name === 'ReadMediaFile' && call.result.is_error !== true) {
+    return [currentTheme.dim(`${MESSAGE_INDENT}[media output omitted]`)];
+  }
+  const components = pickResultRenderer(call.name)(toToolCallBlockData(call), call.result, {
+    expanded,
+  });
+  const out: string[] = [];
+  for (const component of components) {
+    out.push(...component.render(innerWidth));
+  }
+  return out;
+}
diff --git a/apps/kimi-code/src/tui/controllers/agent-dock-controller.ts b/apps/kimi-code/src/tui/controllers/agent-dock-controller.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1b8daad83b08305ca2e7da13206aa179e99319bf
--- /dev/null
+++ b/apps/kimi-code/src/tui/controllers/agent-dock-controller.ts
@@ -0,0 +1,216 @@
+/**
+ * AgentDockController — wires the agent dock under the conversation to the
+ * subagent activity store and shows an agent's conversation on Enter.
+ *
+ * The dock mirrors the store: every spawned subagent gets a row, status
+ * follows the record, and a dropped record (foreground agent of an aborted
+ * turn) marks the row ended. Opening a row swaps the main transcript for an
+ * `AgentConversationComponent` in place — the dock, editor and footer stay
+ * where they are, so the agent reads like the normal chat. `↑`/`↓` then
+ * switch to another agent, `Enter`/`Esc` bring the main chat back. The
+ * conversation stays live through the store subscription and the dock's
+ * animation timer.
+ */
+
+import { TuiAltScreen, VStack, type Component } from '@moonshot-ai/pi-tui';
+
+import { AgentDockComponent, type AgentDockRow } from '#/tui/components/chrome/agent-dock';
+import { GutterContainer } from '#/tui/components/chrome/gutter-container';
+import { AgentConversationComponent } from '#/tui/components/messages/agent-conversation';
+import { TranscriptView } from '#/tui/components/messages/transcript-view';
+import { CHROME_GUTTER } from '#/tui/constant/rendering';
+import type { SessionEventHandler } from '#/tui/controllers/session-event-handler';
+import type { SubagentActivityChange } from '#/tui/controllers/subagent-activity-store';
+import type { TUIState } from '#/tui/tui-state';
+
+export interface AgentDockHost {
+  readonly state: TUIState;
+  readonly sessionEventHandler: SessionEventHandler;
+}
+
+/** The main transcript's slot while an agent's conversation replaces it. */
+type TranscriptSwap =
+  | { readonly kind: 'root'; readonly root: Component | undefined }
+  | { readonly kind: 'children'; readonly index: number };
+
+interface OpenConversation {
+  readonly row: AgentDockRow;
+  readonly component: AgentConversationComponent;
+  readonly swap: TranscriptSwap;
+}
+
+/** Coalesce the per-delta store notifications into a few renders a second. */
+const RENDER_COALESCE_MS = 80;
+
+export class AgentDockController {
+  readonly dock: AgentDockComponent;
+  private open: OpenConversation | undefined;
+  private renderTimer: ReturnType<typeof setTimeout> | undefined;
+  private readonly unsubscribe: () => void;
+
+  constructor(private readonly host: AgentDockHost) {
+    this.dock = new AgentDockComponent({
+      onOpen: (row) => {
+        this.show(row);
+      },
+      onSelect: (row) => {
+        this.show(row);
+      },
+      onBack: () => {
+        this.closeConversation();
+      },
+      onLeave: () => {
+        this.focusEditor();
+      },
+      requestRender: () => {
+        this.scheduleRender();
+      },
+    });
+    host.state.agentDockContainer.addChild(this.dock);
+    this.unsubscribe = this.store.subscribe((change) => {
+      this.onStoreChange(change);
+    });
+  }
+
+  private get store() {
+    return this.host.sessionEventHandler.subAgentEventHandler.activityStore;
+  }
+
+  /** `↓` on an empty editor: move the keyboard into the dock. */
+  focusFromEditor(): boolean {
+    if (!this.dock.focus()) return false;
+    this.host.state.ui.setFocus(this.dock);
+    return true;
+  }
+
+  isConversationOpen(): boolean {
+    return this.open !== undefined;
+  }
+
+  /** New session: nothing of the old one is left to show. */
+  reset(): void {
+    this.closeConversation();
+    this.dock.clear();
+  }
+
+  dispose(): void {
+    this.unsubscribe();
+    this.closeConversation();
+    this.dock.dispose();
+    if (this.renderTimer !== undefined) {
+      clearTimeout(this.renderTimer);
+      this.renderTimer = undefined;
+    }
+  }
+
+  private onStoreChange(change: SubagentActivityChange): void {
+    switch (change.kind) {
+      case 'update': {
+        const record = this.store.get(change.agentId);
+        if (record !== undefined) this.dock.upsert(record);
+        return;
+      }
+      case 'drop':
+        this.dock.markDropped(change.agentId);
+        return;
+      case 'clear':
+        this.reset();
+        return;
+    }
+  }
+
+  // ── the agent's conversation in place of the main transcript ───────
+
+  private show(row: AgentDockRow): void {
+    if (this.open?.row === row) return;
+    const { state } = this.host;
+    const component = new AgentConversationComponent(row.record, {
+      expanded: () => state.toolOutputExpanded,
+      tick: () => this.dock.animationTick(),
+    });
+    if (this.open !== undefined) {
+      // Switching agents: reuse the slot, only the content changes.
+      const swap = this.open.swap;
+      this.open = { row, component, swap };
+      this.mount(component, swap);
+    } else {
+      this.open = { row, component, swap: this.takeTranscriptSlot(component) };
+    }
+    this.dock.viewing = true;
+    state.ui.setFocus(this.dock);
+    state.ui.requestRender(true);
+  }
+
+  private closeConversation(): void {
+    const open = this.open;
+    if (open === undefined) return;
+    this.open = undefined;
+    this.dock.viewing = false;
+    this.restoreTranscriptSlot(open.swap);
+    const { state } = this.host;
+    if (this.dock.focus()) {
+      state.ui.setFocus(this.dock);
+    } else {
+      this.focusEditor();
+    }
+    state.ui.requestRender(true);
+  }
+
+  /** Put the conversation where the main transcript renders. Fullscreen keeps
+   *  the transcript in a ScrollView under the layout root; the regular layout
+   *  lists it as the first child of the UI. */
+  private takeTranscriptSlot(component: AgentConversationComponent): TranscriptSwap {
+    const { ui } = this.host.state;
+    if (ui instanceof TuiAltScreen) {
+      const swap: TranscriptSwap = { kind: 'root', root: ui.getLayoutRoot() };
+      this.mount(component, swap);
+      return swap;
+    }
+    const index = Math.max(0, ui.children.indexOf(this.host.state.transcriptContainer));
+    const swap: TranscriptSwap = { kind: 'children', index };
+    this.mount(component, swap);
+    return swap;
+  }
+
+  private mount(component: AgentConversationComponent, swap: TranscriptSwap): void {
+    const { state } = this.host;
+    const container = new GutterContainer(CHROME_GUTTER, CHROME_GUTTER);
+    container.addChild(component);
+    if (swap.kind === 'root') {
+      const ui = state.ui as TuiAltScreen;
+      const root = new VStack();
+      root.addChild(new TranscriptView(container), { basis: 0, grow: 1, shrink: 1, minSize: 1 });
+      if (state.dockContainer !== undefined) {
+        root.addChild(state.dockContainer, { basis: 'auto', grow: 0, shrink: 1, minSize: 1 });
+      }
+      ui.setLayoutRoot(root);
+      return;
+    }
+    state.ui.children[swap.index] = container;
+  }
+
+  private restoreTranscriptSlot(swap: TranscriptSwap): void {
+    const { state } = this.host;
+    if (swap.kind === 'root') {
+      if (state.ui instanceof TuiAltScreen) state.ui.setLayoutRoot(swap.root);
+      return;
+    }
+    state.ui.children[swap.index] = state.transcriptContainer;
+  }
+
+  private focusEditor(): void {
+    this.dock.blur();
+    const { state } = this.host;
+    state.ui.setFocus(state.editor);
+    this.scheduleRender();
+  }
+
+  private scheduleRender(): void {
+    if (this.renderTimer !== undefined) return;
+    this.renderTimer = setTimeout(() => {
+      this.renderTimer = undefined;
+      this.host.state.ui.requestRender();
+    }, RENDER_COALESCE_MS);
+    this.renderTimer.unref?.();
+  }
+}
