+++ b/apps/kimi-code/src/tui/controllers/session-event-handler.ts
@@ -478,6 +478,17 @@ export class SessionEventHandler {
   }
 
   private handleStepRetrying(event: TurnStepRetryingEvent): void {
+    this.host.streamingUI.flushNow();
+    const status = event.statusCode === undefined ? '' : ` (HTTP ${event.statusCode})`;
+    const seconds = Math.max(1, Math.ceil(event.delayMs / 1000));
+    this.host.appendTranscriptEntry({
+      id: nextTranscriptId(),
+      kind: 'status',
+      turnId: String(event.turnId),
+      renderMode: 'plain',
+      preserveWhenFolding: true,
+      content: `System notice: Model request failed${status}. Retrying attempt ${event.nextAttempt}/${event.maxAttempts} in ${seconds}s.`,
+    });
     // The failure may arrive mid-stream, after thinking/assistant deltas have
     // parked the pane in `thinking`/`composing` — drive it back to waiting so
     // the retry label and detail actually render during the backoff.
