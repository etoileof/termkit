@@ -330,3 +330,39 @@ describe('requester toolMessageConversion', () => {
     expect(JSON.stringify(inputItems)).not.toContain('input_image');
   });
 });
+
+describe('requester extraBody', () => {
+  const extraBody = {
+    provider: { only: ['cerebras/fp16'], allow_fallbacks: false },
+    model: 'overridden',
+    stream: false,
+  };
+
+  it('adds the extra fields at the top level of a chat completions request', async () => {
+    const client = stubOpenAIClient(chatCompletionChunks);
+    const requester = createOpenAIRequester({ clientFactory: client.clientFactory });
+    await requester.generate(
+      { model, extraBody, thinking: { effort: 'high' } },
+      { messages },
+      { signal: new AbortController().signal },
+    );
+    expect(client.body()['provider']).toEqual({ only: ['cerebras/fp16'], allow_fallbacks: false });
+    expect(client.body()['model']).toBe('test-model');
+    expect(client.body()['stream']).toBe(true);
+    expect(client.body()['reasoning_effort']).toBe('high');
+    expect(client.body()['extra_body']).toBeUndefined();
+  });
+
+  it('adds the extra fields at the top level of a responses request', async () => {
+    const client = stubResponsesClient(responsesStreamEvents);
+    const requester = createOpenAIResponsesRequester({ clientFactory: client.clientFactory });
+    await requester.generate(
+      { model, extraBody },
+      { messages },
+      { signal: new AbortController().signal },
+    );
+    expect(client.body()['provider']).toEqual({ only: ['cerebras/fp16'], allow_fallbacks: false });
+    expect(client.body()['model']).toBe('test-model');
+    expect(client.body()['stream']).toBe(true);
+  });
+});
