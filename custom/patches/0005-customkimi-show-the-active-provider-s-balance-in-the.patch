@@ -0,0 +1,99 @@
+import { describe, expect, it } from 'vitest';
+
+import {
+  BALANCE_API_PATH,
+  BALANCE_BADGE_HTML,
+  BALANCE_BADGE_SCRIPT_PATH,
+  registerBalanceBadge,
+  type BadgeConfig,
+  type BadgeRouteHost,
+} from '#/cli/sub/web/balance-badge';
+import type { BillingSource } from '#/utils/billing/billing-monitor';
+
+type Handler = Parameters<BadgeRouteHost['get']>[1];
+
+const config: BadgeConfig = {
+  defaultModel: 'closerouter/openai-gpt-6-astra',
+  models: {
+    '7api/gpt-6-astra': { provider: '7api-responses', model: 'gpt-6-astra' },
+    'closerouter/openai-gpt-6-astra': { provider: 'closerouter', model: 'openai/gpt-6-astra' },
+    'other/model': { provider: 'other', model: 'model' },
+  },
+  providers: {
+    '7api-responses': { baseUrl: 'https://7api.st/v1' },
+    closerouter: { baseUrl: 'https://api.closerouter.dev/v1' },
+    other: { baseUrl: 'https://other.example/v1' },
+  },
+};
+
+const billing: BillingSource = {
+  start: () => {},
+  stop: () => {},
+  balanceFor: (baseUrl) => {
+    if (baseUrl === 'https://7api.st/v1') return { label: '7api', usd: 9.18 };
+    if (baseUrl === 'https://api.closerouter.dev/v1') return { label: 'ClosedRouter', usd: 18.2 };
+    return undefined;
+  },
+  sessionCostUsd: () => undefined,
+};
+
+function routes() {
+  const registered = new Map<string, Handler>();
+  registerBalanceBadge({ get: (path, handler) => registered.set(path, handler) }, billing, () => config);
+  return registered;
+}
+
+async function call(path: string, query: unknown) {
+  const reply = {
+    contentType: '',
+    payload: undefined as unknown,
+    type(contentType: string) {
+      this.contentType = contentType;
+      return this;
+    },
+    send(payload: unknown) {
+      this.payload = payload;
+      return this;
+    },
+  };
+  await routes().get(path)?.({ query }, reply);
+  return reply;
+}
+
+describe('web balance badge route', () => {
+  it('returns the balance of the provider serving the requested model', async () => {
+    const reply = await call(BALANCE_API_PATH, { model: '7api/gpt-6-astra' });
+
+    expect(reply.contentType).toBe('application/json; charset=utf-8');
+    expect(reply.payload).toEqual({ code: 0, msg: 'success', data: { label: '7api', usd: 9.18 } });
+  });
+
+  it('uses the default model when no model is given', async () => {
+    const reply = await call(BALANCE_API_PATH, {});
+
+    expect(reply.payload).toEqual({ code: 0, msg: 'success', data: { label: 'ClosedRouter', usd: 18.2 } });
+  });
+
+  it('returns no balance for unknown models or providers without billing', async () => {
+    expect((await call(BALANCE_API_PATH, { model: 'unknown/model' })).payload).toEqual({
+      code: 0,
+      msg: 'success',
+      data: null,
+    });
+    expect((await call(BALANCE_API_PATH, { model: 'other/model' })).payload).toEqual({
+      code: 0,
+      msg: 'success',
+      data: null,
+    });
+  });
+
+  it("serves a badge script that asks for the open session's model with the web credential", async () => {
+    const reply = await call(BALANCE_BADGE_SCRIPT_PATH, {});
+
+    expect(reply.contentType).toBe('text/javascript; charset=utf-8');
+    expect(reply.payload).toContain(BALANCE_API_PATH);
+    expect(reply.payload).toContain('/api/v1/sessions/');
+    expect(reply.payload).toContain('kimi-web.server-credential');
+    expect(BALANCE_BADGE_HTML).toBe(`<script src="${BALANCE_BADGE_SCRIPT_PATH}" defer></script>`);
+  });
+});
