+import {
+  loadRuntimeConfigSafe,
+  resolveConfigPath,
+  type ModelAlias,
+  type ProviderConfig,
+} from '@moonshot-ai/kimi-code-sdk';
+
+import { modelResolver, type BillingSource } from '#/utils/billing/billing-monitor';
+import { asRecord } from '#/utils/billing/billing-provider';
+
+import { balanceBadgeScript } from './balance-badge-script';
+
+export const BALANCE_API_PATH = '/api/customkimi/balance';
+export const BALANCE_BADGE_SCRIPT_PATH = '/customkimi/balance-badge.js';
+export const BALANCE_BADGE_HTML = `<script src="${BALANCE_BADGE_SCRIPT_PATH}" defer></script>`;
+
+/** The parts of the configuration the badge needs. */
+export interface BadgeConfig {
+  readonly defaultModel?: string | undefined;
+  readonly models: Readonly<Record<string, Pick<ModelAlias, 'provider' | 'model' | 'baseUrl'>>>;
+  readonly providers: Readonly<Record<string, Pick<ProviderConfig, 'baseUrl'>>>;
+}
+
+interface BadgeReply {
+  type(contentType: string): BadgeReply;
+  send(payload: unknown): unknown;
+}
+
+/** The part of the web server (Fastify) the badge needs. */
+export interface BadgeRouteHost {
+  get(
+    path: string,
+    handler: (req: { readonly query: unknown }, reply: BadgeReply) => Promise<unknown>,
+  ): unknown;
+}
+
+function loadBadgeConfig(): BadgeConfig {
+  const { config } = loadRuntimeConfigSafe(resolveConfigPath({}));
+  return { defaultModel: config.defaultModel, models: config.models ?? {}, providers: config.providers ?? {} };
+}
+
+/**
+ * Adds the web UI balance badge: its script, served next to the web assets, and an API
+ * route (behind the server's bearer auth, like every /api route) returning the balance of
+ * the provider serving `?model=<alias>`, or the default model. The browser script looks up
+ * the open session's model itself, because the server redacts credentials before handlers
+ * run, so a handler cannot call the session API on the caller's behalf.
+ */
+export function registerBalanceBadge(
+  app: BadgeRouteHost,
+  billing: BillingSource,
+  loadConfig: () => BadgeConfig = loadBadgeConfig,
+): void {
+  const script = balanceBadgeScript(BALANCE_API_PATH);
+  app.get(BALANCE_BADGE_SCRIPT_PATH, async (_req, reply) =>
+    reply.type('text/javascript; charset=utf-8').send(script),
+  );
+
+  app.get(BALANCE_API_PATH, async (req, reply) => {
+    const config = loadConfig();
+    const requested = asRecord(req.query)?.['model'];
+    const alias = typeof requested === 'string' && requested !== '' ? requested : config.defaultModel;
+    const endpoint = alias === undefined ? undefined : modelResolver(config.models, config.providers)(alias);
+    const balance = billing.balanceFor(endpoint?.baseUrl);
+    return reply
+      .type('application/json; charset=utf-8')
+      .send({ code: 0, msg: 'success', data: balance ?? null });
+  });
+}
