diff --git a/apps/kimi-code/src/cli/sub/web/balance-badge-script.ts b/apps/kimi-code/src/cli/sub/web/balance-badge-script.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9d3d95f51caf8c0bec8ff263ef4715c64686fa69
--- /dev/null
+++ b/apps/kimi-code/src/cli/sub/web/balance-badge-script.ts
@@ -0,0 +1,137 @@
+/**
+ * Browser script for the web UI balance badge. It sits just before the model picker in
+ * the composer toolbar (`.mp-name`); if a web UI update moves the picker, it falls back
+ * to a small fixed pill in the bottom-right corner. It reads the web UI's own stored
+ * credential, asks the session API for the open session's model, refreshes every minute
+ * and whenever the session or model changes, and hides itself when no balance is known.
+ * A credential the server rejects is never retried, so the badge cannot trip the
+ * server's failed-auth rate limit.
+ */
+export function balanceBadgeScript(apiPath: string): string {
+  return `(function () {
+  'use strict';
+  var API = ${JSON.stringify(apiPath)};
+  var CREDENTIAL_KEY = 'kimi-web.server-credential';
+  var BADGE_ID = 'customkimi-balance';
+  var STYLE_ID = 'customkimi-balance-style';
+  var latest = null;
+  var rejected = null;
+  var lastSessionId;
+  var lastModelText;
+  var scheduled = false;
+
+  function credential() {
+    try {
+      var raw = localStorage.getItem(CREDENTIAL_KEY);
+      if (!raw) return null;
+      try {
+        var parsed = JSON.parse(raw);
+        if (parsed && typeof parsed.credential === 'string') return parsed.credential;
+      } catch (error) {}
+      return raw;
+    } catch (error) {
+      return null;
+    }
+  }
+
+  function sessionId() {
+    var match = location.pathname.match(/\\/sessions\\/(session_[\\w-]+)/);
+    return match ? match[1] : null;
+  }
+
+  function modelText() {
+    var picker = document.querySelector('.mp-name');
+    return picker ? picker.textContent : null;
+  }
+
+  function getJson(url, token) {
+    return fetch(url, { headers: token ? { Authorization: 'Bearer ' + token } : {} }).then(function (response) {
+      if (response.status === 401) {
+        rejected = token;
+        return null;
+      }
+      return response.ok ? response.json() : null;
+    });
+  }
+
+  function refresh() {
+    var token = credential() || '';
+    if (token === rejected) {
+      latest = null;
+      render();
+      return;
+    }
+    var id = sessionId();
+    var model = id
+      ? getJson('/api/v1/sessions/' + encodeURIComponent(id) + '/status', token).then(function (body) {
+          return body && body.data && typeof body.data.model === 'string' ? body.data.model : null;
+        })
+      : Promise.resolve(null);
+    model
+      .then(function (alias) {
+        if (token === rejected) return null;
+        return getJson(alias ? API + '?model=' + encodeURIComponent(alias) : API, token);
+      })
+      .then(function (body) { latest = body && body.data ? body.data : null; render(); })
+      .catch(function () { latest = null; render(); });
+  }
+
+  function ensureStyle() {
+    if (document.getElementById(STYLE_ID)) return;
+    var style = document.createElement('style');
+    style.id = STYLE_ID;
+    style.textContent =
+      '#' + BADGE_ID + '{font-size:13px;opacity:.6;white-space:nowrap;margin-right:12px;align-self:center}' +
+      '#' + BADGE_ID + '.ck-floating{position:fixed;right:16px;bottom:12px;margin:0;padding:3px 10px;' +
+      'border-radius:999px;background:rgba(127,127,127,.15);opacity:.85;z-index:2147483647}';
+    document.head.appendChild(style);
+  }
+
+  function render() {
+    var badge = document.getElementById(BADGE_ID);
+    if (!latest || typeof latest.usd !== 'number') {
+      if (badge) badge.remove();
+      return;
+    }
+    ensureStyle();
+    if (!badge) {
+      badge = document.createElement('span');
+      badge.id = BADGE_ID;
+    }
+    var text = latest.label + ' $' + latest.usd.toFixed(2);
+    if (badge.textContent !== text) badge.textContent = text;
+    badge.title = latest.label + ' account balance';
+    var picker = document.querySelector('.mp-name');
+    var anchor = picker ? picker.closest('button') || picker : null;
+    if (anchor && anchor.parentElement) {
+      badge.classList.remove('ck-floating');
+      if (badge.nextElementSibling !== anchor) anchor.parentElement.insertBefore(badge, anchor);
+    } else {
+      badge.classList.add('ck-floating');
+      if (badge.parentElement !== document.body) document.body.appendChild(badge);
+    }
+  }
+
+  function onChange() {
+    if (scheduled) return;
+    scheduled = true;
+    requestAnimationFrame(function () {
+      scheduled = false;
+      var id = sessionId();
+      var text = modelText();
+      if (id !== lastSessionId || text !== lastModelText) {
+        lastSessionId = id;
+        lastModelText = text;
+        refresh();
+      } else {
+        render();
+      }
+    });
+  }
+
+  new MutationObserver(onChange).observe(document.body, { childList: true, subtree: true, characterData: true });
+  setInterval(refresh, 60000);
+  onChange();
+})();
+`;
+}
