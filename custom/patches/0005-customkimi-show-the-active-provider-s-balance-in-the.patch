@@ -0,0 +1,68 @@
+import { mkdir, mkdtemp, rm, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+
+import Fastify, { type FastifyInstance } from 'fastify';
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+
+import { registerWebAssetRoutes } from '../src/routes/webAssets';
+
+const SNIPPET = '<script src="/extra.js" defer></script>';
+
+describe('web asset HTML injection', () => {
+  let app: FastifyInstance;
+  let assetsDir: string;
+
+  beforeEach(async () => {
+    assetsDir = await mkdtemp(join(tmpdir(), 'kimi-web-inject-'));
+    await mkdir(join(assetsDir, 'assets'));
+    await Promise.all([
+      writeFile(join(assetsDir, 'index.html'), '<html><head><title>Kimi</title></head><body></body></html>'),
+      writeFile(join(assetsDir, 'assets', 'index-Dy7xs5tu.js'), 'export {};'),
+    ]);
+    app = Fastify();
+  });
+
+  afterEach(async () => {
+    await app.close();
+    await rm(assetsDir, { recursive: true, force: true });
+  });
+
+  it.each(['/', '/index.html', '/sessions/session_abc'])(
+    'adds the snippet before </head> when serving the page at %s',
+    async (url) => {
+      await registerWebAssetRoutes(app, assetsDir, { htmlInjection: SNIPPET });
+      const response = await app.inject({ method: 'GET', url });
+
+      expect(response.statusCode).toBe(200);
+      expect(response.body).toBe(
+        `<html><head><title>Kimi</title>${SNIPPET}</head><body></body></html>`,
+      );
+      expect(response.headers['content-type']).toBe('text/html; charset=utf-8');
+      expect(response.headers['content-length']).toBe(String(Buffer.byteLength(response.body)));
+      expect(response.headers['cache-control']).toBe('no-cache');
+    },
+  );
+
+  it('appends the snippet when the page has no </head>', async () => {
+    await writeFile(join(assetsDir, 'index.html'), '<main>Kimi</main>');
+    await registerWebAssetRoutes(app, assetsDir, { htmlInjection: SNIPPET });
+    const response = await app.inject({ method: 'GET', url: '/' });
+
+    expect(response.body).toBe(`<main>Kimi</main>${SNIPPET}`);
+  });
+
+  it('leaves other assets untouched', async () => {
+    await registerWebAssetRoutes(app, assetsDir, { htmlInjection: SNIPPET });
+    const response = await app.inject({ method: 'GET', url: '/assets/index-Dy7xs5tu.js' });
+
+    expect(response.body).toBe('export {};');
+  });
+
+  it('serves the page unchanged without an injection', async () => {
+    await registerWebAssetRoutes(app, assetsDir);
+    const response = await app.inject({ method: 'GET', url: '/' });
+
+    expect(response.body).toBe('<html><head><title>Kimi</title></head><body></body></html>');
+  });
+});
