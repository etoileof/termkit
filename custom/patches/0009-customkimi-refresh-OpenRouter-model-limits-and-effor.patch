+const API = 'https://openrouter.ai/api/v1';
+const CATALOG_URL = `${API}/models`;
+const PROVIDER_KEY = 'or-provider-key';
+
+const MUSE = 'meta/muse-wonder';
+const OPTIONAL = 'example/optional-reasoner';
+const MANDATORY_NONE = 'example/mandatory-none';
+const PLAIN = 'example/plain';
+const TOGGLE = 'example/toggle';
+const FREE = 'example/free:free';
+
+/** The real catalog entry of the target model (verified 2026-10-22). */
+const MUSE_ENTRY = {
+  id: MUSE,
+  context_length: 1048576,
+  top_provider: { context_length: 1048576, max_completion_tokens: 943718 },
+  pricing: { prompt: '0.000004', completion: '0.00002' },
+  reasoning: {
+    mandatory: true,
+    supported_efforts: ['max', 'xhigh', 'high', 'medium', 'low', 'minimal'],
+    default_effort: 'medium',
+  },
+};
+
+const CATALOG = [
+  MUSE_ENTRY,
+  {
+    id: OPTIONAL,
+    context_length: 400000,
+    top_provider: { max_completion_tokens: 128000 },
+    reasoning: { mandatory: false, supported_efforts: ['high', 'none', 'low', 'medium'], default_effort: 'medium' },
+  },
+  {
+    id: MANDATORY_NONE,
+    context_length: 200000,
+    top_provider: { max_completion_tokens: 64000 },
+    reasoning: { mandatory: true, supported_efforts: ['none', 'low', 'high'] },
+  },
+  { id: PLAIN, context_length: 131072, top_provider: { max_completion_tokens: null }, reasoning: null },
+  { id: TOGGLE, context_length: 262144, top_provider: { max_completion_tokens: 32768 }, reasoning: { default_enabled: true, mandatory: false } },
+  { id: FREE, context_length: 32768, top_provider: { max_completion_tokens: 4096 }, reasoning: null },
+  { id: 'example/not-configured', context_length: 1, top_provider: { max_completion_tokens: 1 }, reasoning: null },
+];
+
+interface Call {
+  readonly url: string;
+  readonly init: RequestInit;
+}
+
+function recordingFetch(respond: () => Response | Promise<Response> = () => Response.json({ data: CATALOG })): {
+  readonly calls: Call[];
+  readonly fetchImpl: typeof fetch;
+} {
+  const calls: Call[] = [];
+  const fetchImpl = (async (url: string, init: RequestInit) => {
+    calls.push({ url, init });
+    return respond();
+  }) as typeof fetch;
+  return { calls, fetchImpl };
+}
+
+function baseConfig(): ManagedKimiConfigShape {
+  return {
+    providers: {
+      openrouter: { type: 'openai', baseUrl: 'https://openrouter.ai/api/v1', apiKey: PROVIDER_KEY },
+      'openrouter-responses': { type: 'openai_responses', baseUrl: 'https://openrouter.ai/api/v1/', apiKeyEnv: 'OPENROUTER_TEST_KEY' },
+      other: { type: 'openai', baseUrl: 'https://example.test/v1', apiKey: 'other-key' },
+    },
+    defaultModel: 'openrouter/muse',
+    thinking: { enabled: true, effort: 'high' },
+    models: {
+      'openrouter/muse': {
+        provider: 'openrouter',
+        model: MUSE,
+        maxContextSize: 1000000,
+        capabilities: ['image_in'],
+        overrides: { maxOutputSize: 32000 },
+      },
+      'openrouter-responses/optional': { provider: 'openrouter-responses', model: OPTIONAL, maxContextSize: 1 },
+      'other/model': { provider: 'other', model: 'other-model', maxContextSize: 1000 },
+    },
+  };
+}
+
+interface MemoryHost extends RefreshProviderHost {
+  readonly writes: ManagedKimiConfigShape[];
+  current(): ManagedKimiConfigShape;
+  edit(change: (config: ManagedKimiConfigShape) => void): void;
+}
+
+function memoryHost(initial: ManagedKimiConfigShape): MemoryHost {
+  let config = structuredClone(initial);
+  const writes: ManagedKimiConfigShape[] = [];
+  return {
+    writes,
+    current: () => config,
+    edit: (change) => {
+      change(config);
+    },
+    getConfig: async () => structuredClone(config),
+    setConfig: async (patch) => {
+      writes.push(structuredClone(patch));
+      const { models, ...rest } = structuredClone(patch);
+      config = { ...config, ...rest };
+      if (models !== undefined) {
+        // Like the real config writer: written aliases replace the section,
+        // but a key missing from a written alias keeps its stored value.
+        config.models = Object.fromEntries(
+          Object.entries(models).map(([alias, model]) => [
+            alias,
+            { ...(config.models?.[alias] as Record<string, unknown> | undefined), ...model },
+          ]),
+        );
+      }
+      return structuredClone(config);
+    },
+    removeProvider: async () => {
+      throw new Error('an OpenRouter refresh must never remove a provider');
+    },
+    resolveOAuthToken: async () => {
+      throw new Error('an OpenRouter refresh needs no OAuth token');
+    },
+    userAgent: 'kimi-code-cli/test',
+  };
+}
+
+function model(config: ManagedKimiConfigShape, alias: string): Record<string, unknown> {
+  return config.models![alias] as Record<string, unknown>;
+}
+
+async function refresh(
+  host: MemoryHost,
+  respond?: () => Response | Promise<Response>,
+  options: OpenRouterRefreshOptions = {},
+): Promise<Awaited<ReturnType<typeof refreshOpenRouterModels>> & { readonly calls: Call[] }> {
+  const { calls, fetchImpl } = recordingFetch(respond);
+  const result = await refreshOpenRouterModels(host, await host.getConfig(), { fetchImpl, ...options });
+  return { ...result, calls };
+}
+
+/**
+ * Answers at once, then streams the catalog after `delayMs` (never when it is
+ * undefined); the body fails when the request signal aborts, like fetch's.
+ */
+function slowBodyFetch(delayMs?: number): typeof fetch {
+  return ((_url: string, init: RequestInit) => {
+    const signal = init.signal!;
+    const body = new ReadableStream<Uint8Array>({
+      start(controller) {
+        signal.addEventListener(
+          'abort',
+          () => {
+            controller.error(signal.reason);
+          },
+          { once: true },
+        );
+        if (delayMs === undefined) return;
+        setTimeout(() => {
+          if (signal.aborted) return;
+          controller.enqueue(new TextEncoder().encode(JSON.stringify({ data: CATALOG })));
+          controller.close();
+        }, delayMs);
+      },
+    });
+    return Promise.resolve(new Response(body, { status: 200 }));
+  }) as typeof fetch;
+}
