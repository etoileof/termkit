diff --git a/packages/oauth/src/openrouter.ts b/packages/oauth/src/openrouter.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4072f739ab2337096b5c4566e730d09f762623d2
--- /dev/null
+++ b/packages/oauth/src/openrouter.ts
@@ -0,0 +1,334 @@
+import type { ManagedKimiConfigShape } from './managed-kimi-code';
+import { readApiErrorMessage } from './api-error';
+import {
+  ENDPOINT_TYPE_BY_PROTOCOL,
+  ENV_OVERLAY_PREFIX,
+  ENV_TABLE_BASE_URL,
+  FailureLog,
+  errorMessage,
+  parseEfforts,
+  patchAlias,
+  positiveInteger,
+  readAlias,
+  sameAlias,
+  secondaryModelEffort,
+  subagentEffortProblem,
+  thinkingFields,
+  type AliasMetadata,
+  type CloseRouterEndpointType,
+  type CloseRouterProviderChange,
+  type CloseRouterRefreshHost,
+  type CloseRouterRefreshResult,
+  type SubagentEffort,
+} from './closerouter';
+import { nonEmptyString } from './provider-credential';
+import { isRecord } from './utils';
+
+/**
+ * OpenRouter model metadata refresh.
+ *
+ * Configured aliases whose endpoint is OpenRouter get their limits
+ * (`context_length`, `top_provider.max_completion_tokens`) and reasoning
+ * efforts (`reasoning.supported_efforts`) from OpenRouter's public model
+ * catalog, `GET /api/v1/models`. The catalog needs no API key, so this refresh
+ * never sends one. Only aliases that already exist are updated; the catalog is
+ * never imported.
+ *
+ * The refreshed fields, the Chat / Responses thinking rules and the
+ * `[secondary_model]` effort check are CloseRouter's own helpers (see
+ * ./closerouter): `[models."<alias>".overrides]` are never touched.
+ * closerouter.ts only exports its helpers, so three parts of
+ * refreshCloseRouterModels() are mirrored here instead of shared: the target
+ * skip rules (openRouterTargets), the conflict message
+ * (subagentEffortConflict) and the re-read, merge and models-only write, which
+ * writes nothing when nothing changed. A fix to one belongs in both.
+ */
+
+const OPENROUTER_HOST = 'openrouter.ai';
+const OPENROUTER_API_BASE = `https://${OPENROUTER_HOST}/api/v1`;
+
+const DEFAULT_REQUEST_TIMEOUT_MS = 10_000;
+const DEFAULT_DEADLINE_MS = 30_000;
+
+/** Routing variants (`:nitro`, `:floor`, `:online`, …) share their base model's metadata. */
+const VARIANT_SUFFIX = /:[^/:]+$/;
+
+export type OpenRouterRefreshResult = CloseRouterRefreshResult;
+
+export interface OpenRouterRefreshOptions {
+  /** Refresh only the aliases of this provider. */
+  readonly providerId?: string;
+  /** Upper bound for the wait for the catalog response, until its headers arrive. */
+  readonly requestTimeoutMs?: number;
+  /** Upper bound for the whole catalog request, body included. */
+  readonly deadlineMs?: number;
+  readonly fetchImpl?: typeof fetch;
+}
+
+interface OpenRouterTarget {
+  readonly alias: string;
+  readonly providerId: string;
+  readonly modelId: string;
+  readonly endpointType: CloseRouterEndpointType;
+}
+
+type Catalog = ReadonlyMap<string, Record<string, unknown>>;
+
+/**
+ * Normalizes a configured base URL to OpenRouter's API base, or returns
+ * undefined when it is not exactly `https://openrouter.ai/api/v1` (an optional
+ * trailing slash aside): plain HTTP, a port, credentials, a query or another
+ * path or host are rejected.
+ */
+export function openRouterApiBase(baseUrl: unknown): string | undefined {
+  const value = nonEmptyString(baseUrl);
+  if (value === undefined) return undefined;
+  let url: URL;
+  try {
+    url = new URL(value);
+  } catch {
+    return undefined;
+  }
+  if (url.protocol !== 'https:' || url.hostname !== OPENROUTER_HOST) return undefined;
+  if (url.port !== '' || url.username !== '' || url.password !== '') return undefined;
+  if (url.search !== '' || url.hash !== '') return undefined;
+  return /^\/api\/v1\/?$/.test(url.pathname) ? OPENROUTER_API_BASE : undefined;
+}
+
+export async function refreshOpenRouterModels(
+  host: CloseRouterRefreshHost,
+  config: ManagedKimiConfigShape,
+  options: OpenRouterRefreshOptions = {},
+): Promise<OpenRouterRefreshResult> {
+  const targets = openRouterTargets(config, options.providerId);
+  if (targets.length === 0) return { config, changed: [], unchanged: [], failed: [] };
+
+  const failures = new FailureLog();
+  let catalog: Catalog;
+  try {
+    catalog = await fetchCatalog(host.userAgent, options);
+  } catch (error) {
+    failures.addFor(
+      targets,
+      `OpenRouter model catalog request failed (${errorMessage(error)}); keeping the previous limits and efforts.`,
+    );
+    return { config, changed: [], unchanged: [], failed: failures.list() };
+  }
+
+  // Merge into the config as it is now, not as it was before the request:
+  // aliases edited, added or removed meanwhile are taken as they are. The
+  // catalog lists every model, so aliases added meanwhile are refreshed too.
+  let fresh: ManagedKimiConfigShape;
+  try {
+    fresh = await host.getConfig();
+  } catch (error) {
+    failures.addFor(targets, `Could not re-read the config after the OpenRouter request: ${errorMessage(error)}`);
+    return { config, changed: [], unchanged: [], failed: failures.list() };
+  }
+  const next = structuredClone(fresh);
+  const subagentEffort = secondaryModelEffort(fresh);
+  const changed = new Map<string, CloseRouterProviderChange>();
+  const seen = new Set<string>();
+  for (const target of openRouterTargets(fresh, options.providerId)) {
+    seen.add(target.providerId);
+    const current = readAlias(fresh, target.alias);
+    const aliasMetadata = metadataForTarget(catalog, target, current, failures);
+    let patched = patchAlias(current, target.endpointType, aliasMetadata);
+    const conflict = subagentEffortConflict(subagentEffort, target.alias, current, patched);
+    if (conflict !== undefined) {
+      failures.add(target.providerId, conflict);
+      patched = patchAlias(current, target.endpointType, { ...aliasMetadata, efforts: undefined });
+    }
+    if (!sameAlias(current, patched)) {
+      next.models![target.alias] = patched;
+      const previous = changed.get(target.providerId);
+      changed.set(target.providerId, {
+        providerId: target.providerId,
+        aliases: (previous?.aliases ?? 0) + 1,
+        limits:
+          previous?.limits === true ||
+          current['maxContextSize'] !== patched['maxContextSize'] ||
+          current['maxOutputSize'] !== patched['maxOutputSize'],
+        efforts:
+          previous?.efforts === true ||
+          JSON.stringify(thinkingFields(current)) !== JSON.stringify(thinkingFields(patched)),
+      });
+    }
+  }
+
+  const failed = failures.list();
+  const unchanged = [...seen].filter(
+    (providerId) =>
+      !changed.has(providerId) && !failed.some((failure) => failure.provider === providerId),
+  );
+  if (changed.size === 0) return { config: fresh, changed: [], unchanged, failed };
+  try {
+    // Only the models section is written; every host leaves sections absent
+    // from the patch untouched, so concurrent provider edits survive.
+    const written = await host.setConfig({ models: next.models } as ManagedKimiConfigShape);
+    return { config: written, changed: [...changed.values()], unchanged, failed };
+  } catch (error) {
+    for (const providerId of changed.keys()) {
+      failures.add(providerId, `Could not save the refreshed OpenRouter metadata: ${errorMessage(error)}`);
+    }
+    return { config: fresh, changed: [], unchanged, failed: failures.list() };
+  }
+}
+
+function openRouterTargets(
+  config: ManagedKimiConfigShape,
+  providerId: string | undefined,
+): OpenRouterTarget[] {
+  const targets: OpenRouterTarget[] = [];
+  for (const [alias, model] of Object.entries(config.models ?? {})) {
+    if (!isRecord(model) || alias.startsWith(ENV_OVERLAY_PREFIX)) continue;
+    const owner = nonEmptyString(model['provider']);
+    if (owner === undefined || owner.startsWith(ENV_OVERLAY_PREFIX)) continue;
+    if (providerId !== undefined && owner !== providerId) continue;
+    const provider = config.providers[owner];
+    if (!isRecord(provider)) continue;
+    // The same opt-outs as CloseRouter: `model_source = "static"`, and
+    // registry- and OAuth-managed providers and models.
+    if (provider['modelSource'] === 'static') continue;
+    if (provider['source'] !== undefined || provider['oauth'] !== undefined) continue;
+    if (model['oauth'] !== undefined) continue;
+    // OpenRouter is called through the OpenAI Chat or Responses API only.
+    const protocol = model['protocol'] ?? provider['type'];
+    const endpointType =
+      typeof protocol === 'string' ? ENDPOINT_TYPE_BY_PROTOCOL[protocol] : undefined;
+    if (endpointType === undefined || endpointType === 'messages') continue;
+    // The runtime's precedence: the model's `base_url`, else the provider's,
+    // else the base URL in the provider's `env` table for its type.
+    const type = provider['type'] ?? model['protocol'];
+    const env = provider['env'];
+    const baseUrl =
+      nonEmptyString(model['baseUrl']) ??
+      nonEmptyString(provider['baseUrl']) ??
+      (isRecord(env) && typeof type === 'string' ? nonEmptyString(env[ENV_TABLE_BASE_URL[type] ?? '']) : undefined);
+    if (openRouterApiBase(baseUrl) === undefined) continue;
+    const modelId = nonEmptyString(model['name']) ?? nonEmptyString(model['model']);
+    if (modelId === undefined) continue;
+    targets.push({ alias, providerId: owner, modelId, endpointType });
+  }
+  return targets;
+}
+
+function metadataForTarget(
+  catalog: Catalog,
+  target: OpenRouterTarget,
+  current: Record<string, unknown>,
+  failures: FailureLog,
+): AliasMetadata {
+  const entry = catalog.get(target.modelId) ?? catalog.get(target.modelId.replace(VARIANT_SUFFIX, ''));
+  if (entry === undefined) {
+    failures.add(
+      target.providerId,
+      `${target.modelId} is not in the OpenRouter catalog; keeping its previous limits and efforts.`,
+    );
+    return {};
+  }
+  const maxContextSize = positiveInteger(entry['context_length']);
+  if (maxContextSize === undefined) {
+    failures.add(
+      target.providerId,
+      `OpenRouter reports no valid context_length for ${target.modelId}; keeping its previous context size.`,
+    );
+  }
+  const topProvider = entry['top_provider'];
+  return {
+    maxContextSize,
+    maxOutputSize: isRecord(topProvider) ? positiveInteger(topProvider['max_completion_tokens']) : undefined,
+    efforts: effortsForTarget(entry, target, current, failures),
+  };
+}
+
+/**
+ * A model without a `reasoning.supported_efforts` list is treated like a
+ * CloseRouter endpoint that lists no effort levels: its previous efforts stay.
+ */
+function effortsForTarget(
+  entry: Record<string, unknown>,
+  target: OpenRouterTarget,
+  current: Record<string, unknown>,
+  failures: FailureLog,
+): readonly string[] | undefined {
+  const reasoning = isRecord(entry['reasoning']) ? entry['reasoning'] : {};
+  const listed = reasoning['supported_efforts'];
+  const parsed = parseEfforts(Array.isArray(listed) ? listed : undefined);
+  if (parsed === undefined) {
+    failures.add(
+      target.providerId,
+      `OpenRouter returned invalid reasoning.supported_efforts for ${target.modelId}; keeping its previous efforts.`,
+    );
+    return undefined;
+  }
+  // Mandatory reasoning cannot be turned off, whatever the list says.
+  const efforts = reasoning['mandatory'] === true ? parsed.filter((effort) => effort !== 'none') : parsed;
+  if (efforts.every((effort) => effort === 'none') && Array.isArray(current['supportEfforts'])) {
+    failures.add(
+      target.providerId,
+      `OpenRouter lists no reasoning effort levels for ${target.modelId}; keeping its previous efforts.`,
+    );
+    return undefined;
+  }
+  return efforts;
+}
+
+function subagentEffortConflict(
+  subagent: SubagentEffort | undefined,
+  alias: string,
+  current: Record<string, unknown>,
+  patched: Record<string, unknown>,
+): string | undefined {
+  if (subagent === undefined || !subagent.aliases.has(alias)) return undefined;
+  if (JSON.stringify(thinkingFields(current)) === JSON.stringify(thinkingFields(patched))) {
+    return undefined;
+  }
+  const problem = subagentEffortProblem(subagent.effort, patched);
+  if (problem === undefined) return undefined;
+  return `[secondary_model] default_effort "${subagent.effort}" would no longer work with ${alias}: ${problem}. Change default_effort to apply OpenRouter's efforts; keeping its previous efforts.`;
+}
+
+async function fetchCatalog(userAgent: string | undefined, options: OpenRouterRefreshOptions): Promise<Catalog> {
+  // The catalog is public: no Authorization header, so no key can leak here.
+  const headers: Record<string, string> = { Accept: 'application/json' };
+  if (userAgent !== undefined) headers['User-Agent'] = userAgent;
+  const fetchImpl = options.fetchImpl ?? fetch;
+  // The request timeout bounds the wait for the response; reading the large
+  // catalog body may then take until the deadline.
+  const responseTimeout = new AbortController();
+  const timer = setTimeout(() => {
+    responseTimeout.abort(new DOMException('The catalog request timed out.', 'TimeoutError'));
+  }, options.requestTimeoutMs ?? DEFAULT_REQUEST_TIMEOUT_MS);
+  let response: Response;
+  try {
+    response = await fetchImpl(`${OPENROUTER_API_BASE}/models`, {
+      headers,
+      // Requests go to openrouter.ai only, never wherever a redirect points.
+      redirect: 'error',
+      signal: AbortSignal.any([
+        AbortSignal.timeout(options.deadlineMs ?? DEFAULT_DEADLINE_MS),
+        responseTimeout.signal,
+      ]),
+    });
+  } finally {
+    clearTimeout(timer);
+  }
+  if (!response.ok) {
+    throw new Error(await readApiErrorMessage(response, `HTTP ${response.status}`));
+  }
+  const text = await response.text();
+  let body: unknown;
+  try {
+    body = JSON.parse(text) as unknown;
+  } catch {
+    throw new Error('the response is not valid JSON');
+  }
+  const entries = isRecord(body) && Array.isArray(body['data']) ? body['data'] : undefined;
+  if (entries === undefined) throw new Error('the response has no data list');
+  const catalog = new Map<string, Record<string, unknown>>();
+  for (const entry of entries) {
+    if (isRecord(entry) && typeof entry['id'] === 'string') catalog.set(entry['id'], entry);
+  }
+  return catalog;
+}
