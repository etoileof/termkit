diff --git a/packages/node-sdk/test/session-billing.test.ts b/packages/node-sdk/test/session-billing.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a740b2a9b125fa63d2d355176eec7a27e605dfce
--- /dev/null
+++ b/packages/node-sdk/test/session-billing.test.ts
@@ -0,0 +1,294 @@
+/**
+ * Scenario: session-wide billing on the v2 engine — every agent's usage (main
+ * agent, foreground and background subagents, finished ones too) is billed
+ * once, live and after a resume, while the main agent's own usage and
+ * context stay agent-local.
+ * Wiring: real v2 engine bootstrapped on a temp home. The live case drives
+ * real subagents through a stubbed Chat Completions endpoint; the resume case
+ * also writes records in the persisted wire format the engine appends.
+ * Run: pnpm exec vitest run test/session-billing.test.ts
+ */
+import { appendFile, mkdir, mkdtemp, readdir, readFile, rm, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+
+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+import { createKimiHarness, SDKRpcClientV2, type Event, type Session } from '#/index';
+import { drainQueryStoreDisposals, drainSessionIndexMirror, MAIN_AGENT_ID } from '@moonshot-ai/agent-core-v2';
+
+import { TEST_IDENTITY } from './test-identity';
+
+const tempDirs: string[] = [];
+
+afterEach(async () => {
+  await drainSessionIndexMirror();
+  await drainQueryStoreDisposals();
+  for (const dir of tempDirs.splice(0)) {
+    await rm(dir, { recursive: true, force: true, maxRetries: 5, retryDelay: 50 });
+  }
+});
+
+async function findSessionDir(homeDir: string, sessionId: string): Promise<string> {
+  for (const bucket of await readdir(join(homeDir, 'sessions'))) {
+    const candidate = join(homeDir, 'sessions', bucket, sessionId);
+    try {
+      await readdir(candidate);
+      return candidate;
+    } catch {
+      // Not under this bucket.
+    }
+  }
+  throw new Error(`no persisted directory found for session ${sessionId}`);
+}
+
+function usageLine(agentId: string, model: string, cost: number): string {
+  return `${JSON.stringify({
+    type: 'usage.record',
+    agentId,
+    model,
+    usage: { inputOther: 100, output: 10, inputCacheRead: 0, inputCacheCreation: 0, cost },
+    usageScope: 'turn',
+    time: 1,
+  })}\n`;
+}
+
+async function appendWire(homedir: string, lines: readonly string[]): Promise<void> {
+  await mkdir(homedir, { recursive: true });
+  const wirePath = join(homedir, 'wire.jsonl');
+  const existing = await readFile(wirePath, 'utf-8').catch(() => undefined);
+  const metadata = `${JSON.stringify({ type: 'metadata', protocol_version: '1.5', created_at: 1 })}\n`;
+  await (existing === undefined
+    ? writeFile(wirePath, metadata + lines.join(''), 'utf-8')
+    : appendFile(wirePath, lines.join(''), 'utf-8'));
+}
+
+async function addSubagent(
+  sessionDir: string,
+  agentId: string,
+  parentAgentId: string,
+  lines: readonly string[],
+): Promise<void> {
+  const homedir = join(sessionDir, 'agents', agentId);
+  await appendWire(homedir, lines);
+  const statePath = join(sessionDir, 'state.json');
+  const state = JSON.parse(await readFile(statePath, 'utf-8')) as {
+    agents?: Record<string, unknown>;
+  };
+  state.agents = { ...state.agents, [agentId]: { homedir, type: 'sub', parentAgentId } };
+  await writeFile(statePath, JSON.stringify(state), 'utf-8');
+}
+
+describe('session billing over the v2 engine', () => {
+  it('bills every persisted agent once after a resume and leaves the main agent usage alone', async () => {
+    const homeDir = await mkdtemp(join(tmpdir(), 'kimi-sdk-billing-'));
+    const workDir = await mkdtemp(join(tmpdir(), 'kimi-sdk-billing-work-'));
+    tempDirs.push(homeDir, workDir);
+    const client = new SDKRpcClientV2({ homeDir, identity: TEST_IDENTITY });
+
+    try {
+      await client.createSession({ id: 'ses_billing', workDir });
+      await client.closeSession({ sessionId: 'ses_billing' });
+      const sessionDir = await findSessionDir(homeDir, 'ses_billing');
+      await appendWire(join(sessionDir, 'agents', MAIN_AGENT_ID), [
+        usageLine(MAIN_AGENT_ID, 'router/astra', 0.01),
+        usageLine(MAIN_AGENT_ID, 'router/astra', 0.02),
+      ]);
+      await addSubagent(sessionDir, 'agent-0', MAIN_AGENT_ID, [usageLine('agent-0', 'router/astra', 0.04)]);
+      await addSubagent(sessionDir, 'agent-1', 'agent-0', [
+        usageLine('agent-1', 'router/opus', 0.08),
+        usageLine('agent-1', 'router/opus', 0.16),
+      ]);
+
+      await client.resumeSession({ id: 'ses_billing' });
+      const status = await client.getStatus({ sessionId: 'ses_billing' });
+
+      expect(status.usage?.total?.cost).toBeCloseTo(0.03);
+      expect(status.usage?.total?.inputOther).toBe(200);
+      expect(status.billingUsage?.total?.cost).toBeCloseTo(0.31);
+      expect(status.billingUsage?.total?.inputOther).toBe(500);
+      expect(status.billingUsage?.byModel?.['router/astra']?.cost).toBeCloseTo(0.07);
+      expect(status.billingUsage?.byModel?.['router/opus']?.cost).toBeCloseTo(0.24);
+      expect(status.contextTokens).toBe(0);
+
+      const again = await client.getStatus({ sessionId: 'ses_billing' });
+      expect(again.billingUsage).toEqual(status.billingUsage);
+    } finally {
+      await client.close();
+    }
+  });
+
+  it('bills foreground and background subagents live, after the main turn and after a restart', async () => {
+    const homeDir = await mkdtemp(join(tmpdir(), 'kimi-sdk-billing-live-'));
+    const workDir = await mkdtemp(join(tmpdir(), 'kimi-sdk-billing-live-work-'));
+    tempDirs.push(homeDir, workDir);
+    const ledger = { main: 0, child: 0, background: 0 };
+    let releaseBackground!: () => void;
+    const backgroundGate = new Promise<void>((resolve) => {
+      releaseBackground = resolve;
+    });
+    let mainRequests = 0;
+    const fetchStub = vi.spyOn(globalThis, 'fetch').mockImplementation(async (input, init) => {
+      const url = typeof input === 'string' ? input : input instanceof URL ? input.href : input.url;
+      if (url !== MODEL_URL) throw new Error(`Unexpected fetch: ${url}`);
+      const body = JSON.parse(typeof init?.body === 'string' ? init.body : '{}') as {
+        readonly messages?: ReadonlyArray<{ readonly role: string; readonly content: unknown }>;
+      };
+      // Each agent's conversation starts with its own task.
+      const task = JSON.stringify(body.messages?.find((message) => message.role === 'user')?.content);
+      if (task.includes('CHILD-BACKGROUND')) {
+        await backgroundGate;
+        return completion('background done', 'background', 0.04, ledger);
+      }
+      if (task.includes('CHILD-FOREGROUND')) return completion('child done', 'child', 0.02, ledger);
+      mainRequests += 1;
+      if (mainRequests === 1) return agentCall('CHILD-FOREGROUND', false, ledger);
+      if (mainRequests === 2) return agentCall('CHILD-BACKGROUND', true, ledger);
+      return completion('all done', 'main', 0.01, ledger);
+    });
+    let harness = createKimiHarness({ identity: TEST_IDENTITY, homeDir });
+    try {
+      await configureFakeProvider(harness);
+      let session = await harness.createSession({ id: 'ses_billing_live', workDir, permission: 'yolo' });
+      const events: Event[] = [];
+      const unsubscribe = session.onEvent((event) => events.push(event));
+      const mainTurnsEnded = (): number =>
+        events.filter((event) => event.type === 'turn.ended' && event.agentId === 'main').length;
+
+      await session.prompt('Delegate the work.');
+      await waitFor(() => mainTurnsEnded() === 1);
+      const beforeBackground = await session.getStatus();
+      expect(beforeBackground.billingUsage?.total?.cost).toBeCloseTo(ledger.main + ledger.child);
+      expect(beforeBackground.billingUsage?.byModel?.['fake-child']?.cost).toBeCloseTo(ledger.child);
+      expect(beforeBackground.usage?.total?.cost).toBeCloseTo(ledger.main);
+      expect(beforeBackground.maxContextTokens).toBe(262144);
+
+      let mainCostAtEvent = Number.NaN;
+      const billed = waitForEvent(session, (event) => {
+        if (event.type !== 'agent.status.updated' || event.billingUsage === undefined) return false;
+        if (Math.abs((event.billingUsage.total?.cost ?? 0) - (ledger.main + ledger.child + 0.04)) > 1e-9) {
+          return false;
+        }
+        mainCostAtEvent = ledger.main;
+        return true;
+      });
+      releaseBackground();
+      const afterBackground = await billed;
+      if (afterBackground.type !== 'agent.status.updated') throw new Error('unexpected event');
+      expect(afterBackground.agentId).toBe('main');
+      expect(afterBackground.usage?.total?.cost).toBeCloseTo(mainCostAtEvent);
+      expect(afterBackground.maxContextTokens).toBe(262144);
+      expect(afterBackground.billingUsage?.byModel?.['fake-child']?.cost).toBeCloseTo(ledger.child + 0.04);
+
+      // The finished background task starts one more main turn; wait for it to settle.
+      await waitFor(() => mainTurnsEnded() === 2);
+      unsubscribe();
+      const status = (event: Event): { maxContextTokens?: number } | undefined =>
+        event.type === 'agent.status.updated' && event.maxContextTokens !== undefined ? event : undefined;
+      const mainLimits = new Set(events.filter((event) => event.agentId === 'main').map((event) => status(event)?.maxContextTokens));
+      const childLimits = new Set(events.filter((event) => event.agentId !== 'main').map((event) => status(event)?.maxContextTokens));
+      mainLimits.delete(undefined);
+      childLimits.delete(undefined);
+      expect(mainLimits).toEqual(new Set([262144]));
+      expect(childLimits).toEqual(new Set([100000]));
+
+      const total = ledger.main + ledger.child + ledger.background;
+      const settled = await session.getStatus();
+      expect(settled.billingUsage?.total?.cost).toBeCloseTo(total);
+      expect(settled.usage?.total?.cost).toBeCloseTo(ledger.main);
+
+      await session.close();
+      await harness.close();
+      harness = createKimiHarness({ identity: TEST_IDENTITY, homeDir });
+      session = await harness.resumeSession({ id: 'ses_billing_live' });
+      const resumed = await session.getStatus();
+      expect(resumed.billingUsage?.total?.cost).toBeCloseTo(total);
+      expect(resumed.usage?.total?.cost).toBeCloseTo(ledger.main);
+    } finally {
+      fetchStub.mockRestore();
+      releaseBackground();
+      await harness.close();
+    }
+  });
+});
+
+const MODEL_URL = 'https://model.example.test/v1/chat/completions';
+
+type Ledger = Record<'main' | 'child' | 'background', number>;
+
+function sse(chunks: readonly Record<string, unknown>[]): Response {
+  const body = [...chunks.map((chunk) => `data: ${JSON.stringify(chunk)}`), 'data: [DONE]']
+    .map((line) => `${line}\n\n`)
+    .join('');
+  return new Response(body, { status: 200, headers: { 'Content-Type': 'text/event-stream' } });
+}
+
+function chunk(delta: Record<string, unknown>, finishReason: string | null = null): Record<string, unknown> {
+  return { id: 'chatcmpl-stub', object: 'chat.completion.chunk', created: 0, model: 'fake-model', choices: [{ index: 0, delta, finish_reason: finishReason }] };
+}
+
+function usage(cost: number): Record<string, unknown> {
+  return { id: 'chatcmpl-stub', object: 'chat.completion.chunk', created: 0, model: 'fake-model', choices: [], usage: { prompt_tokens: 100, completion_tokens: 10, total_tokens: 110, cost } };
+}
+
+function completion(text: string, role: keyof Ledger, cost: number, ledger: Ledger): Response {
+  ledger[role] += cost;
+  return sse([chunk({ role: 'assistant', content: text }), chunk({}, 'stop'), usage(cost)]);
+}
+
+function agentCall(prompt: string, background: boolean, ledger: Ledger): Response {
+  ledger.main += 0.01;
+  return sse([
+    chunk({
+      role: 'assistant',
+      tool_calls: [
+        {
+          index: 0,
+          id: `call-${prompt}`,
+          type: 'function',
+          function: {
+            name: 'Agent',
+            arguments: JSON.stringify({ description: prompt, prompt, run_in_background: background }),
+          },
+        },
+      ],
+    }),
+    chunk({}, 'tool_calls'),
+    usage(0.01),
+  ]);
+}
+
+async function configureFakeProvider(harness: ReturnType<typeof createKimiHarness>): Promise<void> {
+  await harness.setConfig({
+    providers: { local: { type: 'openai', baseUrl: 'https://model.example.test/v1', apiKey: 'sk-test' } },
+    models: {
+      'fake-model': { provider: 'local', model: 'fake-model', maxContextSize: 262144 },
+      'fake-child': { provider: 'local', model: 'fake-child', maxContextSize: 100000 },
+    },
+    defaultModel: 'fake-model',
+    secondaryModel: { defaultModel: 'fake-child' },
+  });
+}
+
+function waitForEvent(session: Session, predicate: (event: Event) => boolean): Promise<Event> {
+  return new Promise((resolve, reject) => {
+    const timeout = setTimeout(() => {
+      unsubscribe();
+      reject(new Error('Timed out waiting for session event'));
+    }, 10_000);
+    const unsubscribe = session.onEvent((event) => {
+      if (!predicate(event)) return;
+      clearTimeout(timeout);
+      unsubscribe();
+      resolve(event);
+    });
+  });
+}
+
+async function waitFor(check: () => boolean): Promise<void> {
+  const deadline = Date.now() + 10_000;
+  while (!check()) {
+    if (Date.now() > deadline) throw new Error('Timed out waiting for the session');
+    await new Promise((resolve) => setTimeout(resolve, 10));
+  }
+}
