index 0000000000000000000000000000000000000000..1ace8550c35e947d46e2513c148a2b590b730758
--- /dev/null
+++ b/packages/agent-core-v2/src/session/usage/sessionBilling.ts
@@ -0,0 +1,47 @@
+import type { UsageStatus } from '#/agent/usage/usage';
+import { copyUsage } from '#/agent/usage/usageOps';
+import { addUsage, type TokenUsage } from '#human/llm/usage';
+
+export type UsageByModel = Readonly<Record<string, TokenUsage>>;
+
+export class SessionBilling {
+  private readonly agents = new Map<string, UsageByModel>();
+
+  replace(agentId: string, byModel: UsageByModel | undefined): boolean {
+    const next = copyByModel(byModel ?? {});
+    const previous = this.agents.get(agentId);
+    if (previous !== undefined && JSON.stringify(previous) === JSON.stringify(next)) return false;
+    this.agents.set(agentId, next);
+    return true;
+  }
+
+  snapshot(): UsageStatus {
+    const byModel: Record<string, TokenUsage> = {};
+    for (const usage of this.agents.values()) {
+      for (const [model, tokens] of Object.entries(usage)) {
+        const previous = byModel[model];
+        byModel[model] = previous === undefined ? copyUsage(tokens) : addUsage(previous, tokens);
+      }
+    }
+    let total: TokenUsage | undefined;
+    for (const tokens of Object.values(byModel)) {
+      total = total === undefined ? copyUsage(tokens) : addUsage(total, tokens);
+    }
+    return { byModel: total === undefined ? undefined : byModel, total };
+  }
+}
+
+export function accumulateByModel(
+  byModel: Record<string, TokenUsage>,
+  model: string,
+  usage: TokenUsage,
+): void {
+  const previous = byModel[model];
+  byModel[model] = previous === undefined ? copyUsage(usage) : addUsage(previous, usage);
+}
+
+function copyByModel(byModel: UsageByModel): UsageByModel {
+  return Object.fromEntries(
+    Object.entries(byModel).map(([model, usage]) => [model, copyUsage(usage)]),
+  );
+}
diff --git a/packages/agent-core-v2/src/session/usage/sessionBillingService.ts b/packages/agent-core-v2/src/session/usage/sessionBillingService.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1f2638feb95d14796fbcebdd1315b28305a82b5f
--- /dev/null
+++ b/packages/agent-core-v2/src/session/usage/sessionBillingService.ts
@@ -0,0 +1,167 @@
+import { createDecorator } from '#/_base/di/instantiation';
+import { Service } from '#/_base/di/service';
+import { Emitter, type Event } from '#/_base/event';
+import { ILogService } from '#/_base/log/log';
+import type { UsageStatus } from '#/agent/usage/usage';
+import { UsageRecord } from '#/agent/usage/usageOps';
+import type { TokenUsage } from '#human/llm/usage';
+import { IAppendLogStore } from '#/persistence/interface/appendLogStore';
+import { ISessionContext } from '#/session/sessionContext/sessionContext';
+import { ISessionMetadata } from '#/session/sessionMetadata/sessionMetadata';
+import { AGENT_WIRE_RECORD_KEY, type WireRecord } from '#/wire/record';
+
+import { accumulateByModel, SessionBilling } from './sessionBilling';
+import { ISessionUsageService } from './sessionUsage';
+
+export interface ISessionBillingService {
+  readonly _serviceBrand: undefined;
+
+  readonly ready: Promise<void>;
+  readonly onDidChange: Event<UsageStatus>;
+  snapshot(): UsageStatus;
+}
+
+export const ISessionBillingService = createDecorator<ISessionBillingService>('sessionBillingService');
+
+export class SessionBillingService extends Service implements ISessionBillingService {
+  declare readonly _serviceBrand: undefined;
+
+  private readonly billing = new SessionBilling();
+  private readonly liveAgents = new Set<string>();
+  private readonly knownAgents = new Set<string>();
+  private readonly onDidChangeEmitter = this._register(new Emitter<UsageStatus>());
+  readonly onDidChange: Event<UsageStatus> = this.onDidChangeEmitter.event;
+  private initialRestore: Promise<void> | undefined;
+  private restoreQueue: Promise<void> = Promise.resolve();
+  private restored = false;
+  private incomplete = false;
+  private announced: string | undefined;
+
+  constructor(
+    @ISessionUsageService private readonly usage: ISessionUsageService,
+    @ISessionMetadata private readonly metadata: ISessionMetadata,
+    @IAppendLogStore private readonly log: IAppendLogStore,
+    @ISessionContext private readonly context: ISessionContext,
+    @ILogService private readonly logger: ILogService,
+  ) {
+    super();
+    this._register(
+      this.usage.onDidRecord(({ agent }) => {
+        this.liveAgents.add(agent.agentId);
+        this.knownAgents.add(agent.agentId);
+        this.billing.replace(agent.agentId, this.usage.status(agent).byModel);
+        this.announce();
+      }),
+    );
+    this._register(
+      this.metadata.onDidChangeMetadata(({ changed }) => {
+        if (this.initialRestore === undefined || !changed.includes('agents')) return;
+        this.restoreQueue = this.restoreQueue.then(async () => {
+          await this.restoreRegisteredAgents();
+          this.announce();
+        });
+      }),
+    );
+  }
+
+  get ready(): Promise<void> {
+    if (this.initialRestore === undefined) {
+      this.initialRestore = this.restoreRegisteredAgents().then(() => {
+        this.restored = true;
+        this.announce();
+      });
+      this.restoreQueue = this.initialRestore;
+    }
+    return this.initialRestore;
+  }
+
+  snapshot(): UsageStatus {
+    if (!this.restored) {
+      void this.ready;
+      return {};
+    }
+    return this.incomplete ? {} : this.billing.snapshot();
+  }
+
+  private announce(): void {
+    if (!this.restored || this._store.isDisposed) return;
+    const status = this.snapshot();
+    const key = JSON.stringify(status);
+    if (key === this.announced) return;
+    this.announced = key;
+    this.onDidChangeEmitter.fire(status);
+  }
+
+  private async restoreRegisteredAgents(): Promise<void> {
+    if (this._store.isDisposed) return;
+    try {
+      const metadata = await this.metadata.read();
+      for (const agentId of Object.keys(metadata.agents ?? {})) {
+        if (this.knownAgents.has(agentId)) continue;
+        this.knownAgents.add(agentId);
+        const byModel = await this.readDurableUsage(agentId);
+        if (byModel !== undefined && !this.liveAgents.has(agentId)) {
+          this.billing.replace(agentId, byModel);
+        }
+      }
+    } catch (error) {
+      this.markIncomplete('session metadata could not be read', error);
+    }
+  }
+
+  private async readDurableUsage(agentId: string): Promise<Record<string, TokenUsage> | undefined> {
+    const byModel: Record<string, TokenUsage> = {};
+    const scope = this.context.scope(`agents/${agentId}`);
+    const lease = this.log.acquire(scope, AGENT_WIRE_RECORD_KEY);
+    try {
+      for await (const record of this.log.read<WireRecord>(scope, AGENT_WIRE_RECORD_KEY, {
+        onTruncate: (truncation) => {
+          this.logger.warn('session billing reads the valid prefix of a damaged wire journal', {
+            agentId,
+            lineNumber: truncation.lineNumber,
+            reason: truncation.reason,
+          });
+        },
+      })) {
+        if (record.type !== UsageRecord.type) continue;
+        const owner = record['agentId'];
+        const usage = record['usage'];
+        const model = record['model'];
+        if (owner !== undefined && owner !== agentId) continue;
+        if (typeof model !== 'string' || !isTokenUsage(usage)) {
+          this.markIncomplete(`agent ${agentId} has a malformed usage record`);
+          continue;
+        }
+        accumulateByModel(byModel, model, usage);
+      }
+    } catch (error) {
+      this.markIncomplete(`agent ${agentId} usage could not be read`, error);
+      return undefined;
+    } finally {
+      lease.dispose();
+    }
+    return byModel;
+  }
+
+  private markIncomplete(reason: string, error?: unknown): void {
+    this.logger.warn('session billing is incomplete; hiding the session cost', {
+      reason,
+      error: error instanceof Error ? error.message : error,
+    });
+    if (this.incomplete) return;
+    this.incomplete = true;
+    this.announce();
+  }
+}
+
+function isTokenUsage(value: unknown): value is TokenUsage {
+  if (typeof value !== 'object' || value === null) return false;
+  const usage = value as Record<string, unknown>;
+  return (
+    typeof usage['inputOther'] === 'number' &&
+    typeof usage['output'] === 'number' &&
+    typeof usage['inputCacheRead'] === 'number' &&
+    typeof usage['inputCacheCreation'] === 'number' &&
+    (usage['cost'] === undefined || (typeof usage['cost'] === 'number' && Number.isFinite(usage['cost'])))
+  );
+}
diff --git a/packages/agent-core-v2/test/agent/usage/sessionBilling.test.ts b/packages/agent-core-v2/test/agent/usage/sessionBilling.test.ts
