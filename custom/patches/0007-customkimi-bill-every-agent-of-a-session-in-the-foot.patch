--- /dev/null
+++ b/packages/agent-core-v2/test/agent/usage/sessionBilling.test.ts
@@ -0,0 +1,421 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+import { SyncDescriptor } from '#/_base/di/descriptors';
+import { DisposableStore } from '#/_base/di/lifecycle';
+import { TestInstantiationService } from '#/_base/di/test';
+import { Emitter } from '#/_base/event';
+import { ILogService } from '#/_base/log/log';
+import type { AgentContext } from '#/agent/agentContext/agentContext';
+import { IAgentBlobService } from '#/agent/blob/agentBlobService';
+import { IAgentScopeContext, makeAgentScopeContext } from '#/agent/scopeContext/scopeContext';
+import type { UsageStatus } from '#/agent/usage/usage';
+import { IEventBus, type ISessionEventBus } from '#/app/event/eventBus';
+import { EventBusService } from '#/app/event/eventBusService';
+import { ITelemetryService, noopTelemetryService } from '#/app/telemetry/telemetry';
+import type { TokenUsage } from '#human/llm/usage';
+import { AppendLogStore } from '#/persistence/backends/node-fs/appendLogStore';
+import { InMemoryStorageService } from '#/persistence/backends/memory/inMemoryStorageService';
+import { InMemorySessionLockService } from '#/persistence/backends/memory/sessionLockService';
+import { IAppendLogStore } from '#/persistence/interface/appendLogStore';
+import { ISessionLockService } from '#/persistence/interface/sessionLock';
+import { IFileSystemStorageService } from '#/persistence/interface/storage';
+import { ISessionContext, makeSessionContext } from '#/session/sessionContext/sessionContext';
+import type {
+  ISessionMetadata,
+  SessionMeta,
+  SessionMetadataChangedEvent,
+} from '#/session/sessionMetadata/sessionMetadata';
+import { SessionBilling } from '#/session/usage/sessionBilling';
+import { SessionBillingService } from '#/session/usage/sessionBillingService';
+import { SessionUsageService } from '#/session/usage/sessionUsageService';
+import type { IEventDispatcher } from '#/state/eventDispatcher';
+import { IWireService } from '#/wire/wire';
+import { WireService } from '#/wire/wireService';
+import { AGENT_WIRE_RECORD_KEY, type WireRecord } from '#/wire/record';
+
+import { noopLogger, registerTestEventDispatcher } from '../../wire/stubs';
+
+const SESSION_SCOPE = 'sessions/s1';
+
+const blob: IAgentBlobService = {
+  _serviceBrand: undefined,
+  offloadParts: async (parts) => parts,
+  loadParts: async (parts) => parts,
+  isBlobRef: () => false,
+};
+
+function tokens(cost: number | undefined, inputOther = 100): TokenUsage {
+  const usage: TokenUsage = { inputOther, output: 10, inputCacheRead: 0, inputCacheCreation: 0 };
+  if (cost !== undefined) usage.cost = cost;
+  return usage;
+}
+
+interface Session {
+  readonly storage: InMemoryStorageService;
+  readonly log: IAppendLogStore;
+  readonly locks: ISessionLockService;
+  readonly context: ISessionContext;
+  usage: SessionUsageService;
+  agentIds: string[];
+}
+
+interface LiveAgent {
+  readonly agent: AgentContext;
+  readonly dispatcher: IEventDispatcher;
+  close(): Promise<void>;
+}
+
+const cleanups: Array<() => Promise<void> | void> = [];
+
+afterEach(async () => {
+  for (const cleanup of cleanups.splice(0).toReversed()) await cleanup();
+});
+
+function createSession(): Session {
+  const storage = new InMemoryStorageService();
+  const disposables = new DisposableStore();
+  const ix = disposables.add(new TestInstantiationService());
+  ix.stub(IFileSystemStorageService, storage);
+  ix.set(IAppendLogStore, new SyncDescriptor(AppendLogStore));
+  const log = ix.get(IAppendLogStore);
+  const locks = disposables.add(new InMemorySessionLockService());
+  const context = makeSessionContext({
+    sessionId: 's1',
+    workspaceId: 'w1',
+    sessionDir: '',
+    sessionScope: SESSION_SCOPE,
+    cwd: '',
+  });
+  cleanups.push(() => {
+    disposables.dispose();
+  });
+  return { storage, log, locks, context, usage: new SessionUsageService(), agentIds: [] };
+}
+
+async function startAgent(session: Session, agentId: string): Promise<LiveAgent> {
+  const disposables = new DisposableStore();
+  const ix = disposables.add(new TestInstantiationService());
+  ix.stub(IFileSystemStorageService, session.storage);
+  ix.stub(IAppendLogStore, session.log);
+  ix.stub(ILogService, noopLogger);
+  ix.stub(ITelemetryService, noopTelemetryService);
+  ix.stub(IAgentBlobService, blob);
+  ix.stub(ISessionLockService, session.locks);
+  ix.stub(ISessionContext, session.context);
+  ix.set(IEventBus, new SyncDescriptor(EventBusService));
+  ix.stub(
+    IAgentScopeContext,
+    makeAgentScopeContext({ agentId, agentScope: `${SESSION_SCOPE}/agents/${agentId}` }),
+  );
+  ix.set(IWireService, new SyncDescriptor(WireService));
+  (ix.get(IEventBus) as ISessionEventBus).activateAgent(ix.get(IAgentScopeContext).agentContext);
+  const dispatcher = registerTestEventDispatcher(ix);
+  await ix.get(IWireService).seal();
+  await dispatcher.restore();
+  if (!session.agentIds.includes(agentId)) session.agentIds.push(agentId);
+  let closed = false;
+  const close = async (): Promise<void> => {
+    if (closed) return;
+    closed = true;
+    await dispatcher.flush();
+    await session.log.flush();
+    disposables.dispose();
+  };
+  cleanups.push(close);
+  return { agent: ix.get(IAgentScopeContext).agentContext, dispatcher, close };
+}
+
+interface TestMetadata extends ISessionMetadata {
+  announceAgents(): void;
+}
+
+function metadataOf(session: Session, read?: () => Promise<SessionMeta>): TestMetadata {
+  const changed = new Emitter<SessionMetadataChangedEvent>();
+  cleanups.push(() => {
+    changed.dispose();
+  });
+  return {
+    onDidChangeMetadata: changed.event,
+    announceAgents: () => {
+      changed.fire({ changed: ['agents'] });
+    },
+    read:
+      read ??
+      (async () => ({
+        id: 's1',
+        createdAt: 0,
+        updatedAt: 0,
+        archived: false,
+        agents: Object.fromEntries(
+          session.agentIds.map((id, index) => [
+            id,
+            { parentAgentId: index === 0 ? undefined : session.agentIds[index - 1] },
+          ]),
+        ),
+      })),
+  } as unknown as TestMetadata;
+}
+
+function startBilling(
+  session: Session,
+  options: { log?: IAppendLogStore; metadata?: ISessionMetadata } = {},
+): { billing: SessionBillingService; events: UsageStatus[] } {
+  const billing = new SessionBillingService(
+    session.usage,
+    options.metadata ?? metadataOf(session),
+    options.log ?? session.log,
+    session.context,
+    noopLogger,
+  );
+  const events: UsageStatus[] = [];
+  billing.onDidChange((status) => {
+    events.push(status);
+  });
+  cleanups.push(() => {
+    billing.dispose();
+  });
+  return { billing, events };
+}
+
+describe('SessionBilling', () => {
+  it('replaces cumulative per-agent snapshots instead of adding them again', () => {
+    const billing = new SessionBilling();
+    const main = { a: tokens(1) };
+    expect(billing.replace('main', main)).toBe(true);
+    expect(billing.replace('child', { a: tokens(2) })).toBe(true);
+    expect(billing.replace('child', { a: tokens(2) })).toBe(false);
+    expect(billing.replace('grandchild', { b: tokens(0) })).toBe(true);
+
+    expect(billing.snapshot()).toEqual({
+      byModel: { a: { ...tokens(3, 200), output: 20 }, b: tokens(0) },
+      total: { ...tokens(3, 300), output: 30 },
+    });
+
+    billing.replace('child', { a: tokens(5, 300) });
+    expect(billing.snapshot().total?.cost).toBe(6);
+    main.a.cost = 100;
+    expect(billing.snapshot().total?.cost).toBe(6);
+  });
+
+  it('keeps a model cost unknown when any agent lacks it, without hiding other models', () => {
+    const billing = new SessionBilling();
+    billing.replace('main', { a: tokens(1), b: tokens(2) });
+    billing.replace('child', { a: tokens(undefined) });
+
+    const snapshot = billing.snapshot();
+    expect(snapshot.byModel?.['a']).not.toHaveProperty('cost');
+    expect(snapshot.byModel?.['b']?.cost).toBe(2);
+    expect(snapshot.total).not.toHaveProperty('cost');
+  });
+
+  it('reports no usage before any agent spent anything', () => {
+    expect(new SessionBilling().snapshot()).toEqual({ byModel: undefined, total: undefined });
+  });
+});
+
+describe('SessionBillingService', () => {
+  it('bills main, child and grandchild exactly once, live and again after a restart', async () => {
+    const session = createSession();
+    const { billing, events } = startBilling(session);
+    await billing.ready;
+    const main = await startAgent(session, 'main');
+    const child = await startAgent(session, 'agent-0');
+    const grandchild = await startAgent(session, 'agent-1');
+
+    await session.usage.record(main.agent, 'router/astra', tokens(0.01), { type: 'turn', turnId: 1 });
+    await session.usage.record(main.agent, 'router/astra', tokens(0.01), { type: 'turn', turnId: 1 });
+    await session.usage.record(child.agent, 'router/astra', tokens(0.02), { type: 'turn', turnId: 1 });
+    await session.usage.record(grandchild.agent, 'router/opus', tokens(0.03), { type: 'turn', turnId: 1 });
+
+    expect(billing.snapshot().total?.cost).toBeCloseTo(0.07);
+    expect(billing.snapshot().byModel?.['router/opus']?.cost).toBeCloseTo(0.03);
+    expect(session.usage.status(main.agent).total).toEqual({ ...tokens(0.02, 200), output: 20 });
+    expect(events.at(-1)?.total?.cost).toBeCloseTo(0.07);
+
+    await child.close();
+    await grandchild.close();
+    expect(billing.snapshot().total?.cost).toBeCloseTo(0.07);
+
+    const background = await startAgent(session, 'agent-2');
+    await session.usage.record(background.agent, 'router/astra', tokens(0.04), { type: 'turn', turnId: 1 });
+    expect(events.at(-1)?.total?.cost).toBeCloseTo(0.11);
+    await background.close();
+    await main.close();
+    billing.dispose();
+
+    session.usage = new SessionUsageService();
+    const resumed = startBilling(session);
+    await resumed.billing.ready;
+    expect(resumed.billing.snapshot().total?.cost).toBeCloseTo(0.11);
+    expect(resumed.billing.snapshot().total?.inputOther).toBe(500);
+    expect(resumed.events).toHaveLength(1);
+
+    const mainAgain = await startAgent(session, 'main');
+    await session.usage.record(mainAgain.agent, 'router/astra', tokens(0.05), { type: 'turn', turnId: 2 });
+    const childAgain = await startAgent(session, 'agent-0');
+    await session.usage.record(childAgain.agent, 'router/astra', tokens(0.06), { type: 'turn', turnId: 2 });
+
+    expect(session.usage.status(mainAgain.agent).total?.cost).toBeCloseTo(0.07);
+    expect(resumed.billing.snapshot().total?.cost).toBeCloseTo(0.22);
+    expect(resumed.billing.snapshot().total?.inputOther).toBe(700);
+    expect(resumed.events.at(-1)?.total?.cost).toBeCloseTo(0.22);
+  });
+
+  it('lets a live agent win over its durable records read during the restore', async () => {
+    const session = createSession();
+    const main = await startAgent(session, 'main');
+    await session.usage.record(main.agent, 'm', tokens(1), { type: 'turn', turnId: 1 });
+    await main.dispatcher.flush();
+
+    let release!: () => void;
+    const gate = new Promise<void>((resolve) => {
+      release = resolve;
+    });
+    let durableRead!: () => void;
+    const readDone = new Promise<void>((resolve) => {
+      durableRead = resolve;
+    });
+    const gatedLog: IAppendLogStore = {
+      _serviceBrand: undefined,
+      onDidWrite: session.log.onDidWrite,
+      append: (scope, key, record, options) => {
+        session.log.append(scope, key, record, options);
+      },
+      rewrite: (scope, key, records, options) => session.log.rewrite(scope, key, records, options),
+      flush: () => session.log.flush(),
+      flushLog: (scope, key) => session.log.flushLog(scope, key),
+      close: () => session.log.close(),
+      acquire: (scope, key) => session.log.acquire(scope, key),
+      drainRetirements: () => session.log.drainRetirements(),
+      externallyModified: (scope, key) => session.log.externallyModified(scope, key),
+      bindWriteGuard: (scope, key, guard) => session.log.bindWriteGuard(scope, key, guard),
+      read: async function* <R>(scope: string, key: string) {
+        const records: R[] = [];
+        for await (const record of session.log.read<R>(scope, key)) records.push(record);
+        durableRead();
+        await gate;
+        yield* records;
+      },
+    };
+    const { billing, events } = startBilling(session, { log: gatedLog });
+    const ready = billing.ready;
+    await readDone;
+
+    await session.usage.record(main.agent, 'm', tokens(2), { type: 'turn', turnId: 2 });
+    expect(billing.snapshot()).toEqual({});
+    expect(events).toEqual([]);
+    release();
+    await ready;
+
+    expect(billing.snapshot().total?.cost).toBe(3);
+    expect(events.map((status) => status.total?.cost)).toEqual([3]);
+  });
+
+  it('reads nothing until session billing is asked for', async () => {
+    const session = createSession();
+    const main = await startAgent(session, 'main');
+    await session.usage.record(main.agent, 'm', tokens(1), { type: 'turn', turnId: 1 });
+    await main.close();
+    session.usage = new SessionUsageService();
+    const read = vi.spyOn(session.log, 'read');
+    const { billing, events } = startBilling(session);
+
+    expect(read).not.toHaveBeenCalled();
+    expect(billing.snapshot()).toEqual({});
+    await billing.ready;
+
+    expect(read).toHaveBeenCalledTimes(1);
+    expect(billing.snapshot().total?.cost).toBe(1);
+    expect(events.map((status) => status.total?.cost)).toEqual([1]);
+  });
+
+  it('ignores other agents\' records, reads damaged journals like the engine and hides malformed usage', async () => {
+    const session = createSession();
+    session.agentIds.push('main', 'agent-0');
+    await session.log.rewrite<WireRecord>(`${SESSION_SCOPE}/agents/main`, AGENT_WIRE_RECORD_KEY, [
+      { type: 'metadata', protocol_version: '1.5', created_at: 0 },
+      { type: 'usage.record', agentId: 'main', model: 'm', usage: tokens(1) },
+      { type: 'usage.record', model: 'm', usage: tokens(2) },
+      { type: 'usage.record', agentId: 'agent-9', model: 'm', usage: tokens(100) },
+      { type: 'context.append_message', message: { role: 'user', content: [] } },
+    ]);
+    const healthy = startBilling(session);
+    await healthy.billing.ready;
+    expect(healthy.billing.snapshot().total?.cost).toBe(3);
+
+    const line = (cost: number): string =>
+      JSON.stringify({ type: 'usage.record', agentId: 'agent-0', model: 'm', usage: tokens(cost) });
+    await session.storage.write(
+      `${SESSION_SCOPE}/agents/agent-0`,
+      AGENT_WIRE_RECORD_KEY,
+      new TextEncoder().encode(`${line(4)}\n{broken\n${line(5)}\n`),
+    );
+    const damaged = startBilling(session);
+    await damaged.billing.ready;
+    expect(damaged.billing.snapshot().total?.cost).toBe(7);
+
+    await session.storage.write(
+      `${SESSION_SCOPE}/agents/agent-0`,
+      AGENT_WIRE_RECORD_KEY,
+      new TextEncoder().encode(
+        `${line(4)}\n${JSON.stringify({ type: 'usage.record', agentId: 'agent-0', model: 'm', usage: { inputOther: 'x' } })}\n`,
+      ),
+    );
+    const malformed = startBilling(session);
+    await expect(malformed.billing.ready).resolves.toBeUndefined();
+    expect(malformed.billing.snapshot()).toEqual({});
+    expect(malformed.events).toEqual([{}]);
+  });
+
+  it('reads the durable usage of agents registered after the initial restore', async () => {
+    const session = createSession();
+    const child = await startAgent(session, 'agent-0');
+    await session.usage.record(child.agent, 'm', tokens(2), { type: 'turn', turnId: 1 });
+    await child.close();
+    session.agentIds.length = 0;
+    session.usage = new SessionUsageService();
+    const metadata = metadataOf(session);
+    const { billing, events } = startBilling(session, { metadata });
+    await billing.ready;
+    expect(billing.snapshot()).toEqual({ byModel: undefined, total: undefined });
+
+    session.agentIds.push('agent-0');
+    metadata.announceAgents();
