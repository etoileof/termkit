 /** Whether a thinking effort represents "thinking enabled" (anything but 'off'). */
 export function isThinkingOn(effort: ThinkingEffort): boolean {
@@ -58,3 +65,31 @@ export function thinkingEffortFromConfig(
   if (config?.enabled === false) return 'off';
   return config?.effort;
 }
+
+/**
+ * What a session created from config would start with on `alias`, for the
+ * footer before the session exists. Mirrors the engine: the context limit is
+ * the effective one (overrides and `max_input_size` applied), and a model
+ * that cannot stop reasoning runs at the configured — else its default —
+ * effort even when `[thinking]` is disabled.
+ */
+export function configuredModelDefaults(
+  config: Pick<KimiConfig, 'models' | 'providers' | 'thinking'>,
+  alias: string,
+): { readonly maxContextTokens?: number; readonly thinkingEffort?: ThinkingEffort } {
+  const configured = thinkingEffortFromConfig(config.thinking);
+  const raw = config.models?.[alias];
+  if (raw === undefined) return { thinkingEffort: configured };
+  const model = effectiveModelAlias(raw, config.providers?.[raw.provider]?.type ?? raw.protocol);
+  const alwaysThinking = model.capabilities?.includes('always_thinking') === true;
+  const effort = config.thinking?.effort;
+  return {
+    maxContextTokens: model.maxInputSize ?? model.maxContextSize,
+    thinkingEffort:
+      configured === undefined || (configured === 'off' && alwaysThinking)
+        ? effort !== undefined && effort !== 'off'
+          ? effort
+          : defaultThinkingEffortFor(model)
+        : configured,
+  };
+}
