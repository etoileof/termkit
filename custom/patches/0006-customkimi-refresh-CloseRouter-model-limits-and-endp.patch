+  try {
+    const closeRouter = await refreshCloseRouterModels(host, config, { providerId: targetId });
+    config = closeRouter.config;
+    for (const { providerId, aliases, limits, efforts } of closeRouter.changed) {
+      const what = limits && efforts ? 'limits and efforts' : efforts ? 'efforts' : 'limits';
