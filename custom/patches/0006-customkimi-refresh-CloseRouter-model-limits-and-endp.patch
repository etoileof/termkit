--- /dev/null
+++ b/packages/oauth/src/closerouter.ts
@@ -0,0 +1,761 @@
+import type { ManagedKimiConfigShape } from './managed-kimi-code';
+import { readApiErrorMessage } from './api-error';
+import {
+  apiKeyEnvMissingMessage,
+  declaredProviderCredential,
+  nonEmptyString,
+} from './provider-credential';
+import { isRecord } from './utils';
+
+/**
+ * CloseRouter model metadata refresh.
+ *
+ * Configured aliases whose endpoint is CloseRouter get their limits from
+ * `GET /v1/models` (`context_length`, `max_output_tokens`) and the reasoning
+ * efforts of the endpoint they are actually called through from
+ * `GET /v1/models/{author}/{model}/endpoints`. Only aliases that already exist
+ * are updated; the catalog is never imported.
+ *
+ * Refreshed (top-level) fields: `maxContextSize`, `maxOutputSize`,
+ * `supportEfforts`, `defaultEffort`, `offEffort` (Chat / Responses only) and
+ * the `thinking` / `always_thinking` capability tags. Values under
+ * `[models."<alias>".overrides]` win at runtime and are never touched, so that
+ * is where a deliberate cap or effort list belongs.
+ *
+ * A key missing from a written alias survives the config write (refresh
+ * writes cannot delete a key), so this module only writes definite values.
+ * The one key it can therefore leave stale is `offEffort` when an endpoint
+ * stops listing `none`: the alias becomes `always_thinking`, which never sends
+ * "off", so the stale value is never used.
+ */
+
+const CLOSEROUTER_HOST = 'api.closerouter.dev';
+const CLOSEROUTER_API_BASE = `https://${CLOSEROUTER_HOST}/v1`;
+
+const DEFAULT_REQUEST_TIMEOUT_MS = 10_000;
+const DEFAULT_DEADLINE_MS = 30_000;
+const DEFAULT_CONCURRENCY = 4;
+
+export type CloseRouterEndpointType = 'chat' | 'responses' | 'messages';
+
+const ENDPOINT_TYPE_BY_PROTOCOL: Readonly<Record<string, CloseRouterEndpointType>> = {
+  openai: 'chat',
+  openai_responses: 'responses',
+  anthropic: 'messages',
+};
+
+const ENDPOINT_LABEL: Readonly<Record<CloseRouterEndpointType, string>> = {
+  chat: 'Chat Completions',
+  responses: 'Responses',
+  messages: 'Messages',
+};
+
+/** Keys of a provider's `env` table that the runtime reads for each provider type. */
+const ENV_TABLE_API_KEY: Readonly<Record<string, string>> = {
+  openai: 'OPENAI_API_KEY',
+  openai_responses: 'OPENAI_API_KEY',
+  anthropic: 'ANTHROPIC_API_KEY',
+};
+const ENV_TABLE_BASE_URL: Readonly<Record<string, string>> = {
+  openai: 'OPENAI_BASE_URL',
+  openai_responses: 'OPENAI_BASE_URL',
+  anthropic: 'ANTHROPIC_BASE_URL',
+};
+
+/** Thinking capability tags a refresh owns; every other capability is left alone. */
+const OWNED_CAPABILITIES: ReadonlySet<string> = new Set(['thinking', 'always_thinking']);
+
+const EFFORT_RANK = ['none', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max', 'ultra'];
+const EFFORT_PATTERN = /^[a-z][a-z0-9_-]{0,31}$/;
+const SERVICE_TIER_SUFFIX = /:(?:flex|default|priority)$/;
+/** Entries the engine synthesizes from `KIMI_MODEL_*` variables; they never persist. */
+const ENV_OVERLAY_PREFIX = '__kimi_env';
+
+export interface CloseRouterRefreshHost {
+  getConfig(): Promise<ManagedKimiConfigShape>;
+  setConfig(patch: ManagedKimiConfigShape): Promise<ManagedKimiConfigShape>;
+  readonly userAgent?: string;
+}
+
+export interface CloseRouterRefreshOptions {
+  /** Refresh only the aliases of this provider. */
+  readonly providerId?: string;
+  readonly requestTimeoutMs?: number;
+  /** Upper bound for all CloseRouter requests of one refresh. */
+  readonly deadlineMs?: number;
+  /** Endpoint-detail requests in flight at once. */
+  readonly concurrency?: number;
+}
+
+export interface CloseRouterProviderChange {
+  readonly providerId: string;
+  readonly aliases: number;
+  readonly limits: boolean;
+  readonly efforts: boolean;
+}
+
+export interface CloseRouterRefreshResult {
+  /** The config after the write, or the latest config read when nothing was written. */
+  readonly config: ManagedKimiConfigShape;
+  /** Providers whose aliases changed: how many, and whether limits and/or efforts changed. */
+  readonly changed: ReadonlyArray<CloseRouterProviderChange>;
+  readonly unchanged: readonly string[];
+  readonly failed: ReadonlyArray<{ readonly provider: string; readonly reason: string }>;
+}
+
+interface CloseRouterTarget {
+  readonly alias: string;
+  readonly providerId: string;
+  readonly modelId: string;
+  readonly endpointType: CloseRouterEndpointType;
+}
+
+interface ModelLimits {
+  readonly maxContextSize?: number;
+  readonly maxOutputSize?: number;
+}
+
+type EndpointList = { readonly ok: true; readonly endpoints: readonly Record<string, unknown>[] } | {
+  readonly ok: false;
+  readonly reason: string;
+};
+
+interface GroupMetadata {
+  /** Catalog ids this refresh asked for; aliases added meanwhile wait for the next refresh. */
+  readonly requested: ReadonlySet<string>;
+  readonly limits: ReadonlyMap<string, ModelLimits>;
+  readonly endpoints: ReadonlyMap<string, EndpointList>;
+}
+
+interface AliasMetadata extends ModelLimits {
+  readonly efforts?: readonly string[];
+}
+
+class FailureLog {
+  private readonly entries: Array<{ provider: string; reason: string }> = [];
+  private readonly seen = new Set<string>();
+
+  add(provider: string, reason: string): void {
+    const key = JSON.stringify([provider, reason]);
+    if (this.seen.has(key)) return;
+    this.seen.add(key);
+    this.entries.push({ provider, reason });
+  }
+
+  addFor(targets: readonly CloseRouterTarget[], reason: string): void {
+    for (const target of targets) this.add(target.providerId, reason);
+  }
+
+  list(): ReadonlyArray<{ provider: string; reason: string }> {
+    return this.entries;
+  }
+}
+
+/**
+ * Normalizes a configured base URL to CloseRouter's API base, or returns
+ * undefined when it is not CloseRouter. Both the OpenAI-style form
+ * (`https://api.closerouter.dev/v1`) and the Anthropic-style form
+ * (`https://api.closerouter.dev`) are accepted; anything else (plain HTTP, a
+ * port, credentials, a query, another path or host) is rejected so the API
+ * key is only ever sent to CloseRouter itself.
+ */
+export function closeRouterApiBase(baseUrl: unknown): string | undefined {
+  const value = nonEmptyString(baseUrl);
+  if (value === undefined) return undefined;
+  let url: URL;
+  try {
+    url = new URL(value);
+  } catch {
+    return undefined;
+  }
+  if (url.protocol !== 'https:' || url.hostname !== CLOSEROUTER_HOST) return undefined;
+  if (url.port !== '' || url.username !== '' || url.password !== '') return undefined;
+  if (url.search !== '' || url.hash !== '') return undefined;
+  return /^\/(?:v1\/?)?$/.test(url.pathname) ? CLOSEROUTER_API_BASE : undefined;
+}
+
+export async function refreshCloseRouterModels(
+  host: CloseRouterRefreshHost,
+  config: ManagedKimiConfigShape,
+  options: CloseRouterRefreshOptions = {},
+): Promise<CloseRouterRefreshResult> {
+  const targets = closeRouterTargets(config, options.providerId);
+  if (targets.length === 0) return { config, changed: [], unchanged: [], failed: [] };
+
+  const failures = new FailureLog();
+  const groups = groupByApiKey(config, targets, failures);
+  const fetched = await fetchGroups(groups, host.userAgent, options, failures);
+  if (fetched.size === 0) return { config, changed: [], unchanged: [], failed: failures.list() };
+
+  // Merge into the config as it is now, not as it was before the requests:
+  // aliases edited, added or removed meanwhile are taken as they are, and an
+  // alias whose model, endpoint or key changed is left for the next refresh.
+  let fresh: ManagedKimiConfigShape;
+  try {
+    fresh = await host.getConfig();
+  } catch (error) {
+    failures.addFor(targets, `Could not re-read the config after the CloseRouter requests: ${errorMessage(error)}`);
+    return { config, changed: [], unchanged: [], failed: failures.list() };
+  }
+  const next = structuredClone(fresh);
+  const subagentEffort = secondaryModelEffort(fresh);
+  const changed = new Map<string, CloseRouterProviderChange>();
+  const seen = new Set<string>();
+  for (const target of closeRouterTargets(fresh, options.providerId)) {
+    seen.add(target.providerId);
+    const apiKey = resolveApiKey(fresh, target);
+    const metadata = apiKey.ok ? fetched.get(apiKey.value) : undefined;
+    if (metadata === undefined || !metadata.requested.has(catalogId(target.modelId))) continue;
+    const current = readAlias(fresh, target.alias);
+    const aliasMetadata = metadataForTarget(metadata, target, current, failures);
+    let patched = patchAlias(current, target.endpointType, aliasMetadata);
+    const conflict = subagentEffortConflict(subagentEffort, target.alias, current, patched);
+    if (conflict !== undefined) {
+      failures.add(target.providerId, conflict);
+      patched = patchAlias(current, target.endpointType, { ...aliasMetadata, efforts: undefined });
+    }
+    if (!sameAlias(current, patched)) {
+      next.models![target.alias] = patched;
+      const previous = changed.get(target.providerId);
+      changed.set(target.providerId, {
+        providerId: target.providerId,
+        aliases: (previous?.aliases ?? 0) + 1,
+        limits:
+          previous?.limits === true ||
+          current['maxContextSize'] !== patched['maxContextSize'] ||
+          current['maxOutputSize'] !== patched['maxOutputSize'],
+        efforts:
+          previous?.efforts === true ||
+          JSON.stringify(thinkingFields(current)) !== JSON.stringify(thinkingFields(patched)),
+      });
+    }
+  }
+
+  const failed = failures.list();
+  const unchanged = [...seen].filter(
+    (providerId) =>
+      !changed.has(providerId) && !failed.some((failure) => failure.provider === providerId),
+  );
+  if (changed.size === 0) return { config: fresh, changed: [], unchanged, failed };
+  try {
+    // Only the models section is written; every host leaves sections absent
+    // from the patch untouched, so concurrent provider edits survive.
+    const written = await host.setConfig({ models: next.models } as ManagedKimiConfigShape);
+    return { config: written, changed: [...changed.values()], unchanged, failed };
+  } catch (error) {
+    for (const providerId of changed.keys()) {
+      failures.add(providerId, `Could not save the refreshed CloseRouter metadata: ${errorMessage(error)}`);
+    }
+    return { config: fresh, changed: [], unchanged, failed: failures.list() };
+  }
+}
+
+function closeRouterTargets(
+  config: ManagedKimiConfigShape,
+  providerId: string | undefined,
+): CloseRouterTarget[] {
+  const targets: CloseRouterTarget[] = [];
+  for (const [alias, model] of Object.entries(config.models ?? {})) {
+    if (!isRecord(model) || alias.startsWith(ENV_OVERLAY_PREFIX)) continue;
+    const owner = nonEmptyString(model['provider']);
+    if (owner === undefined || owner.startsWith(ENV_OVERLAY_PREFIX)) continue;
+    if (providerId !== undefined && owner !== providerId) continue;
+    const provider = config.providers[owner];
+    if (!isRecord(provider)) continue;
+    // `model_source = "static"` opts a provider out of every refresh; registry-
+    // and OAuth-managed providers and models belong to their own refreshes.
+    if (provider['modelSource'] === 'static') continue;
+    if (provider['source'] !== undefined || provider['oauth'] !== undefined) continue;
+    if (model['oauth'] !== undefined) continue;
+    const protocol = model['protocol'] ?? provider['type'];
+    const endpointType =
+      typeof protocol === 'string' ? ENDPOINT_TYPE_BY_PROTOCOL[protocol] : undefined;
+    if (endpointType === undefined) continue;
+    // Same precedence as the runtime: a per-model `base_url` beats the provider's.
+    const baseUrl = nonEmptyString(model['baseUrl']) ?? nonEmptyString(provider['baseUrl']);
+    if (closeRouterApiBase(baseUrl) === undefined) continue;
+    const modelId = nonEmptyString(model['name']) ?? nonEmptyString(model['model']);
+    if (modelId === undefined) continue;
+    targets.push({ alias, providerId: owner, modelId, endpointType });
+  }
+  return targets;
+}
+
+function readAlias(config: ManagedKimiConfigShape, alias: string): Record<string, unknown> {
+  const model = config.models?.[alias];
+  return isRecord(model) ? model : {};
+}
+
+type ApiKeyResolution = { readonly ok: true; readonly value: string } | {
+  readonly ok: false;
+  readonly reason: string;
+};
+
+/**
+ * The key the runtime would send for this alias: a key on the model itself,
+ * else the provider's declared key, else its `env` table entry. A provider's
+ * key is used only when the provider itself points at CloseRouter. Without a
+ * base URL it talks to its vendor's default API, and with another one it
+ * belongs to that endpoint, so an alias that only re-routes such a provider to
+ * CloseRouter is not refreshed: a refresh never sends a vendor's key to
+ * CloseRouter, even for an alias the user never selects.
+ */
+function resolveApiKey(config: ManagedKimiConfigShape, target: CloseRouterTarget): ApiKeyResolution {
+  const model = readAlias(config, target.alias);
+  const modelKey = nonEmptyString(model['apiKey']);
+  if (modelKey !== undefined) return { ok: true, value: modelKey };
+  const provider = config.providers[target.providerId];
+  const view = isRecord(provider) ? provider : {};
+  const type = view['type'] ?? model['protocol'];
+  const env = view['env'];
+  const ownBaseUrl =
+    nonEmptyString(view['baseUrl']) ??
+    (isRecord(env) && typeof type === 'string' ? nonEmptyString(env[ENV_TABLE_BASE_URL[type] ?? '']) : undefined);
+  if (closeRouterApiBase(ownBaseUrl) === undefined) {
+    return {
+      ok: false,
+      reason: `${target.alias} re-routes provider "${target.providerId}" (whose own endpoint is elsewhere) to CloseRouter; give it a provider whose base_url is CloseRouter to refresh its limits and efforts.`,
+    };
+  }
+  const declared = declaredProviderCredential(view, target.providerId);
+  switch (declared.kind) {
+    case 'conflict':
+      return { ok: false, reason: declared.message };
+    case 'inline':
+      return { ok: true, value: declared.apiKey };
+    case 'env': {
+      const value = nonEmptyString(process.env[declared.apiKeyEnv]);
+      return value === undefined
+        ? { ok: false, reason: apiKeyEnvMissingMessage(target.providerId, declared.apiKeyEnv) }
+        : { ok: true, value };
+    }
+    case 'none': {
+      const name = typeof type === 'string' ? ENV_TABLE_API_KEY[type] : undefined;
+      const value = isRecord(env) && name !== undefined ? nonEmptyString(env[name]) : undefined;
+      return value === undefined
+        ? {
+            ok: false,
+            reason: `Provider "${target.providerId}" has no API key, so its CloseRouter model limits and efforts were not refreshed.`,
+          }
+        : { ok: true, value };
+    }
+  }
+}
+
+function groupByApiKey(
+  config: ManagedKimiConfigShape,
+  targets: readonly CloseRouterTarget[],
+  failures: FailureLog,
+): Map<string, CloseRouterTarget[]> {
+  const groups = new Map<string, CloseRouterTarget[]>();
+  for (const target of targets) {
+    const apiKey = resolveApiKey(config, target);
+    if (!apiKey.ok) {
+      failures.add(target.providerId, apiKey.reason);
+      continue;
+    }
+    const group = groups.get(apiKey.value);
+    if (group === undefined) groups.set(apiKey.value, [target]);
+    else group.push(target);
+  }
+  return groups;
+}
+
+interface MetadataClient {
+  readonly userAgent: string | undefined;
+  readonly deadline: AbortSignal;
+  readonly requestTimeoutMs: number;
+}
+
+async function fetchGroups(
+  groups: ReadonlyMap<string, readonly CloseRouterTarget[]>,
+  userAgent: string | undefined,
+  options: CloseRouterRefreshOptions,
+  failures: FailureLog,
+): Promise<Map<string, GroupMetadata>> {
+  const client: MetadataClient = {
+    userAgent,
+    deadline: AbortSignal.timeout(options.deadlineMs ?? DEFAULT_DEADLINE_MS),
+    requestTimeoutMs: options.requestTimeoutMs ?? DEFAULT_REQUEST_TIMEOUT_MS,
+  };
+  const out = new Map<string, GroupMetadata>();
+  for (const [apiKey, targets] of groups) {
+    const metadata = await fetchGroup(client, apiKey, targets, options.concurrency, failures);
+    if (metadata !== undefined) out.set(apiKey, metadata);
+  }
+  return out;
+}
+
+async function fetchGroup(
+  client: MetadataClient,
+  apiKey: string,
+  targets: readonly CloseRouterTarget[],
+  concurrency: number | undefined,
+  failures: FailureLog,
+): Promise<GroupMetadata | undefined> {
+  let catalog: unknown;
+  try {
+    catalog = await getJson(client, apiKey, '/models');
+  } catch (error) {
+    failures.addFor(
+      targets,
+      `CloseRouter model catalog request failed (${errorMessage(error)}); keeping the previous limits and efforts.`,
+    );
+    return undefined;
+  }
+  const entries = isRecord(catalog) && Array.isArray(catalog['data']) ? catalog['data'] : undefined;
+  if (entries === undefined) {
+    failures.addFor(
+      targets,
+      'CloseRouter returned a model catalog without a data list; keeping the previous limits and efforts.',
+    );
+    return undefined;
+  }
+
+  const requested = new Set(targets.map((target) => catalogId(target.modelId)));
+  const limits = new Map<string, ModelLimits>();
+  for (const entry of entries) {
+    if (!isRecord(entry) || typeof entry['id'] !== 'string' || !requested.has(entry['id'])) continue;
+    limits.set(entry['id'], {
+      maxContextSize: positiveInteger(entry['context_length']),
+      maxOutputSize: positiveInteger(entry['max_output_tokens']),
+    });
+  }
+
+  const ids = [...requested].filter((id) => limits.has(id));
+  const lists = await mapWithConcurrency(ids, concurrency ?? DEFAULT_CONCURRENCY, (id) =>
+    fetchEndpoints(client, apiKey, id),
+  );
+  const endpoints = new Map<string, EndpointList>();
+  ids.forEach((id, index) => endpoints.set(id, lists[index]!));
+  return { requested, limits, endpoints };
+}
+
+async function fetchEndpoints(
+  client: MetadataClient,
+  apiKey: string,
+  id: string,
+): Promise<EndpointList> {
+  if (!id.includes('/')) {
+    return { ok: false, reason: `"${id}" is not an author/model id` };
+  }
+  const path = `/models/${id.split('/').map(encodeURIComponent).join('/')}/endpoints`;
+  let detail: unknown;
+  try {
+    detail = await getJson(client, apiKey, path);
+  } catch (error) {
+    return { ok: false, reason: errorMessage(error) };
+  }
+  const data = isRecord(detail) ? detail['data'] : undefined;
+  const endpoints = isRecord(data) ? data['endpoints'] : undefined;
+  if (!Array.isArray(endpoints)) {
+    return { ok: false, reason: 'the response has no data.endpoints list' };
+  }
+  return { ok: true, endpoints: endpoints.filter(isRecord) };
+}
+
+function metadataForTarget(
+  metadata: GroupMetadata,
+  target: CloseRouterTarget,
+  current: Record<string, unknown>,
+  failures: FailureLog,
+): AliasMetadata {
+  const id = catalogId(target.modelId);
+  const limits = metadata.limits.get(id);
+  if (limits === undefined) {
+    failures.add(
+      target.providerId,
+      `${target.modelId} is not in the CloseRouter catalog for this API key; keeping its previous limits and efforts.`,
+    );
+    return {};
+  }
+  if (limits.maxContextSize === undefined) {
+    failures.add(
+      target.providerId,
+      `CloseRouter reports no valid context_length for ${target.modelId}; keeping its previous context size.`,
+    );
+  }
+  return { ...limits, efforts: effortsForTarget(metadata, target, current, failures) };
+}
+
+function effortsForTarget(
+  metadata: GroupMetadata,
+  target: CloseRouterTarget,
+  current: Record<string, unknown>,
+  failures: FailureLog,
+): readonly string[] | undefined {
+  const label = `${target.modelId} (${ENDPOINT_LABEL[target.endpointType]})`;
+  const list = metadata.endpoints.get(catalogId(target.modelId));
+  if (list === undefined) return undefined;
+  if (!list.ok) {
+    failures.add(
+      target.providerId,
+      `CloseRouter endpoint metadata for ${target.modelId} failed (${list.reason}); keeping its previous efforts.`,
+    );
+    return undefined;
+  }
+  const matches = list.endpoints.filter((endpoint) => endpoint['type'] === target.endpointType);
+  if (matches.length === 0) {
+    failures.add(
+      target.providerId,
+      `CloseRouter lists no ${ENDPOINT_LABEL[target.endpointType]} endpoint for ${target.modelId}; keeping its previous efforts.`,
+    );
+    return undefined;
+  }
+  if (matches.some((endpoint) => endpoint['supports_streaming'] === false)) {
+    failures.add(
+      target.providerId,
+      `CloseRouter reports that ${label} does not stream, which Kimi requires; keeping its previous efforts.`,
+    );
+    return undefined;
+  }
+  const parsed = matches.map((endpoint) => parseEfforts(endpoint['supported_reasoning_efforts']));
+  const first = parsed[0];
+  if (first === undefined || parsed.some((efforts) => efforts === undefined)) {
+    failures.add(
+      target.providerId,
+      `CloseRouter returned invalid supported_reasoning_efforts for ${label}; keeping its previous efforts.`,
+    );
+    return undefined;
+  }
+  if (parsed.some((efforts) => !sameMembers(efforts!, first))) {
+    failures.add(
+      target.providerId,
+      `CloseRouter lists conflicting reasoning efforts for ${label}; keeping its previous efforts.`,
+    );
+    return undefined;
+  }
+  const levels = first.filter((effort) => effort !== 'none');
+  if (levels.length === 0 && Array.isArray(current['supportEfforts'])) {
+    failures.add(
+      target.providerId,
+      `CloseRouter lists no reasoning effort levels for ${label}; keeping its previous efforts.`,
+    );
+    return undefined;
+  }
+  return first;
+}
+
+/** Missing or null means the endpoint takes no effort; anything else must be a list of effort names. */
+function parseEfforts(value: unknown): readonly string[] | undefined {
+  if (value === undefined || value === null) return [];
+  if (!Array.isArray(value)) return undefined;
+  const efforts: string[] = [];
+  for (const item of value) {
+    if (typeof item !== 'string' || !EFFORT_PATTERN.test(item)) return undefined;
+    if (!efforts.includes(item)) efforts.push(item);
+  }
+  // Effort lists are ordered weakest to strongest everywhere else (default
+  // effort ranking, the picker); normalize when every value is a known level.
+  return efforts.every((effort) => EFFORT_RANK.includes(effort))
+    ? efforts.toSorted((a, b) => EFFORT_RANK.indexOf(a) - EFFORT_RANK.indexOf(b))
+    : efforts;
+}
+
+/**
+ * Applies refreshed metadata to one alias. Chat Completions and Responses can
+ * only stop reasoning through an explicit `none` effort, so without it the
+ * model is declared `always_thinking` and "off" is never offered or sent.
+ * Messages keeps native Anthropic thinking: "off" is sent as a disabled
+ * thinking block, and whether a model can turn reasoning off at all comes from
+ * its model profile at runtime, never from a missing `none` effort.
+ */
+function patchAlias(
+  current: Record<string, unknown>,
+  endpointType: CloseRouterEndpointType,
+  metadata: AliasMetadata,
+): Record<string, unknown> {
+  const next: Record<string, unknown> = { ...current };
+  if (metadata.maxContextSize !== undefined) next['maxContextSize'] = metadata.maxContextSize;
+  if (metadata.maxOutputSize !== undefined) next['maxOutputSize'] = metadata.maxOutputSize;
+  const efforts = metadata.efforts;
+  if (efforts === undefined) return next;
+  const levels = efforts.filter((effort) => effort !== 'none');
+  if (levels.length === 0) return next;
+  next['supportEfforts'] = levels;
+  // An explicit client default, not a claim about the provider's own default.
+  next['defaultEffort'] = levels.includes('high') ? 'high' : levels[Math.floor(levels.length / 2)];
+  const thinking = ['thinking'];
+  if (endpointType !== 'messages') {
+    if (efforts.includes('none')) next['offEffort'] = 'none';
+    else thinking.push('always_thinking');
+  }
+  next['capabilities'] = [
+    ...capabilityList(current['capabilities']).filter(
+      (capability) => !OWNED_CAPABILITIES.has(capability.trim().toLowerCase()),
+    ),
+    ...thinking,
+  ];
+  return next;
+}
+
+/**
+ * `[secondary_model].default_effort` is validated against every pool model
+ * when a session starts, so metadata that does not fit it would stop every
+ * session. Such an alias keeps its previous efforts until the effort is
+ * changed. The patched alias declares its thinking metadata in full, so the
+ * check below matches the engine's validation for it.
+ */
+interface SubagentEffort {
+  readonly effort: string;
+  readonly aliases: ReadonlySet<string>;
+}
+
+function secondaryModelEffort(config: ManagedKimiConfigShape): SubagentEffort | undefined {
+  const section = config['secondaryModel'];
+  if (!isRecord(section)) return undefined;
+  const effort = nonEmptyString(section['defaultEffort'])?.toLowerCase();
+  if (effort === undefined) return undefined;
+  const models = section['models'];
+  const fallback = nonEmptyString(section['defaultModel']) ?? nonEmptyString(section['model']);
+  const aliases = isRecord(models) ? Object.keys(models) : fallback === undefined ? [] : [fallback];
+  return { effort, aliases: new Set(aliases) };
+}
+
+function subagentEffortConflict(
+  subagent: SubagentEffort | undefined,
+  alias: string,
+  current: Record<string, unknown>,
+  patched: Record<string, unknown>,
+): string | undefined {
+  if (subagent === undefined || !subagent.aliases.has(alias)) return undefined;
+  if (JSON.stringify(thinkingFields(current)) === JSON.stringify(thinkingFields(patched))) {
+    return undefined;
+  }
+  const problem = subagentEffortProblem(subagent.effort, patched);
+  if (problem === undefined) return undefined;
+  return `[secondary_model] default_effort "${subagent.effort}" would no longer work with ${alias}: ${problem}. Change default_effort to apply CloseRouter's efforts; keeping its previous efforts.`;
+}
+
+function subagentEffortProblem(effort: string, alias: Record<string, unknown>): string | undefined {
+  const overrides = isRecord(alias['overrides']) ? alias['overrides'] : {};
+  const capabilities = new Set(
+    capabilityList(overrides['capabilities'] ?? alias['capabilities']).map((capability) =>
+      capability.trim().toLowerCase(),
+    ),
+  );
+  const alwaysThinking = capabilities.has('always_thinking');
+  const supportsThinking =
+    alwaysThinking ||
+    capabilities.has('thinking') ||
+    (overrides['adaptiveThinking'] ?? alias['adaptiveThinking']) === true;
+  const efforts = capabilityList(overrides['supportEfforts'] ?? alias['supportEfforts'])
+    .map((value) => value.trim())
+    .filter((value) => value.length > 0);
+  if (effort === 'off') return alwaysThinking ? 'it always reasons' : undefined;
+  if (!supportsThinking) return 'it does not support thinking';
+  if (efforts.length === 0 || effort === 'on' || efforts.includes(effort)) return undefined;
+  return `it supports ${efforts.join(', ')}`;
+}
+
+function thinkingFields(alias: Record<string, unknown>): unknown[] {
+  return [
+    capabilityList(alias['capabilities'])
+      .map((capability) => capability.trim().toLowerCase())
+      .filter((capability) => OWNED_CAPABILITIES.has(capability))
+      .toSorted(),
+    alias['supportEfforts'],
+    alias['defaultEffort'],
+    alias['offEffort'],
+  ];
+}
+
+function capabilityList(value: unknown): string[] {
+  return Array.isArray(value) ? value.filter((item): item is string => typeof item === 'string') : [];
+}
+
+function sameAlias(a: Record<string, unknown>, b: Record<string, unknown>): boolean {
+  return JSON.stringify(canonicalAlias(a)) === JSON.stringify(canonicalAlias(b));
+}
+
+function canonicalAlias(alias: Record<string, unknown>): Record<string, unknown> {
+  const out: Record<string, unknown> = {};
+  for (const key of Object.keys(alias).toSorted()) {
+    const value = alias[key];
+    out[key] =
+      key === 'capabilities' && Array.isArray(value)
+        ? capabilityList(value).map((item) => item.trim().toLowerCase()).toSorted()
+        : value;
+  }
+  return out;
+}
+
+function sameMembers(a: readonly string[], b: readonly string[]): boolean {
+  return a.length === b.length && a.every((item) => b.includes(item));
+}
+
+function catalogId(modelId: string): string {
+  return modelId.replace(SERVICE_TIER_SUFFIX, '');
+}
+
+function positiveInteger(value: unknown): number | undefined {
+  return typeof value === 'number' && Number.isSafeInteger(value) && value > 0 ? value : undefined;
+}
+
+async function getJson(client: MetadataClient, apiKey: string, path: string): Promise<unknown> {
+  // Messages end up in the TUI and in server logs; none may carry the key.
+  if (/[\u0000-\u001F\u007F]/.test(apiKey)) {
+    throw new Error('the API key contains control characters (such as a line break)');
+  }
+  const headers: Record<string, string> = {
+    Accept: 'application/json',
+    Authorization: `Bearer ${apiKey}`,
+  };
+  if (client.userAgent !== undefined) headers['User-Agent'] = client.userAgent;
+  let response: Response;
+  try {
+    response = await fetch(`${CLOSEROUTER_API_BASE}${path}`, {
+      headers,
+      // A redirect would forward the API key to wherever it points.
+      redirect: 'error',
+      signal: AbortSignal.any([client.deadline, AbortSignal.timeout(client.requestTimeoutMs)]),
+    });
+  } catch (error) {
+    // oxlint-disable-next-line preserve-caught-error -- the cause can carry the API key; its text is kept, redacted
+    throw new Error(withoutKey(errorMessage(error), apiKey));
+  }
+  if (!response.ok) {
+    throw new Error(withoutKey(await readApiErrorMessage(response, `HTTP ${response.status}`), apiKey));
+  }
+  let text: string;
+  try {
+    text = await response.text();
+  } catch (error) {
+    // oxlint-disable-next-line preserve-caught-error -- the cause can carry the API key; its text is kept, redacted
+    throw new Error(withoutKey(errorMessage(error), apiKey));
+  }
+  try {
+    return JSON.parse(text) as unknown;
+  } catch {
+    throw new Error('the response is not valid JSON');
+  }
+}
+
+function withoutKey(message: string, apiKey: string): string {
+  return message.split(apiKey).join('[redacted]');
+}
+
+async function mapWithConcurrency<T, R>(
+  items: readonly T[],
+  limit: number,
+  run: (item: T) => Promise<R>,
+): Promise<R[]> {
+  const results: R[] = [];
+  let next = 0;
+  const worker = async (): Promise<void> => {
+    while (next < items.length) {
+      const index = next++;
+      results[index] = await run(items[index]!);
+    }
+  };
+  await Promise.all(Array.from({ length: Math.min(Math.max(1, limit), items.length) }, worker));
+  return results;
+}
+
+function errorMessage(error: unknown): string {
+  if (!(error instanceof Error)) return String(error);
+  if (error.name === 'TimeoutError' || error.name === 'AbortError') return 'timed out';
+  // fetch reports DNS, TLS and refused redirects as "fetch failed" with the reason in `cause`.
+  const cause = error.cause instanceof Error ? error.cause.message : undefined;
+  return cause === undefined || cause === error.message ? error.message : `${error.message}: ${cause}`;
+}
