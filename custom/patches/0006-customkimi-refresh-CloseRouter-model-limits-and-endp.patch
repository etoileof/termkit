+
+function memoryHost(initial: ManagedKimiConfigShape): MemoryHost {
+  let config = structuredClone(initial);
+  const writes: ManagedKimiConfigShape[] = [];
+  return {
+    writes,
+    current: () => config,
+    edit: (change) => {
+      change(config);
+    },
+    getConfig: async () => structuredClone(config),
+    setConfig: async (patch) => {
+      writes.push(structuredClone(patch));
+      const { models, ...rest } = structuredClone(patch);
+      config = { ...config, ...rest };
+      if (models !== undefined) {
+        // Like the real config writer: written aliases replace the section,
+        // but a key missing from a written alias keeps its stored value.
+        config.models = Object.fromEntries(
+          Object.entries(models).map(([alias, model]) => [
