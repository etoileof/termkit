+  /**
+   * A refresh can change the active model's limits or efforts (CloseRouter
+   * metadata). Re-read what the engine now resolves so the context meter and
+   * the thinking label follow at once instead of at the next status event.
+   */
+  private async applyRefreshedModelLimits(): Promise<void> {
+    const session = this.session;
+    if (session !== undefined) {
+      const status = await session.getStatus();
+      if (this.session !== session) return;
+      const { contextTokens } = this.state.appState;
+      this.setAppState({
+        maxContextTokens: status.maxContextTokens,
+        contextUsage: status.maxContextTokens > 0 ? contextTokens / status.maxContextTokens : 0,
+        thinkingEffort: status.thinkingEffort,
+      });
+      return;
+    }
+    const alias = this.state.appState.model;
+    if (alias.length === 0) return;
+    const defaults = configuredModelDefaults(await this.harness.getConfig(), alias);
+    if (this.session !== undefined || this.state.appState.model !== alias) return;
+    const patch: Partial<AppState> = {};
+    if (defaults.maxContextTokens !== undefined) patch.maxContextTokens = defaults.maxContextTokens;
+    if (defaults.thinkingEffort !== undefined && this.state.appState.lazySessionThinking === undefined) {
+      patch.thinkingEffort = defaults.thinkingEffort;
+    }
+    this.setAppState(patch);
+  }
