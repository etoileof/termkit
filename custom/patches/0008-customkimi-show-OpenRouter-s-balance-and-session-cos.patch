+describe('OpenRouterBilling', () => {
+  const API = 'https://openrouter.ai/api/v1';
+  const env = { OPENROUTER_API_KEY: 'sk-or-test' };
+  const managed = { ...env, OPENROUTER_MANAGEMENT_KEY: 'mgmt-env' };
+  const noStoredKey = async (): Promise<string | undefined> => undefined;
+  const credits = { data: { total_credits: 25, total_usage: 7.5 } };
+  const key = { data: { label: 'sk-or-v1-abc', usage: 3, limit_remaining: 4.25 } };
+
+  interface Reply {
+    readonly body: unknown;
+    readonly status: number;
+  }
+
+  function openRouterFetch(routes: Readonly<Record<string, Reply | Error>>) {
+    return routedFetch((url) => {
+      const route = routes[url] ?? { body: {}, status: 404 };
+      if (route instanceof Error) throw route;
+      return new Response(JSON.stringify(route.body), { status: route.status });
+    });
+  }
+
+  function json(body: unknown, status = 200): Reply {
+    return { body, status };
+  }
+
+  afterEach(() => {
+    vi.resetAllMocks();
+    vi.restoreAllMocks();
+  });
+
+  it('reads the balance from /credits with the management key from the environment', async () => {
+    const { fetcher, calls } = openRouterFetch({ [`${API}/credits`]: json(credits) });
+    const readManagementKey = vi.fn(async () => 'mgmt-keychain');
+    const padded = { ...env, OPENROUTER_MANAGEMENT_KEY: ' mgmt-env ' };
+    const billing = new OpenRouterBilling(padded, fetcher, { readManagementKey });
+    await expect(billing.fetchBalanceUsd()).resolves.toBe(17.5);
+    expect(calls).toEqual([{ url: `${API}/credits`, authorization: 'Bearer mgmt-env' }]);
+    expect(readManagementKey).not.toHaveBeenCalled();
+  });
+
+  it('reads the management key from the Keychain when the environment has none, once for good', async () => {
+    const { fetcher, calls } = openRouterFetch({ [`${API}/credits`]: json(credits) });
+    const readManagementKey = vi.fn(async () => 'mgmt-keychain');
+    let now = 1_000_000;
+    const billing = new OpenRouterBilling({ ...env, OPENROUTER_MANAGEMENT_KEY: '  ' }, fetcher, {
+      readManagementKey,
+      now: () => now,
+    });
+    expect(readManagementKey).not.toHaveBeenCalled();
+    await expect(billing.fetchBalanceUsd()).resolves.toBe(17.5);
+    now += 11 * 60_000;
+    await expect(billing.fetchBalanceUsd()).resolves.toBe(17.5);
+    expect(readManagementKey).toHaveBeenCalledTimes(1);
+    expect(calls).toEqual([
+      { url: `${API}/credits`, authorization: 'Bearer mgmt-keychain' },
+      { url: `${API}/credits`, authorization: 'Bearer mgmt-keychain' },
+    ]);
+  });
+
+  it('remembers a missing management key for ten minutes and uses /key meanwhile', async () => {
+    const { fetcher, calls } = openRouterFetch({ [`${API}/key`]: json(key) });
+    const readManagementKey = vi.fn(noStoredKey);
+    let now = 1_000_000;
+    const billing = new OpenRouterBilling(env, fetcher, { readManagementKey, now: () => now });
+    await expect(billing.fetchBalanceUsd()).resolves.toBe(4.25);
+    now += 60_000;
+    await expect(billing.fetchBalanceUsd()).resolves.toBe(4.25);
+    expect(readManagementKey).toHaveBeenCalledTimes(1);
+    now += 9 * 60_000;
+    await expect(billing.fetchBalanceUsd()).resolves.toBe(4.25);
+    expect(readManagementKey).toHaveBeenCalledTimes(2);
+    expect(calls).toHaveLength(3);
+    for (const call of calls) {
+      expect(call).toEqual({ url: `${API}/key`, authorization: 'Bearer sk-or-test' });
+    }
+  });
+
+  it.each([
+    ['an HTTP error', json({ error: { message: 'Forbidden' } }, 403)],
+    ['a failed request', new Error('offline')],
+    ['a body without usage', json({ data: { total_credits: 25 } })],
+    ['a non-numeric balance', json({ data: { total_credits: 'lots', total_usage: 1 } })],
+  ])('falls back to the key limit when /credits returns %s', async (_name, creditsReply) => {
+    const { fetcher, calls } = openRouterFetch({
+      [`${API}/credits`]: creditsReply,
+      [`${API}/key`]: json(key),
+    });
+    await expect(new OpenRouterBilling(managed, fetcher).fetchBalanceUsd()).resolves.toBe(4.25);
+    expect(calls).toEqual([
+      { url: `${API}/credits`, authorization: 'Bearer mgmt-env' },
+      { url: `${API}/key`, authorization: 'Bearer sk-or-test' },
+    ]);
+  });
+
+  it('reports a genuine zero balance', async () => {
+    const spent = json({ data: { total_credits: 5, total_usage: 5 } });
+    const { fetcher } = openRouterFetch({ [`${API}/credits`]: spent });
+    await expect(new OpenRouterBilling(managed, fetcher).fetchBalanceUsd()).resolves.toBe(0);
+  });
+
+  it('reports no balance for a key without a credit limit or when /key fails', async () => {
+    const options = { readManagementKey: noStoredKey };
+    const noLimit = json({ data: { usage: 3, limit_remaining: null } });
+    const unlimited = openRouterFetch({ [`${API}/key`]: noLimit });
+    await expect(
+      new OpenRouterBilling(env, unlimited.fetcher, options).fetchBalanceUsd(),
+    ).resolves.toBeUndefined();
+    const failing = openRouterFetch({ [`${API}/key`]: json({}, 500) });
+    await expect(
+      new OpenRouterBilling(env, failing.fetcher, options).fetchBalanceUsd(),
+    ).resolves.toBeUndefined();
+  });
+
+  it('is not configured and reads nothing without an API key', async () => {
+    const { fetcher, calls } = openRouterFetch({ [`${API}/credits`]: json(credits) });
+    const readManagementKey = vi.fn(async () => 'mgmt-keychain');
+    const billing = new OpenRouterBilling({ OPENROUTER_MANAGEMENT_KEY: 'mgmt-env' }, fetcher, {
+      readManagementKey,
+    });
+    expect(billing.configured).toBe(false);
+    expect(new OpenRouterBilling(env).configured).toBe(true);
+    await expect(billing.fetchBalanceUsd()).resolves.toBeUndefined();
+    await expect(billing.fetchPrices()).resolves.toEqual(new Map());
+    expect(calls).toHaveLength(0);
+    expect(readManagementKey).not.toHaveBeenCalled();
+  });
+
+  it('sends the management key only to /credits and the API key everywhere else', async () => {
+    const { fetcher, calls } = openRouterFetch({
+      [`${API}/credits`]: json({}, 500),
+      [`${API}/key`]: json(key),
+      [`${API}/models`]: json({ data: [] }),
+    });
+    const readManagementKey = async (): Promise<string> => 'mgmt-keychain';
+    const billing = new OpenRouterBilling(env, fetcher, { readManagementKey });
+    await billing.fetchBalanceUsd();
+    await billing.fetchPrices();
+    expect(calls).toEqual([
+      { url: `${API}/credits`, authorization: 'Bearer mgmt-keychain' },
+      { url: `${API}/key`, authorization: 'Bearer sk-or-test' },
+      { url: `${API}/models`, authorization: 'Bearer sk-or-test' },
+    ]);
+  });
+
+  it('turns the per-token catalog pricing into per-million prices', async () => {
+    const { fetcher, calls } = openRouterFetch({
+      [`${API}/models`]: json({
+        data: [
+          {
+            id: 'meta/muse-wonder',
+            context_length: 1048576,
+            pricing: { prompt: '0.000004', completion: '0.00002' },
+            reasoning: { mandatory: true, supported_efforts: ['high'], default_effort: 'medium' },
+          },
+          {
+            id: 'vendor/cached',
+            pricing: {
+              prompt: '0.0000025',
+              completion: '0.00001',
+              input_cache_read: '0.0000003',
+              input_cache_write: '0.00000375',
+            },
+          },
+          {
+            id: 'vendor/odd-cache',
+            pricing: {
+              prompt: '0.000001',
+              completion: '0.000002',
+              input_cache_read: '-1',
+              input_cache_write: 'n/a',
+            },
+          },
+          { id: 'vendor/free', pricing: { prompt: '0', completion: '0' } },
+          { id: 'openrouter/auto', pricing: { prompt: '-1', completion: '-1' } },
+          { id: 'vendor/bad-output', pricing: { prompt: '0.000001', completion: 'abc' } },
+          { id: 'vendor/no-output', pricing: { prompt: '0.000001' } },
+          { id: 'vendor/unpriced' },
+          { pricing: { prompt: '0.000001', completion: '0.000001' } },
+        ],
+      }),
+    });
+    const prices = await new OpenRouterBilling(env, fetcher).fetchPrices();
+    expect(calls).toEqual([{ url: `${API}/models`, authorization: 'Bearer sk-or-test' }]);
+    expect([...prices]).toEqual([
+      ['meta/muse-wonder', { input: 4, output: 20, cacheRead: 4, cacheWrite: 4 }],
+      ['vendor/cached', { input: 2.5, output: 10, cacheRead: 0.3, cacheWrite: 3.75 }],
+      ['vendor/odd-cache', { input: 1, output: 2, cacheRead: 1, cacheWrite: 1 }],
+      ['vendor/free', { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 }],
+    ]);
+  });
+
+  it('returns no prices when the catalog cannot be read', async () => {
+    const { fetcher } = openRouterFetch({ [`${API}/models`]: json({ error: 'down' }, 503) });
+    await expect(new OpenRouterBilling(env, fetcher).fetchPrices()).resolves.toEqual(new Map());
+  });
+
+  it('bills only models served from openrouter.ai', () => {
+    const billing = new OpenRouterBilling(env);
+    expect(billing.bills('https://openrouter.ai/api/v1')).toBe(true);
+    expect(billing.bills('https://openrouter.ai/api/v1/')).toBe(true);
+    expect(billing.bills('https://api.closerouter.dev/v1')).toBe(false);
+    expect(billing.bills('https://7api.st/v1')).toBe(false);
+    expect(billing.bills('https://openrouter.ai.example.test/api/v1')).toBe(false);
+    expect(billing.bills(undefined)).toBe(false);
+  });
+});
+
+describe('readKeychainManagementKey', () => {
+  type ExecFileCallback = (error: Error | null, stdout: string, stderr: string) => void;
+
+  afterEach(() => {
+    vi.resetAllMocks();
+    vi.restoreAllMocks();
+  });
+
+  function replyWith(error: Error | null, stdout: string): void {
+    vi.mocked(execFile).mockImplementation(((...args: unknown[]) => {
+      (args[3] as ExecFileCallback)(error, stdout, '');
+      return undefined as never;
+    }) as never);
+  }
+
+  it('reads the login Keychain through the absolute security path with a timeout', async () => {
+    vi.spyOn(process, 'platform', 'get').mockReturnValue('darwin');
+    replyWith(null, '  mgmt-keychain\n');
+    await expect(readKeychainManagementKey()).resolves.toBe('mgmt-keychain');
+    expect(execFile).toHaveBeenCalledWith(
+      '/usr/bin/security',
+      ['find-generic-password', '-a', userInfo().username, '-s', 'OPENROUTER_MANAGEMENT_KEY', '-w'],
+      { timeout: 3000 },
+      expect.any(Function),
+    );
+  });
+
+  it('resolves undefined when the item is missing or empty', async () => {
+    vi.spyOn(process, 'platform', 'get').mockReturnValue('darwin');
+    replyWith(new Error('The specified item could not be found in the keychain.'), '');
+    await expect(readKeychainManagementKey()).resolves.toBeUndefined();
+    replyWith(null, '\n');
+    await expect(readKeychainManagementKey()).resolves.toBeUndefined();
+  });
+
+  it('never spawns anything outside macOS', async () => {
+    vi.spyOn(process, 'platform', 'get').mockReturnValue('linux');
+    await expect(readKeychainManagementKey()).resolves.toBeUndefined();
+    expect(execFile).not.toHaveBeenCalled();
+  });
+});
