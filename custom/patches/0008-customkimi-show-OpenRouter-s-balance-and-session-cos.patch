diff --git a/apps/kimi-code/src/utils/billing/openrouter.ts b/apps/kimi-code/src/utils/billing/openrouter.ts
new file mode 100644
index 0000000000000000000000000000000000000000..cec76bcbe8d4bf4a094c286f67574771790208a5
--- /dev/null
+++ b/apps/kimi-code/src/utils/billing/openrouter.ts
@@ -0,0 +1,137 @@
+import { execFile } from 'node:child_process';
+import { userInfo } from 'node:os';
+
+import {
+  asRecord,
+  BillingProvider,
+  toFiniteNumber,
+  type BillingEnv,
+  type Fetcher,
+  type TokenPrices,
+} from './billing-provider';
+
+const API_BASE = 'https://openrouter.ai/api/v1';
+const MANAGEMENT_KEY_NAME = 'OPENROUTER_MANAGEMENT_KEY';
+const SECURITY_PATH = '/usr/bin/security';
+const KEYCHAIN_TIMEOUT_MS = 3_000;
+const MANAGEMENT_KEY_MISS_TTL_MS = 10 * 60_000;
+
+/** Looks up the stored management key; resolves undefined when there is none and never rejects. */
+export type ManagementKeyReader = () => Promise<string | undefined>;
+
+export interface OpenRouterBillingOptions {
+  readonly readManagementKey?: ManagementKeyReader;
+  readonly now?: () => number;
+}
+
+/**
+ * OpenRouter replies carry `usage.cost`, so its price list only covers replies without one.
+ *
+ * The account balance needs a management key, which can create and delete API keys. It is
+ * therefore deliberately kept out of Kimi's environment (and so out of the agent's shell):
+ * on macOS it is read from the login Keychain when the balance is polled, held only by this
+ * provider and sent only to /credits. OPENROUTER_MANAGEMENT_KEY in the environment wins, for
+ * systems without a Keychain. Without a management key the balance is the API key's
+ * remaining credit limit.
+ *
+ * The Keychain only keeps the key out of inherited environments. Any process running as the
+ * same user, the agent's shell included, can read the item with the same `security` command,
+ * so do not store a management key where the agent may run untrusted prompts.
+ */
+export class OpenRouterBilling extends BillingProvider {
+  readonly label = 'OpenRouter';
+  protected readonly host = 'openrouter.ai';
+  protected readonly apiKeyEnv = 'OPENROUTER_API_KEY';
+
+  private readonly readManagementKey: ManagementKeyReader;
+  private readonly now: () => number;
+  private storedManagementKey: string | undefined;
+  private managementKeyMissAt: number | undefined;
+
+  constructor(env?: BillingEnv, fetcher?: Fetcher, options: OpenRouterBillingOptions = {}) {
+    super(env, fetcher);
+    this.readManagementKey = options.readManagementKey ?? readKeychainManagementKey;
+    this.now = options.now ?? Date.now;
+  }
+
+  async fetchBalanceUsd(): Promise<number | undefined> {
+    if (!this.configured) return undefined;
+    const managementKey = await this.managementKey();
+    if (managementKey !== undefined) {
+      const body = await this.getJson(`${API_BASE}/credits`, managementKey);
+      const credits = asRecord(asRecord(body)?.['data']);
+      const total = toFiniteNumber(credits?.['total_credits']);
+      const usage = toFiniteNumber(credits?.['total_usage']);
+      if (total !== undefined && usage !== undefined) return total - usage;
+    }
+    // A key without a credit limit reports null: the balance is then unknown, not $0.
+    const key = asRecord(asRecord(await this.getJson(`${API_BASE}/key`))?.['data']);
+    return toFiniteNumber(key?.['limit_remaining']);
+  }
+
+  override async fetchPrices(): Promise<ReadonlyMap<string, TokenPrices>> {
+    const models = asRecord(await this.getJson(`${API_BASE}/models`))?.['data'];
+    const prices = new Map<string, TokenPrices>();
+    for (const model of Array.isArray(models) ? models : []) {
+      const entry = asRecord(model);
+      const pricing = asRecord(entry?.['pricing']);
+      const id = entry?.['id'];
+      const input = perMillion(pricing?.['prompt']);
+      const output = perMillion(pricing?.['completion']);
+      if (typeof id !== 'string' || input === undefined || output === undefined) continue;
+      prices.set(id, {
+        input,
+        output,
+        cacheRead: perMillion(pricing?.['input_cache_read']) ?? input,
+        cacheWrite: perMillion(pricing?.['input_cache_write']) ?? input,
+      });
+    }
+    return prices;
+  }
+
+  /**
+   * The environment's management key, else the stored one. A stored key is kept for the
+   * provider's lifetime; a miss is remembered for ten minutes, so the balance poll does not
+   * start a process every minute.
+   */
+  private async managementKey(): Promise<string | undefined> {
+    const fromEnv = this.envValue(MANAGEMENT_KEY_NAME);
+    if (fromEnv !== undefined) return fromEnv;
+    if (this.storedManagementKey !== undefined) return this.storedManagementKey;
+    const missAt = this.managementKeyMissAt;
+    if (missAt !== undefined && this.now() - missAt < MANAGEMENT_KEY_MISS_TTL_MS) return undefined;
+    this.storedManagementKey = await this.readManagementKey();
+    this.managementKeyMissAt = this.storedManagementKey === undefined ? this.now() : undefined;
+    return this.storedManagementKey;
+  }
+}
+
+/** USD per million tokens from a per-token price; "-1" (variable) or invalid is unknown. */
+function perMillion(value: unknown): number | undefined {
+  const perToken = toFiniteNumber(value);
+  return perToken !== undefined && perToken >= 0 ? perToken * 1_000_000 : undefined;
+}
+
+/**
+ * The management key from the macOS login Keychain (generic password, service
+ * OPENROUTER_MANAGEMENT_KEY, account = the current user). `security` is called by its
+ * absolute path, so nothing is resolved from PATH or the workspace.
+ */
+export function readKeychainManagementKey(): Promise<string | undefined> {
+  if (process.platform !== 'darwin') return Promise.resolve(undefined);
+  return new Promise((resolve) => {
+    try {
+      execFile(
+        SECURITY_PATH,
+        ['find-generic-password', '-a', userInfo().username, '-s', MANAGEMENT_KEY_NAME, '-w'],
+        { timeout: KEYCHAIN_TIMEOUT_MS },
+        (error, stdout) => {
+          const key = error === null ? stdout.trim() : '';
+          resolve(key === '' ? undefined : key);
+        },
+      );
+    } catch {
+      resolve(undefined);
+    }
+  });
+}
