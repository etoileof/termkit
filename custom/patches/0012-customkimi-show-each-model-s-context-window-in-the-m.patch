 }
 
+/**
+ * Format a context window, or a token count shown against one, the way
+ * providers advertise sizes: decimal units when they come out exact
+ * (1000000 → "1M", 200000 → "200k", 1050000 → "1.05M"), else binary units
+ * when those do (262144 → "256k", 1048576 → "1M"), else rounded decimal
+ * units ("944k", "12.3k").
+ */
+export function formatContextSize(n: number): string {
+  if (!Number.isFinite(n) || n < 0) return '0';
+  if (n < 1000) return String(Math.round(n));
+  return exactSize(n, 1000) ?? exactSize(n, 1024) ?? roundedSize(n);
+}
+
+function exactSize(n: number, base: number): string | undefined {
+  const mega = base * base;
+  if (n >= mega) return (n * 100) % mega === 0 ? `${trimDecimals(n / mega, 2)}M` : undefined;
+  if (n % base !== 0 || n / base >= 1000) return undefined;
+  return `${String(n / base)}k`;
+}
+
+function roundedSize(n: number): string {
+  if (n >= 999_500) return `${trimDecimals(n / 1_000_000, 2)}M`;
+  const k = n / 1000;
+  return `${k >= 100 ? String(Math.round(k)) : trimDecimals(k, 1)}k`;
+}
+
+/** Up to `digits` decimals with trailing zeros dropped ("1.50" → "1.5", "1.00" → "1"). */
+function trimDecimals(v: number, digits: number): string {
+  return v.toFixed(digits).replace(/\.?0+$/, '');
+}
+
 /** One decimal place, dropping a redundant ".0" ("1.0" → "1", "1.5" stays). */
 function trimDecimal(v: number): string {
   const s = v.toFixed(1);
