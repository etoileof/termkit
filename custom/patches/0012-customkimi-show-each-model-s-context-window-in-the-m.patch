diff --git a/apps/kimi-code/src/utils/usage/usage-format.ts b/apps/kimi-code/src/utils/usage/usage-format.ts
index 1d332b302b0ebfa05836710de2aa091f1b559903..1eac8b523e2595977ab22fc7b3de4029fc482a9d 100644
--- a/apps/kimi-code/src/utils/usage/usage-format.ts
